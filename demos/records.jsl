--!strict
-- What each demo drew when it was recorded: its geometry and the CRC-32 of its RGBA bytes. A demo
-- is deterministic, so a change here is a change to what the engine draws: review the render
-- before taking a new record, and never take one to make a check pass.
local Records: { [string]: string } = {
  ['lighthouse'] = '900x1200:a3d7845e',
  ['rosette'] = '1000x1000:4d1413ef',
  ['valley'] = '960x540:5f71731b',
  ['heron'] = '800x1000:7b868098',
  ['oil'] = '960x540:bdf08d8b',
  ['portrait'] = '540x675:a0c7bfe1',
  ['valley-painted'] = '960x540:83b83d01',
  ['monalisa'] = '1000x1490:b93b6b93',
}

return table.freeze(Records)
