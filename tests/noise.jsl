--!strict
-- `@magick/noise` and procedural paints (MAG-028, MAG-029): pure seeded functions, repeatable and
-- separated by seed, continuous across lattice cells and zero, the same whole and in tiles, bounded
-- in octaves and field size, and paints built on fields that compose with scenes, save, and fail
-- with context.
local color = require '@magick/color'
local noise = require '@magick/noise'
local paint = require '@magick/paint'
local path = require '@magick/path'
local render = require '@magick/render'
local scene = require '@magick/scene'
local test = require '@jess/test'
local transform = require '@magick/transform'

local expect = test.expect
local suite = test.new()

local function same(first: { number }, second: { number }): boolean
  for index, value in first do
    if value ~= second[index] then return false end
  end

  return #first == #second
end

suite.describe('noise', function()
  suite.it('gives the same value for the same seed and point, in any order', function()
    local forward, backward = {}, {}

    for index = 1, 200 do
      table.insert(forward, noise.perlin(17, index * 0.37 - 30, index * -0.21))
    end

    for index = 200, 1, -1 do
      backward[index] = noise.perlin(17, index * 0.37 - 30, index * -0.21)
    end

    expect(same(forward, backward)).toBe(true)
    expect(noise.hash(5, 1, 2, 3)).toBe(noise.hash(5, 1, 2, 3))
    expect(noise.hash(5, 1, 2, 3) ~= noise.hash(5, 1, 3, 2)).toBe(true)
  end)

  suite.it('separates seeds: values of two seeds are uncorrelated', function()
    local product, firstSquares, secondSquares = 0, 0, 0

    for index = 1, 2000 do
      local first, second = noise.perlin(1, index * 0.731, index * 0.413), noise.perlin(2, index * 0.731, index * 0.413)

      product += first * second
      firstSquares += first * first
      secondSquares += second * second
    end

    expect(math.abs(product / math.sqrt(firstSquares * secondSquares)) < 0.1).toBe(true)
  end)

  suite.it('is zero on lattice points, bounded, and continuous across cells and across zero', function()
    for index = -5, 5 do
      expect(noise.perlin(3, index, -index)).toBe(0)
    end

    local worst, largest = 0, 0

    for step = -400, 400 do
      local across = step * 0.0125
      local here, next = noise.perlin(3, across, 0.37), noise.perlin(3, across + 0.0001, 0.37)

      worst = math.max(worst, math.abs(next - here))
      largest = math.max(largest, math.abs(here))
    end

    expect(worst < 0.001).toBe(true)
    expect(largest <= 0.75).toBe(true)
  end)

  suite.it('keeps value noise and fractal sums in their ranges', function()
    for index = 1, 500 do
      local across, down = index * 1.37 - 300, index * -0.73
      local value, turbulence, ridged = noise.value(9, across, down), noise.turbulence(9, across * 0.1, down * 0.1), noise.ridged(9, across * 0.1, down * 0.1)

      expect(value >= 0 and value <= 1 and turbulence >= 0 and turbulence <= 1 and ridged >= 0 and ridged <= 1).toBe(true)
      expect(math.abs(noise.fbm(9, across * 0.1, down * 0.1)) <= 0.75).toBe(true)
    end
  end)

  suite.it('gives Worley distances as nearest then second nearest', function()
    for index = 1, 200 do
      local nearest, second = noise.worley(4, index * 0.37, index * 0.91)

      expect(nearest <= second and nearest >= 0 and nearest < 1.5).toBe(true)
    end
  end)

  suite.it('refuses bad seeds and octave counts, and bounds fields', function()
    for _, seed in { 0, -1, 2.5, 2147483647, 0 / 0 } do
      expect(function()
        noise.perlin(seed, 0, 0)
      end).toThrow 'magick: seed must be an integer in 1..2147483646'
    end

    expect(function()
      noise.fbm(1, 0, 0, { octaves = 13 })
    end).toThrow 'magick: MaxOctaves 12 exceeded'

    expect(function()
      noise.field { op = 'sqrt', input = noise.constant(1) }
    end).toThrow 'magick: unknown field op sqrt'

    expect(function()
      noise.field { op = 'constant', value = math.huge }
    end).toThrow 'magick: field constant value must be finite'

    local deep = noise.constant(0)

    for _ = 1, 31 do
      deep = noise.apply('abs', deep)
    end

    expect(function()
      noise.apply('abs', noise.apply('abs', deep))
    end).toThrow 'magick: MaxFieldDepth 32 exceeded'

    local wide = noise.constant(1)

    expect(function()
      for _ = 1, 200 do
        wide = noise.combine('add', wide, wide)
      end
    end).toThrow 'magick: MaxFieldNodes 256 exceeded'
  end)

  suite.it('compiles fields to the arithmetic they describe', function()
    local field = noise.smoothstep(noise.scale(noise.coordinate 'x', 0.1), 0, 1)

    expect(noise.sample(field, 5, 0)).toBe(0.5)
    expect(noise.sample(noise.checker(4), 5, 1)).toBe(1)
    expect(noise.sample(noise.blend(noise.constant(2), noise.constant(4), noise.constant(0.25)), 0, 0)).toBe(2.5)

    local moved = noise.warp(noise.coordinate 'x', noise.constant(1), noise.constant(0), 3)

    expect(noise.sample(moved, 10, 0)).toBe(13)
    expect(noise.sample(noise.transform(noise.coordinate 'y', 1, 0, 0, 2, 0, 5), 0, 3)).toBe(11)
  end)
end)

suite.describe('procedural paints', function()
  local marble = noise.warp(noise.stripes(9, 0.4), noise.fbmField(3, 0.05), noise.fbmField(4, 0.05), 6)
  local ramp = paint.stops(0, '#202028', 0.5, '#f0ece4', 1, '#ffffff')

  suite.it('renders a field paint the same whole and in tiles, under a transform and a clip', function()
    local document = scene.new(70, 50, { space = 'linear' })
    local group = document:add(document:group { clip = { path = path.new():circle(35, 25, 22) } })

    group:add(document:shape(path.new():rect(0, 0, 70, 50), { fill = paint.fieldPaint(marble, ramp), transform = transform.rotate(0.2) }))
    group:add(document:shape(path.new():circle(20, 20, 12), {
      fill = paint.mix(paint.solid '#4060c0', paint.linear(0, 0, 70, 0, paint.stops(0, '#ff0000', 1, '#ffff00')), noise.smoothstep(noise.turbulenceField(5, 0.08), 0.2, 0.6)),
    }))

    local reference = render.image(document, { reference = true })

    for _, size in { 7, 32, 64 } do
      expect(buffer.tostring(render.image(document, { tileSize = size }).data) == buffer.tostring(reference.data)).toBe(true)
    end
  end)

  suite.it('masks a paint by a field', function()
    local tile = color.tile(2, 1)

    paint.fillMask(tile, paint.masked(paint.solid '#ff0000', noise.coordinate 'x'))

    -- Column 0's center is across = 0.5, column 1's 1.5, clamped to 1.
    expect(math.abs(select(4, color.pixel(tile, 0, 0)) - 0.5) < 1e-6).toBe(true)
    expect(select(4, color.pixel(tile, 1, 0))).toBe(1)
  end)

  suite.it('calls a shader at pixel centers in paint space, and reports its failures with the point and tile', function()
    local tile = color.tile(2, 1, { left = 10 })

    paint.fillMask(tile, paint.shader(function(across: number): (number, number, number, number)
      return across / 20, 0, 0, 1
    end))
    expect({ color.toImage(tile):get(0, 0) }).toEqual { 134, 0, 0, 255 }

    expect(function()
      paint.fillMask(color.tile(1, 1, { left = 3, top = 4 }), paint.shader(function(): (number, number, number, number)
        error('bad ink')
      end))
    end).toThrow 'magick: shader failed at (3.5, 4.5) in the tile at (3, 4)'
  end)

  suite.it('saves field and mix paints, and refuses to save a shader', function()
    local document = scene.new(30, 20)

    document:add(document:shape(path.new():rect(0, 0, 30, 20), { fill = paint.mix(paint.fieldPaint(marble, ramp), paint.solid '#00000000', noise.checker(5)) }))

    local text = scene.save(document)

    expect(buffer.tostring(render.image(scene.load(text)).data) == buffer.tostring(render.image(document).data)).toBe(true)

    local shaded = scene.new(4, 4)

    shaded:add(shaded:shape(path.new():rect(0, 0, 4, 4), { fill = paint.shader(function(): (number, number, number, number)
      return 1, 1, 1, 1
    end) }))

    expect(function()
      scene.save(shaded)
    end).toThrow 'magick: a shader paint is a function and cannot be saved'
  end)
end)

return suite
