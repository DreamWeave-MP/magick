--!strict
-- `@magick/material` (MAG-034): every recipe is a typed, seeded paint of fields alone, the same
-- bytes for the same seed and different for another, the same in every tile, coherent at another
-- output size, and checked like every other API.
local color = require '@magick/color'
local material = require '@magick/material'
local paint = require '@magick/paint'
local path = require '@magick/path'
local render = require '@magick/render'
local scene = require '@magick/scene'
local test = require '@jess/test'
local transform = require '@magick/transform'

local expect = test.expect
local suite = test.new()

local function swatch(name: string, seed: number): string
  local tile = color.tile(48, 32)

  paint.fillMask(tile, material.make(name, { seed = seed }))

  return buffer.tostring(color.toImage(tile).data)
end

--- The mean of each channel of an image, 0..255.
local function mean(image: { width: number, height: number, data: buffer }): { number }
  local totals = { 0, 0, 0, 0 }

  for at = 0, image.width * image.height * 4 - 4, 4 do
    for channel = 1, 4 do
      totals[channel] += buffer.readu8(image.data, at + channel - 1)
    end
  end

  for channel = 1, 4 do
    totals[channel] /= image.width * image.height
  end

  return totals
end

suite.describe('recipes', function()
  suite.it('gives the same bytes for a seed and different ones for another, for every recipe', function()
    for _, name in material.names do
      expect(swatch(name, 3) == swatch(name, 3)).toBe(true)
      expect(swatch(name, 3) ~= swatch(name, 4)).toBe(true)
    end
  end)

  suite.it('is made of fields alone: data a worker can take and a scene can save', function()
    local document = scene.new(64, 40)

    for index, name in material.names do
      document:add(document:shape(path.new():rect((index - 1) * 7, 0, index * 7, 40), { fill = material.make(name, { seed = index }) }))
    end

    local reference = render.image(document, { reference = true })

    expect(buffer.tostring(render.image(document, { tileSize = 13 }).data) == buffer.tostring(reference.data)).toBe(true)
    expect(buffer.tostring(render.image(scene.load(scene.save(document))).data) == buffer.tostring(reference.data)).toBe(true)
    expect(material.grain(material.rock { seed = 1 }) ~= nil).toBe(true)
  end)

  suite.it('stays coherent at another output size: the mean color moves by less than two steps', function()
    for _, name in { 'rock', 'wood', 'clouds' } do
      local small, large = scene.new(96, 64), scene.new(192, 128)

      small:add(small:shape(path.new():rect(0, 0, 96, 64), { fill = material.make(name, { seed = 5 }) }))
      large.root:set { transform = transform.scale(2) }
      large:add(large:shape(path.new():rect(0, 0, 96, 64), { fill = material.make(name, { seed = 5 }) }))

      local first, second = mean(render.image(small)), mean(render.image(large))

      for channel = 1, 3 do
        expect(math.abs(first[channel] - second[channel]) < 2).toBe(true)
      end
    end
  end)

  suite.it('refuses unknown recipes and options, and bad scales, details and ramps', function()
    expect(function()
      material.make('lava', { seed = 1 })
    end).toThrow 'magick: unknown material lava'

    expect(function()
      material.wood({ seed = 1, grain = 2 } :: any)
    end).toThrow 'magick: unknown option grain'

    expect(function()
      material.rock { seed = 1, scale = 0 }
    end).toThrow 'magick: a material scale must be in (0, 100000]'

    expect(function()
      material.rock { seed = 1, detail = 9 }
    end).toThrow 'magick: a material detail must be a whole number in 1..8'

    expect(function()
      material.rock { seed = 1, colors = { '#000' } }
    end).toThrow 'magick: a material needs at least two colors'

    expect(function()
      material.rock { seed = 0 }
    end).toThrow 'magick: seed must be an integer in 1..2147483646'
  end)
end)

return suite
