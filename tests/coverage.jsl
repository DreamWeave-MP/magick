--!strict
-- `Path:coverageIn` (MAG-006, MAG-008): exact nonzero and evenodd coverage for crossing and
-- overlapping contours, held to hand-derived pixels and to analytic areas; windows that rebuild a
-- single-shot mask byte for byte; geometry that enters a window from outside; scratch that does not
-- grow with the path; and `Path:mask` left as 0.1.3 had it.
local magick = require '@magick'
local path = require '@magick/path'
local test = require '@jess/test'
local transform = require '@magick/transform'

local expect = test.expect
local suite = test.new()

--- The coverage bytes of a mask, a row a list.
local function rows(mask: magick.Mask): { { number } }
  local out: { { number } } = {}

  for row = 0, mask.height - 1 do
    local values: { number } = {}

    for column = 0, mask.width - 1 do
      table.insert(values, buffer.readu8(mask.data, row * mask.width + column))
    end

    table.insert(out, values)
  end

  return out
end

--- The coverage a mask holds in all, in whole pixels.
local function area(mask: magick.Mask): number
  local total = 0

  for offset = 0, mask.width * mask.height - 1 do
    total += buffer.readu8(mask.data, offset)
  end

  return total / 255
end

local function at(mask: magick.Mask, column: number, row: number): number
  return buffer.readu8(mask.data, row * mask.width + column)
end

--- A regular pentagram about a center, drawn as one self-crossing contour.
local function pentagram(centerX: number, centerY: number, radius: number): path.Path
  local star = path.new()

  for point = 0, 5 do
    local angle = -math.pi / 2 + point * 4 * math.pi / 5
    local pointX, pointY = centerX + radius * math.cos(angle), centerY + radius * math.sin(angle)

    if point == 0 then
      star:moveTo(pointX, pointY)
    else
      star:lineTo(pointX, pointY)
    end
  end

  return star:close()
end

--- Shapes that cross, overlap, nest and cut holes, under a rotation and a scale.
local function compound(): path.Path
  return pentagram(30, 30, 26)
    :ring(62, 24, 18, 9)
    :circle(48, 52, 20, 9)
    :circle(56, 46, 12)
    :moveTo(4, 60)
    :cubicTo(30, 20, 60, 100, 90, 58)
    :lineTo(70, 75)
    :close()
end

suite.describe('fill rules', function()
  suite.it('covers the bowtie exactly: half of pixel (1, 1), where the summed rule gives nothing', function()
    local bowtie = path.new():moveTo(0, 0):lineTo(3, 3):lineTo(3, 0):lineTo(0, 3):close()

    -- Each triangle takes a quarter of the pixel: the integral of y - 1 over 1..1.5 and of
    -- 2 - y over 1.5..2, twice.
    expect(at(bowtie:coverageIn(0, 0, 3, 3), 1, 1)).toBe(128)
    expect(at(bowtie:coverageIn(0, 0, 3, 3, { fillRule = 'evenodd' }), 1, 1)).toBe(128)

    local legacy = bowtie:mask()

    expect(at(legacy, 1, 1)).toBe(0)
  end)

  suite.it('covers two identical overlapping contours once under nonzero and not at all under evenodd', function()
    local twice = path.new():rect(0.5, 0, 2, 1):rect(0.5, 0, 2, 1)

    expect(rows(twice:coverageIn(0, 0, 3, 1))).toEqual { { 128, 255, 0 } }
    expect(rows(twice:coverageIn(0, 0, 3, 1, { fillRule = 'evenodd' }))).toEqual { { 0, 0, 0 } }
    -- The 0.1.3 rule sums the two halves in column 0.
    expect(rows(twice:mask())).toEqual { { 255, 255, 0 } }
  end)

  suite.it('leaves a rectangle traced twice in one contour empty under evenodd', function()
    local retraced = path.new():moveTo(0, 0):lineTo(2, 0):lineTo(2, 1):lineTo(0, 1):lineTo(0, 0)
      :lineTo(2, 0):lineTo(2, 1):lineTo(0, 1):close()

    expect(rows(retraced:coverageIn(0, 0, 2, 1))).toEqual { { 255, 255 } }
    expect(rows(retraced:coverageIn(0, 0, 2, 1, { fillRule = 'evenodd' }))).toEqual { { 0, 0 } }
  end)

  suite.it('fills the pentagram center under nonzero and leaves it empty under evenodd', function()
    local star = pentagram(30, 30, 20)

    expect(at(star:coverageIn(0, 0, 60, 60), 30, 30)).toBe(255)
    expect(at(star:coverageIn(0, 0, 60, 60, { fillRule = 'evenodd' }), 30, 30)).toBe(0)
    -- A point of the star is covered once either way.
    expect(at(star:coverageIn(0, 0, 60, 60, { fillRule = 'evenodd' }), 30, 13)).toBe(255)
  end)

  suite.it('cuts a hole with an opposed contour under both rules, and with a same-way one under evenodd', function()
    local opposed = path.new():ring(10, 10, 8, 4)
    local sameWay = path.new():circle(10, 10, 8):circle(10, 10, 4)

    expect(at(opposed:coverageIn(0, 0, 20, 20), 10, 10)).toBe(0)
    expect(at(opposed:coverageIn(0, 0, 20, 20, { fillRule = 'evenodd' }), 10, 10)).toBe(0)
    expect(at(sameWay:coverageIn(0, 0, 20, 20), 10, 10)).toBe(255)
    expect(at(sameWay:coverageIn(0, 0, 20, 20, { fillRule = 'evenodd' }), 10, 10)).toBe(0)
  end)

  suite.it('matches the union and the symmetric difference of two rotated rectangles in area', function()
    -- Intersection 6.5 by 5.95; a rotation and a translation keep every area.
    local first, second = 10.3 * 7.5, 11.8 * 10.05
    local overlap = 6.5 * 5.95
    local shape = path.new():rect(0.3, 0.7, 10.6, 8.2):rect(4.1, 2.25, 15.9, 12.3)
    local options: path.CoverageOptions = { transform = transform.compose(transform.translate(14, 3), transform.rotate(0.3)) }
    local nonzero = shape:coverageIn(0, 0, 40, 40, options)
    local evenodd = shape:coverageIn(0, 0, 40, 40, { transform = options.transform, fillRule = 'evenodd' })

    expect(math.abs(area(nonzero) - (first + second - overlap)) < 0.25).toBe(true)
    expect(math.abs(area(evenodd) - (first + second - 2 * overlap)) < 0.25).toBe(true)
  end)

  suite.it('agrees with the 0.1.3 mask within one step where no contours overlap', function()
    local shape = path.new():circle(10.3, 9.7, 7.6):ring(30, 10, 8, 3.5):roundRect(42, 2.5, 60, 17, 5)
      :moveTo(2, 22):quadTo(20, 40, 40, 22):cubicTo(45, 30, 50, 20, 58, 36):lineTo(2, 36):close()
    local legacy, left, top = shape:mask()
    local exact = shape:coverageIn(left, top, legacy.width, legacy.height)
    local worst = 0

    for offset = 0, legacy.width * legacy.height - 1 do
      worst = math.max(worst, math.abs(buffer.readu8(legacy.data, offset) - buffer.readu8(exact.data, offset)))
    end

    expect(worst <= 1).toBe(true)
  end)

  suite.it('gives the half-pixel edges their halves', function()
    expect(rows(path.new():rect(0.5, 0, 2.5, 1):coverageIn(0, 0, 4, 1))).toEqual { { 128, 255, 128, 0 } }
    expect(rows(path.new():rect(1, 2, 3, 4):coverageIn(0, 1, 4, 4))).toEqual {
      { 0, 0, 0, 0 },
      { 0, 255, 255, 0 },
      { 0, 255, 255, 0 },
      { 0, 0, 0, 0 },
    }
  end)

  suite.it('covers thin geometry by its area, and a shared edge without a seam', function()
    local sliver = path.new():rect(2, 0, 2.1, 10)

    expect(math.abs(area(sliver:coverageIn(0, 0, 4, 10)) - 1) < 0.05).toBe(true)

    -- Two triangles sharing a diagonal fill the square whole.
    local halves = path.new():polygon({ { 0, 0 }, { 4, 0 }, { 4, 4 } }):polygon { { 0, 0 }, { 4, 4 }, { 0, 4 } }

    for _, rule in { 'nonzero', 'evenodd' } :: { path.FillRule } do
      for _, row in rows(halves:coverageIn(0, 0, 4, 4, { fillRule = rule })) do
        expect(row).toEqual { 255, 255, 255, 255 }
      end
    end
  end)
end)

suite.describe('windows', function()
  suite.it('rebuilds a single-shot window byte for byte from tiles of any size and offset', function()
    local shape = compound()
    local options = { transform = transform.compose(transform.translate(8, -4), transform.rotate(0.21), transform.scale(1.4, 1.1)) }

    for _, rule in { 'nonzero', 'evenodd' } :: { path.FillRule } do
      local whole = shape:coverageIn(0, 0, 150, 120, { transform = options.transform, fillRule = rule })

      for _, size in { { 16, 16 }, { 13, 7 }, { 64, 128 }, { 1, 150 } } do
        local tileWidth, tileHeight = size[1], size[2]

        for tileTop = 0, 119, tileHeight do
          for tileLeft = 0, 149, tileWidth do
            local width, height = math.min(tileWidth, 150 - tileLeft), math.min(tileHeight, 120 - tileTop)
            local tile = shape:coverageIn(tileLeft, tileTop, width, height, { transform = options.transform, fillRule = rule })

            for row = 0, height - 1 do
              local expected = buffer.readstring(whole.data, (tileTop + row) * 150 + tileLeft, width)

              expect(buffer.readstring(tile.data, row * width, width)).toBe(expected)
            end
          end
        end
      end
    end
  end)

  suite.it('carries geometry in from the left of a window and ignores it past the right', function()
    local wide = path.new():rect(-100000, 0, 100000, 4)

    expect(area(wide:coverageIn(50, 1, 8, 2))).toBe(16)

    local leftEdge = path.new():rect(-3.5, 0, 2.5, 1)

    expect(rows(leftEdge:coverageIn(1, 0, 3, 1))).toEqual { { 255, 128, 0 } }
    expect(area(path.new():rect(10, 0, 20, 4):coverageIn(0, 0, 10, 4))).toBe(0)
  end)

  suite.it('gives an empty window nothing, and a window outside the path zeros', function()
    local shape = path.new():circle(5, 5, 4)

    expect(buffer.len(shape:coverageIn(0, 0, 0, 5).data)).toBe(0)
    expect(area(shape:coverageIn(100, 100, 6, 6))).toBe(0)
    expect(area(path.new():coverageIn(0, 0, 6, 6))).toBe(0)
  end)

  suite.it('allocates scratch for the window, not for the path', function()
    -- A path 8000 pixels square; 0.1.3's mask would need 512 MB of cells for it.
    local huge = path.new():circle(4000, 4000, 4000):rect(10, 10, 7990, 7990)
    local before = gcinfo()
    local tile = huge:coverageIn(3992, 3992, 16, 16)
    local grown = gcinfo() - before

    expect(area(tile)).toBe(256)
    expect(grown < 256).toBe(true)
  end)

  suite.it('covers many windows from one prepared outline', function()
    local shape = compound()
    local prepared = path.prepare(shape, { fillRule = 'evenodd' })
    local whole = path.coverOf(prepared, 'evenodd', 0, 0, 100, 100)
    local corner = path.coverOf(prepared, 'evenodd', 40, 40, 20, 20)

    for row = 0, 19 do
      expect(buffer.readstring(corner.data, row * 20, 20)).toBe(buffer.readstring(whole.data, (40 + row) * 100 + 40, 20))
    end

    expect(buffer.tostring(whole.data)).toBe(buffer.tostring(shape:coverageIn(0, 0, 100, 100, { fillRule = 'evenodd' }).data))
  end)
end)

suite.describe('refusals', function()
  suite.it('refuses unknown options and fill rules by name', function()
    local shape = path.new():rect(0, 0, 1, 1)

    expect(function()
      shape:coverageIn(0, 0, 1, 1, { fillrule = 'evenodd' } :: any)
    end).toThrow 'magick: unknown option fillrule'

    expect(function()
      shape:coverageIn(0, 0, 1, 1, { fillRule = 'winding' } :: any)
    end).toThrow 'magick: unknown fill rule winding'
  end)

  suite.it('refuses windows that are not whole, negative, or past MaxImageEdge', function()
    local shape = path.new():rect(0, 0, 1, 1)

    expect(function()
      shape:coverageIn(0.5, 0, 1, 1)
    end).toThrow 'magick: coverage window must be whole numbers'

    expect(function()
      shape:coverageIn(0, 0, -1, 1)
    end).toThrow 'magick: coverage window must not be negative'

    expect(function()
      shape:coverageIn(0, 0, 8193, 1)
    end).toThrow 'magick: MaxImageEdge 8192 exceeded'
  end)

  suite.it('refuses a singular or nonfinite transform before it covers anything', function()
    local shape = path.new():rect(0, 0, 1, 1)

    expect(function()
      shape:coverageIn(0, 0, 1, 1, { transform = { scaleX = 0 / 0, skewY = 0, skewX = 0, scaleY = 1, offsetX = 0, offsetY = 0 } })
    end).toThrow 'magick: transform must be finite'
  end)
end)

suite.describe('clips', function()
  suite.it('multiplies by a clip, and covers nothing outside its mask', function()
    local square = path.new():rect(0, 0, 4, 1)
    local half = magick.mask(2, 1, buffer.fromstring '\128\255')
    local clipped = square:coverageIn(0, 0, 4, 1, { clips = { { mask = half, left = 1, top = 0 } } })

    -- (255 * 128 + 127) // 255 = 128; 255 under 255 stays 255.
    expect(rows(clipped)).toEqual { { 0, 128, 255, 0 } }
  end)

  suite.it('nests clips by multiplying, as compound clipping, to MaxClipDepth', function()
    local circle = path.new():circle(8, 8, 7)
    local left = path.new():rect(0, 0, 9, 16):coverageIn(0, 0, 16, 16)
    local ring = path.new():ring(8, 8, 8, 3):coverageIn(0, 0, 16, 16)
    local clips = { { mask = left, left = 0, top = 0 }, { mask = ring, left = 0, top = 0 } }
    local clipped = circle:coverageIn(0, 0, 16, 16, { clips = clips })

    -- Inside the ring's hole, and right of x = 9, nothing is left.
    expect(at(clipped, 8, 8)).toBe(0)
    expect(at(clipped, 12, 8)).toBe(0)
    expect(at(clipped, 2, 8)).toBe(255)

    local deep: { path.Clip } = {}

    for _ = 1, 16 do
      table.insert(deep, { mask = left, left = 0, top = 0 })
    end

    expect(at(circle:coverageIn(0, 0, 16, 16, { clips = deep }), 2, 8)).toBe(255)
    table.insert(deep, { mask = left, left = 0, top = 0 })

    expect(function()
      circle:coverageIn(0, 0, 16, 16, { clips = deep })
    end).toThrow 'magick: MaxClipDepth 16 exceeded'
  end)

  suite.it('clips a tile the way it clips the whole', function()
    local shape = compound()
    local clip = path.new():circle(50, 50, 30):coverageIn(10, 10, 80, 80, { fillRule = 'evenodd' })
    local clips = { { mask = clip, left = 10, top = 10 } }
    local whole = shape:coverageIn(0, 0, 100, 100, { clips = clips })
    local tile = shape:coverageIn(32, 48, 32, 16, { clips = clips })

    for row = 0, 15 do
      expect(buffer.readstring(tile.data, row * 32, 32)).toBe(buffer.readstring(whole.data, (48 + row) * 100 + 32, 32))
    end
  end)
end)

suite.describe('degenerate outlines', function()
  suite.it('closes a contour whose last point misses its first by a rounding error', function()
    -- The star's closing point comes from an angle four turns on, so it differs from the first in
    -- the last bits; the sliver between them must not leave the row open to its right.
    local star = pentagram(30, 30, 26)

    for row = 0, 59 do
      local line = star:coverageIn(0, row, 80, 1, { transform = transform.compose(transform.translate(8, -4), transform.rotate(0.21)) })

      expect(buffer.readu8(line.data, 79)).toBe(0)
    end

    local sliver = path.new():moveTo(0, 0.5):lineTo(4, 0.5):lineTo(4, 1.5):lineTo(0, 1.5):lineTo(0, 0.5 + 1e-15):close()

    expect(rows(sliver:coverageIn(0, 0, 6, 2))).toEqual { { 128, 128, 128, 128, 0, 0 }, { 128, 128, 128, 128, 0, 0 } }
  end)

  suite.it('covers nothing for zero-area and collinear contours', function()
    local flat = path.new():moveTo(0, 1):lineTo(5, 1):lineTo(2, 1):close():moveTo(1, 0):lineTo(1, 3):lineTo(1, 2):close()

    expect(area(flat:coverageIn(0, 0, 6, 4))).toBe(0)
    expect(area(flat:coverageIn(0, 0, 6, 4, { fillRule = 'evenodd' }))).toBe(0)
  end)
end)

--- A closed zigzag of `count` edges inside the first pixel row, every edge reaching across most of
--- `span` pixels, so nearly every pair of edges crosses in that one strip.
local function zigzag(count: number, span: number): path.Path
  local state = 7
  local shape = path.new():moveTo(0, 0.1)

  for index = 1, count do
    state = state * 48271 % 2147483647
    shape:lineTo(state / 2147483647 * span, if index % 2 == 0 then 0.1 else 0.9)
  end

  return shape:close()
end

suite.describe('pathological geometry', function()
  suite.it('covers a densely crossing strip exactly, the same bytes in any windows', function()
    local prepared = path.prepare(zigzag(120, 24))

    for _, rule in { 'nonzero', 'evenodd' } :: { path.FillRule } do
      local whole = path.coverOf(prepared, rule, 0, 0, 24, 1)
      local pieces: { number } = {}

      for column = 0, 23 do
        table.insert(pieces, buffer.readu8(path.coverOf(prepared, rule, column, 0, 1, 1).data, 0))
      end

      expect(pieces).toEqual(rows(whole)[1])
    end
  end)

  suite.it('refuses a strip past its crossing or work cap before doing that work', function()
    local started = os.clock()

    expect(function()
      path.coverOf(path.prepare(zigzag(400, 100)), 'evenodd', 0, 0, 100, 1)
    end).toThrow 'magick: MaxStrip'

    expect(function()
      path.coverOf(path.prepare(zigzag(3000, 100)), 'nonzero', 0, 0, 100, 1)
    end).toThrow(`magick: MaxStripCrossings {path.MaxStripCrossings} exceeded`)

    -- Before the caps, the 400-edge strip alone took 11.6 s.
    expect(os.clock() - started < 5).toBe(true)
  end)

  suite.it('refuses the same strip in every tiling that reaches it', function()
    local prepared = path.prepare(zigzag(3000, 100))

    for _, size in { 100, 37, 8 } do
      expect(function()
        for left = 0, 99, size do
          path.coverOf(prepared, 'nonzero', left, 0, math.min(size, 100 - left), 1)
        end
      end).toThrow 'magick: MaxStripCrossings'
    end

    -- A window that the cluster never reaches does no work for it, and covers nothing.
    expect(area(path.coverOf(prepared, 'nonzero', 0, 2, 100, 4))).toBe(0)
  end)
end)

return suite
