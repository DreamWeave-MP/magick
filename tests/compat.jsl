--!strict
-- The 0.1.3 contract, run (COMPATIBILITY.md says what each of these promises and why). The call
-- shapes the Morrowind UI and H3 generators use, the ownership and return rules, the legacy
-- compositing and mask behavior the package keeps, and the errors it states. Each value is worked
-- out by hand; a change that breaks a consumer fails here before it reaches one.
local magick = require '@magick'
local path = require '@magick/path'
local test = require '@jess/test'

local expect = test.expect
local suite = test.new()

--- A mask of `width` by `height` bytes, each `value`.
local function flat(width: number, height: number, value: number): magick.Mask
  local covered = buffer.create(width * height)

  buffer.fill(covered, 0, value)

  return magick.mask(width, height, covered)
end

--- The message a call raises, without the position Luau puts in front of it: the message is the
--- contract, and where it was raised is not.
local function failure(run: () -> ()): string
  -- pcall only around the calls that fail on purpose: each is a refusal the contract names.
  local ok, raised = pcall(run)

  assert(not ok, 'the call did not fail')

  return string.match(tostring(raised), '^.-:%d+: (.*)$') or tostring(raised)
end

suite.describe('ownership', function()
  suite.it('copies the bytes fromRGBA is given', function()
    local bytes = buffer.create(4)

    buffer.fill(bytes, 0, 7)

    local image = magick.fromRGBA(1, 1, bytes)

    buffer.writeu8(bytes, 0, 99)

    expect({ image:get(0, 0) }).toEqual { 7, 7, 7, 7 }
  end)

  suite.it('shares the bytes a mask is wrapped around', function()
    local bytes = buffer.create(4)
    local mask = magick.mask(2, 2, bytes)

    buffer.writeu8(bytes, 3, 42)

    expect(mask.data == bytes).toBe(true)
    expect(buffer.readu8(mask.data, 3)).toBe(42)
  end)

  suite.it('gives a clone bytes of its own', function()
    local image = magick.new(2, 2, '#102030')
    local copy = image:clone()

    copy:set(0, 0, 1, 2, 3, 4)

    expect({ image:get(0, 0) }).toEqual { 0x10, 0x20, 0x30, 255 }
    expect({ copy:get(0, 0) }).toEqual { 1, 2, 3, 4 }
  end)
end)

suite.describe('returns', function()
  suite.it('hands back the image a drawing or a tone change was made on', function()
    local image = magick.new(4, 4)

    expect(image:set(0, 0, 1, 1, 1, 1) == image).toBe(true)
    expect(image:fill('#000') == image).toBe(true)
    expect(image:rect(0, 0, 1, 1, '#fff') == image).toBe(true)
    expect(image:over(magick.new(1, 1, '#fff')) == image).toBe(true)
    expect(image:grayscale() == image).toBe(true)
    expect(magick.modulate(image, 100, 100) == image).toBe(true)
    expect(magick.emboss(image) == image).toBe(true)
    expect(magick.tint(image, '#fff', 10) == image).toBe(true)
  end)

  suite.it('hands back a new image from a geometry or a filter', function()
    local image = magick.new(4, 4, '#808080')

    expect(image:clone() == image).toBe(false)
    expect(image:resize(8, 8) == image).toBe(false)
    expect(image:crop(2, 2, 1, 1) == image).toBe(false)
    expect(image:roll(1, 0) == image).toBe(false)
    expect(image:rotate90(true) == image).toBe(false)
    expect(magick.gaussianBlur(image, 1) == image).toBe(false)
  end)
end)

suite.describe('pixels', function()
  suite.it('reads clear outside the image and ignores a store outside it', function()
    local image = magick.new(2, 2, '#ffffff')

    expect({ image:get(5, 5) }).toEqual { 0, 0, 0, 0 }
    expect({ image:get(-1, 0) }).toEqual { 0, 0, 0, 0 }

    image:set(2, 0, 9, 9, 9, 9)

    expect({ image:get(1, 0) }).toEqual { 255, 255, 255, 255 }
  end)

  suite.it('clamps and rounds a stored channel to a byte, half up', function()
    local image = magick.new(1, 1):set(0, 0, 300, -5, 12.5, 999)

    expect({ image:get(0, 0) }).toEqual { 255, 0, 13, 255 }
  end)

  suite.it('carries a color channel past a byte into the one above it', function()
    -- 300 is 44 and one 256: the excess lands in green, as the color packs it.
    expect({ magick.new(1, 1, { 300, 0, 0 }):get(0, 0) }).toEqual { 44, 1, 0, 255 }
  end)

  suite.it('reads a color given by name, position or hex as its channels', function()
    expect({ magick.new(1, 1, { 10, 20, 30 }):get(0, 0) }).toEqual { 10, 20, 30, 255 }
    expect({ magick.new(1, 1, '#abc'):get(0, 0) }).toEqual { 170, 187, 204, 255 }
    expect({ magick.new(1, 1, '#11223344'):get(0, 0) }).toEqual { 17, 34, 51, 68 }
  end)
end)

suite.describe('colors that are nothing and colors that are empty', function()
  suite.it('reads nothing as transparent black and an empty table as opaque black', function()
    expect(magick.color(nil)).toEqual { 0, 0, 0, 0 }
    expect(magick.color({})).toEqual { 0, 0, 0, 255 }
    expect({ magick.new(1, 1):get(0, 0) }).toEqual { 0, 0, 0, 0 }
    expect({ magick.new(1, 1, {}):get(0, 0) }).toEqual { 0, 0, 0, 255 }
  end)
end)

suite.describe('compositing', function()
  suite.it('leaves a destination pixel alone under a clear source pixel', function()
    local under = magick.new(1, 1, '#ff0000')

    under:over(magick.new(1, 1, '#00ff0000'))

    expect({ under:get(0, 0) }).toEqual { 255, 0, 0, 255 }
  end)

  suite.it('blends a half-opaque source by straight alpha', function()
    -- Half of green over full red: red keeps the other half, green is the half it gained.
    local under = magick.new(1, 1, '#ff0000')

    under:over(magick.new(1, 1, '#00ff0080'))

    expect({ under:get(0, 0) }).toEqual { 127, 128, 0, 255 }
  end)

  suite.it('blends two half-alpha pixels to a covered share of full', function()
    -- Covered is 0.502 + 0.502 * 0.498, about 0.752, so the alpha is 192 and the colors are
    -- each over that share.
    local under = magick.new(1, 1, '#ff000080')

    under:over(magick.new(1, 1, '#0000ff80'))

    expect({ under:get(0, 0) }).toEqual { 85, 0, 170, 192 }
  end)

  suite.it('clips an overlay at its offset and ignores one entirely outside', function()
    local under = magick.new(2, 2, '#ff0000')

    under:over(magick.new(2, 2, '#00ff00'), 1, 1)

    expect({ under:get(0, 0) }).toEqual { 255, 0, 0, 255 }
    expect({ under:get(1, 1) }).toEqual { 0, 255, 0, 255 }

    under:over(magick.new(2, 2, '#0000ff'), 5, 5)

    expect({ under:get(1, 1) }).toEqual { 0, 255, 0, 255 }
  end)

  suite.it('composites a mask larger than the image over its overlap only', function()
    local image = magick.new(2, 2)

    image:overMask(flat(3, 3, 255), '#ffffff')

    expect({ image:get(1, 1) }).toEqual { 255, 255, 255, 255 }
    expect({ image:get(0, 0) }).toEqual { 255, 255, 255, 255 }
  end)

  suite.it('leaves an image beyond a smaller mask alone', function()
    local image = magick.new(3, 3)

    image:overMask(flat(2, 2, 255), '#ffffff')

    expect({ image:get(2, 2) }).toEqual { 0, 0, 0, 0 }
    expect({ image:get(1, 1) }).toEqual { 255, 255, 255, 255 }
  end)

  suite.it('refuses a copyAlpha of another size and an unknown mode', function()
    local image = magick.new(1, 1)

    expect(failure(function() image:copyAlpha(magick.new(2, 2), 'dstin') end)).toBe 'magick: mask geometry mismatch'
    expect(failure(function() image:copyAlpha(magick.new(1, 1), 'bogus') end)).toBe 'magick: unknown alpha composite mode bogus'
  end)

  suite.it('refuses a screen at a fractional offset', function()
    expect(failure(function() magick.new(2, 2):screen(magick.new(1, 1), 0.5, 0) end)).toBe 'magick: screen needs a whole offset'
  end)
end)

suite.describe('errors', function()
  suite.it('refuses a size that is not a whole, non-negative number', function()
    expect(failure(function() magick.new(-1, 2) end)).toBe 'magick: integer image size required'
    expect(failure(function() magick.new(1.5, 2) end)).toBe 'magick: integer image size required'
  end)

  suite.it('refuses a color it cannot read', function()
    expect(failure(function() magick.new(1, 1, '#12') end)).toBe 'magick: expected #rgb, #rrggbb, or #rrggbbaa'
  end)

  suite.it('refuses bytes that do not match the geometry', function()
    expect(failure(function() magick.fromRGBA(2, 2, buffer.create(3)) end)).toBe
      'magick: RGBA byte length does not match geometry'
    expect(failure(function() magick.mask(2, 2, buffer.create(3)) end)).toBe 'magick: mask byte length mismatch'
  end)

  suite.it('names the format it cannot read or write by extension', function()
    expect(failure(function() magick.read 'texture.jpeg' end)).toBe 'magick: unsupported input format .jpeg'
    expect(failure(function() magick.write('texture.jpeg', magick.new(1, 1)) end)).toBe
      'magick: unsupported output format .jpeg'
  end)

  suite.it('refuses a file it cannot decode, in the words the codec uses', function()
    expect(failure(function() magick.readBMP(buffer.create(60)) end)).toBe 'magick: not a BMP'
    expect(failure(function() magick.readTGA(buffer.create(4)) end)).toBe 'magick: truncated TGA'
    expect(failure(function() magick.readDDS(buffer.create(200)) end)).toBe 'magick: not a DDS'
  end)

  suite.it('refuses an empty montage', function()
    expect(failure(function() magick.montage {} end)).toBe 'magick: montage requires images'
  end)

  suite.it('needs a moveTo before a path draws a line', function()
    expect(failure(function() path.new():lineTo(1, 1) end)).toBe 'magick: path.lineTo needs a moveTo first'
  end)
end)

suite.describe('paths', function()
  suite.it('finalizes an open contour when it is rasterized', function()
    local outline = path.new():moveTo(0, 0):lineTo(4, 0):lineTo(4, 4):lineTo(0, 4)

    -- An open contour is not in the bounds until something closes it.
    expect({ outline:bounds() }).toEqual { 0, 0, 0, 0 }

    local mask = outline:mask()

    expect({ mask.width, mask.height }).toEqual { 5, 4 }
    expect({ outline:bounds() }).toEqual { 0, 0, 4, 4 }
  end)

  suite.it('finalizes an open contour when it is filled', function()
    local outline = path.new():moveTo(0, 0):lineTo(4, 0):lineTo(4, 4):lineTo(0, 4)

    outline:fill(magick.new(6, 6), '#ffffff')

    expect({ outline:bounds() }).toEqual { 0, 0, 4, 4 }
  end)

  suite.it('drops a contour of fewer than three points when it closes', function()
    local outline = path.new():moveTo(0, 0):lineTo(4, 0)
    local mask = outline:mask()

    expect({ mask.width, mask.height }).toEqual { 0, 0 }
    expect({ outline:bounds() }).toEqual { 0, 0, 0, 0 }
  end)

  suite.it('bounds only closed contours, before and after closing', function()
    local outline = path.new():moveTo(1, 2):lineTo(5, 2):lineTo(5, 7)

    expect({ outline:bounds() }).toEqual { 0, 0, 0, 0 }

    outline:close()

    expect({ outline:bounds() }).toEqual { 1, 2, 5, 7 }
  end)

  suite.it('gives a new path from transformed and leaves the source as it was', function()
    local shape = path.new():rect(0, 0, 2, 2)
    local moved = shape:transformed(2, 10, 20)

    expect(moved == shape).toBe(false)
    expect({ moved:bounds() }).toEqual { 10, 20, 14, 24 }
    expect({ shape:bounds() }).toEqual { 0, 0, 2, 2 }
  end)

  suite.it('leaves an open contour out of a transformed path, as it always has', function()
    local outline = path.new():moveTo(1, 2):lineTo(5, 2):lineTo(5, 7)
    local moved = outline:transformed(2, 10, 20)

    -- Only closed contours are copied: the open one is not in the moved path at all.
    expect({ moved:bounds() }).toEqual { 0, 0, 0, 0 }
    expect({ outline:bounds() }).toEqual { 0, 0, 0, 0 }

    outline:close()

    expect({ outline:transformed(2, 10, 20):bounds() }).toEqual { 12, 24, 20, 34 }
  end)

  suite.it('draws through a pen that forwards to the path', function()
    local outline = path.new()
    local pen = outline:pen()

    pen.moveTo(1, 2)
    pen.lineTo(5, 2)
    pen.lineTo(5, 7)
    pen.close()

    expect({ outline:bounds() }).toEqual { 1, 2, 5, 7 }
  end)
end)

suite.describe('round trips through bytes', function()
  suite.it('reads back the PNG it writes, the same pixels', function()
    local image = magick.new(3, 2, '#40506070')

    image:set(2, 1, 9, 8, 7, 6)

    local back = magick.readPNG(magick.png(image))

    expect(back.width).toBe(3)
    expect(back.height).toBe(2)
    expect(buffer.tostring(back.data)).toBe(buffer.tostring(image.data))
  end)

  suite.it('reads back the DDS it writes, the same pixels', function()
    local image = magick.new(2, 2, '#01020304')
    local back = magick.readDDS(magick.dds(image))

    expect(buffer.tostring(back.data)).toBe(buffer.tostring(image.data))
  end)

  suite.it('encodes to a buffer, not to a file', function()
    local image = magick.new(2, 2, '#01020304')

    expect(type(magick.png(image))).toBe 'buffer'
    expect(type(magick.dds(image))).toBe 'buffer'
  end)
end)

suite.describe('the Morrowind UI and H3 call shapes', function()
  suite.it('reads a settings color with magick.color', function()
    expect(magick.color '#b20047').toEqual { 178, 0, 71, 255 }
    expect(magick.color { 1, 2, 3 }).toEqual { 1, 2, 3, 255 }
  end)

  suite.it('paints a mask in a color or a tile, and keeps its geometry', function()
    local mask = flat(4, 3, 128)
    local painted = magick.paintMask(mask, '#ffffff')
    local tile = magick.new(2, 2, '#000000ff')
    local tiled = magick.paintMask(mask, tile)

    expect({ painted.width, painted.height }).toEqual { 4, 3 }
    expect({ tiled.width, tiled.height }).toEqual { 4, 3 }
    expect({ painted:get(0, 0) }).toEqual { 255, 255, 255, 128 }
  end)

  suite.it('resizes a spiral to a frame and crops the frame out', function()
    local spiral = magick.new(64, 64, '#ffffff')
    local frame = spiral:resize(43, 43, true):crop(39, 39, 2, 2)

    expect({ frame.width, frame.height }).toEqual { 39, 39 }
  end)

  suite.it('fits an image inside a box and keeps its shape', function()
    local image = magick.new(10, 20, '#ffffff')
    local fitted = image:resizeFit(205, 255)

    expect({ fitted.width, fitted.height }).toEqual { 128, 255 }
  end)

  suite.it('lays a shadow out under an image at its offset', function()
    -- The shadow's canvas is the image padded by two sigmas a side, six pixels at a sigma of
    -- three, so the 4 by 4 image makes 16 by 16 before the offset places the shadow in it.
    local shadowed = magick.shadowed(magick.new(4, 4, '#ffffff'), 30, 3, 3, 4)

    expect({ shadowed.width, shadowed.height }).toEqual { 16, 16 }
  end)

  suite.it('builds a 64 by 64 frame from polygons laid over a panel', function()
    local out = magick.new(64, 64, '#090909')

    out:polygonOver({ { 4, 4 }, { 60, 4 }, { 60, 60 }, { 4, 60 } }, '#f0e0d0')
    out:rectOver(10, 10, 20, 20, '#ff0000')

    expect({ out:get(12, 12) }).toEqual { 255, 0, 0, 255 }
    expect({ out:get(0, 0) }).toEqual { 9, 9, 9, 255 }
  end)

  suite.it('paints a noise panel from a seed, the same every time', function()
    local first = magick.noise(16, 16, '#b20047', 5, 0.25)
    local again = magick.noise(16, 16, '#b20047', 5, 0.25)

    expect(buffer.tostring(first.data)).toBe(buffer.tostring(again.data))
  end)

  suite.it('thresholds random noise to black and white', function()
    local noise = magick.randomNoise(8, 8, 3):threshold(0.5)

    expect({ noise.width, noise.height }).toEqual { 8, 8 }

    for row = 0, 7 do
      for column = 0, 7 do
        local red = noise:get(column, row)

        expect(red == 0 or red == 255).toBe(true)
      end
    end
  end)

  suite.it('writes a frame from a montage of equal cells', function()
    local cells = { magick.new(4, 3, '#ff0000'), magick.new(4, 3, '#00ff00'), magick.new(4, 3, '#0000ff') }
    local sheet = magick.montage(cells, 2)

    expect({ sheet.width, sheet.height }).toEqual { 8, 6 }
    expect({ sheet:get(5, 0) }).toEqual { 0, 255, 0, 255 }
    expect({ sheet:get(1, 4) }).toEqual { 0, 0, 255, 255 }
    expect({ sheet:get(5, 4) }).toEqual { 0, 0, 0, 0 }
  end)
end)

suite.describe('the undocumented surface', function()
  suite.it('still exports what consumers reach past the documented names', function()
    expect(type(magick.color)).toBe 'function'
    expect(type(magick.Image)).toBe 'table'
    expect(type(magick.new)).toBe 'function'
  end)

  suite.it('exports the Path metatable that every path it makes carries', function()
    expect(type(path.Path)).toBe 'table'
    expect(getmetatable(path.new()) == path.Path).toBe(true)
  end)
end)

return suite
