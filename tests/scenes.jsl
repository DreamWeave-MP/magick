--!strict
-- The reference scenes of the visual gates: small images drawn through the public API, each one
-- built from explicit colors and geometry so its pixels can be worked out by hand. tools/gallery.jsl
-- renders the same scenes to PNG and holds them to the baseline files in tests/gallery/.
--
-- The fingerprints are regression locks, not oracles. Each was recorded by
-- `jess run --package . --capability filesystem.read --capability filesystem.write tools/gallery.jsl
-- rebaseline` on the 0.2.0 development tree. Only some pixels are derived by hand, in
-- tests/gate.jsl, and only at the points its tests name: `curves` at three points and by area,
-- `clipped circle` by area alone, and the rest at the points listed there. Every other pixel of a
-- scene is held by its fingerprint alone, so the fingerprint says the tree drew this, not that it
-- drew the right thing. A change that moves one is a visual change and needs a reviewed rebaseline.
local color = require '@magick/color'
local magick = require '@magick'
local paint = require '@magick/paint'
local path = require '@magick/path'
local transform = require '@magick/transform'
local support = require './support'

type Image = support.Image

export type Scene = { name: string, render: () -> Image }

local scenes: { Scene } = {}

local function scene(name: string, render: () -> Image)
  table.insert(scenes, { name = name, render = render })
end

local function bytesOf(...: number): buffer
  return buffer.fromstring(string.char(...))
end

scene('clipped rect', function()
  local image = magick.new(8, 6, '#000000')

  -- Both corners are inside Image:rect, so columns -2..3 and rows 1..4 are red; the rest of the
  -- rectangle lies outside the image and is clipped away.
  return image:rect(-2, 1, 3, 4, '#ff0000')
end)

scene('alpha over', function()
  local image = magick.new(4, 4, '#00ff00')

  -- One half-opaque red pixel over opaque green: (128, 127, 0, 255).
  return image:over(magick.fromRGBA(1, 1, bytesOf(255, 0, 0, 128)), 1, 1)
end)

scene('transparent pixels', function()
  local image = magick.new(4, 2, '#405060')
  local source = magick.fromRGBA(
    4,
    2,
    bytesOf(
      255, 255, 255, 0, 255, 0, 0, 255, 0, 0, 255, 128, 255, 255, 255, 64,
      1, 2, 3, 0, 0, 0, 0, 0, 9, 9, 9, 0, 200, 100, 50, 0
    )
  )

  return image:over(source)
end)

scene('holes', function()
  local image = magick.new(12, 12)

  -- The outer rectangle winds one way and the inner one the other, so the inner is a hole.
  path.new()
    :rect(1, 1, 11, 11)
    :moveTo(4, 4)
    :lineTo(4, 8)
    :lineTo(8, 8)
    :lineTo(8, 4)
    :close()
    :fill(image, '#ffffff')

  return image
end)

scene('curves', function()
  local image = magick.new(32, 16)

  -- Left: a quadratic arch from (2, 14) over (8, -2) to (14, 14). Right: the same arch as a cubic
  -- whose control points are the quadratic's, elevated by two thirds, moved 16 to the right.
  path.new(0.01)
    :moveTo(2, 14)
    :quadTo(8, -2, 14, 14)
    :close()
    :fill(image, '#3060c0')

  path.new(0.01)
    :moveTo(18, 14)
    :cubicTo(22, 3.3333333333333, 26, 3.3333333333333, 30, 14)
    :close()
    :fill(image, '#c06030')

  return image
end)

scene('clipped circle', function()
  local image = magick.new(10, 10)

  -- A circle of radius 5 centred on the left edge: the half inside the image is covered.
  return path.new(0.05):circle(0, 5, 5):fill(image, '#ffffff')
end)

scene('gradient', function()
  return magick.verticalGradient(4, 5, '#000000', '#ffffff')
end)

scene('gradient alpha', function()
  local image = magick.new(4, 5, '#ffffff')
  local ramp = magick.verticalGradient(4, 5, '#ff000000', '#ff0000ff')

  return image:over(ramp)
end)

scene('line caps', function()
  local image = magick.new(16, 12)

  path.new():line(4, 2, 12, 2, 4, 'butt'):fill(image, '#ffffff')
  path.new():line(4, 6, 12, 6, 4, 'round'):fill(image, '#ffffff')
  path.new():line(4, 10, 12, 10, 4, 'square'):fill(image, '#ffffff')

  return image
end)

scene('half pixel', function()
  local image = magick.new(1, 1)

  -- The left half of the only pixel: white at half coverage.
  return path.new():rect(0, 0, 0.5, 1):fill(image, '#ffffff')
end)

scene('one column', function()
  local image = magick.new(1, 17, '#000000')

  -- Rows 4 and 8 are half covered, rows 5 to 7 whole.
  return path.new():rect(0, 4.5, 1, 8.5):fill(image, '#ffffff')
end)

scene('one row', function()
  local image = magick.new(17, 1, '#000000')

  return path.new():rect(4.5, 0, 8.5, 1):fill(image, '#ffffff')
end)

--- A self-crossing star, two same-way overlapping circles and a ring, for the fill-rule scenes.
local function crossings(): path.Path
  local star = path.new()

  for point = 0, 5 do
    local angle = -math.pi / 2 + point * 4 * math.pi / 5
    local pointX, pointY = 12 + 11 * math.cos(angle), 12 + 11 * math.sin(angle)

    if point == 0 then
      star:moveTo(pointX, pointY)
    else
      star:lineTo(pointX, pointY)
    end
  end

  return star:close():circle(30, 10, 7):circle(36, 14, 7):ring(52, 12, 10, 5)
end

-- MAG-006: the same outline under each rule. Nonzero fills the star's center and the circles'
-- overlap; evenodd leaves both empty. The ring's hole is empty under both.
scene('fill rule nonzero', function()
  local coverage = crossings():coverageIn(0, 0, 64, 24)

  return magick.new(64, 24, '#101828'):overMask(coverage, '#f0c040', 0, 0)
end)

scene('fill rule evenodd', function()
  local coverage = crossings():coverageIn(0, 0, 64, 24, { fillRule = 'evenodd' })

  return magick.new(64, 24, '#101828'):overMask(coverage, '#40c0f0', 0, 0)
end)

-- Compound clipping: the outline clipped by a band and then by a ring, by multiplying coverage.
scene('compound clip', function()
  local band = path.new():rect(0, 4, 64, 20):coverageIn(0, 0, 64, 24)
  local ring = path.new():ring(32, 12, 30, 6):coverageIn(0, 0, 64, 24)
  local clips = { { mask = band, left = 0, top = 0 }, { mask = ring, left = 0, top = 0 } }
  local coverage = crossings():coverageIn(0, 0, 64, 24, { clips = clips })

  return magick.new(64, 24, '#101828'):overMask(coverage, '#f05080', 0, 0)
end)

--- An open zigzag with a right angle and an acute turn, offset into a grid cell.
local function zigzag(left: number, top: number): path.Path
  return path.new():moveTo(left + 4, top + 22):lineTo(left + 16, top + 6):lineTo(left + 28, top + 22):lineTo(left + 30, top + 8)
end

-- MAG-007: every join (rows: miter, round, bevel) with every cap (columns: butt, round, square),
-- turned by 0.3 radians about the middle.
scene('stroke joins and caps', function()
  local image = magick.new(132, 124, '#14161c')
  local turn = transform.compose(transform.translate(66, 62), transform.rotate(0.3), transform.translate(-54, -48))

  for row, join in { 'miter', 'round', 'bevel' } :: { path.Join } do
    for column, cap in { 'butt', 'round', 'square' } :: { path.Cap } do
      local outline = zigzag((column - 1) * 36, (row - 1) * 32):stroked { width = 5, join = join, cap = cap }

      image:overMask(outline:coverageIn(0, 0, 132, 124, { transform = turn }), '#e8d8a0', 0, 0)
    end
  end

  return image
end)

-- Dashes with zero-length round dots, carried around a curve and mirrored left to right.
scene('stroke dashes mirrored', function()
  local wave = path.new():moveTo(6, 24):cubicTo(30, -6, 50, 54, 74, 24):cubicTo(86, 9, 96, 12, 102, 20)
  local dashed = wave:stroked { width = 4, cap = 'round', join = 'round', dashes = { 9, 5, 0, 5 }, dashOffset = 3 }
  local mirror = transform.compose(transform.translate(108, 0), transform.scale(-1, 1))
  local image = magick.new(108, 40, '#14161c')

  return image:overMask(dashed:coverageIn(0, 0, 108, 40, { transform = mirror }), '#80d0ff', 0, 0)
end)

-- MAG-011: a conic gradient whose seam is turned to straight up, through a ring, and a linear
-- gradient of hard-edged stripes repeated under a rotation and a shear.
scene('conic seam', function()
  local tile = color.tile(48, 48)
  local hues = paint.stops(0, '#ff0000', 0.33, '#00ff00', 0.67, '#0000ff', 1, '#ff0000')

  paint.fillPath(tile, path.new():ring(24, 24, 22, 8), paint.conic(24, 24, hues, { startAngle = -math.pi / 2 }))
  paint.fillPath(tile, path.new():circle(24, 24, 6), paint.conic(24, 24, paint.stops(0, '#000000', 1, '#ffffff')))

  return color.toImage(tile)
end)

scene('repeated stripes', function()
  local tile = color.tile(48, 32)
  local stripes = paint.stops(0, '#f0e0b0', 0.5, '#f0e0b0', 0.5, '#304060', 1, '#304060')
  local slant = transform.compose(transform.rotate(0.4), transform.skew(0.3))

  paint.fillPath(tile, path.new():roundRect(2, 2, 46, 30, 6), paint.linear(0, 0, 6, 0, stripes, { spread = 'repeat', transform = slant }))

  return color.toImage(tile)
end)

-- MAG-012: a 4 by 4 checker of opaque and transparent cells, mirrored, turned and scaled, sampled
-- bilinear through a circle over a gradient.
scene('transformed pattern', function()
  local checker = magick.new(4, 4)

  for row = 0, 3 do
    for column = 0, 3 do
      if (column // 2 + row // 2) % 2 == 0 then checker:set(column, row, 255, 230, 160, 255) end
    end
  end

  local tile = color.tile(48, 48)
  local place = transform.compose(transform.translate(24, 24), transform.rotate(0.6), transform.scale(3))

  paint.fillMask(tile, paint.linear(0, 0, 0, 48, paint.stops(0, '#203050', 1, '#502030')))
  paint.fillPath(tile, path.new():circle(24, 24, 21), paint.pattern(checker, { transform = place, edge = 'mirror', sampling = 'bilinear' }))

  return color.toImage(tile)
end)

--- The scenes, in the order the gallery renders and the gate suite checks them.
local Scenes: { Scene } = scenes

--- What each scene's pixels and its PNG file were when recorded: `<name> pixels` is the geometry
--- and CRC-32 of the RGBA bytes (support.pixels), `<name> png` the length and CRC-32 of the file
--- `magick.png` encodes (support.digest). The placeholders are replaced by the first rebaseline.
local Recorded: { [string]: string } = {
  ['clipped rect pixels'] = '8x6:258ecf47',
  ['clipped rect png'] = '89:b3c80d46',
  ['alpha over pixels'] = '4x4:0d2338d8',
  ['alpha over png'] = '88:6302bafb',
  ['transparent pixels pixels'] = '4x2:e8fc71ba',
  ['transparent pixels png'] = '87:7873314a',
  ['holes pixels'] = '12x12:5cd3940c',
  ['holes png'] = '96:5c75da1f',
  ['curves pixels'] = '32x16:2c79aacb',
  ['curves png'] = '227:cf9009f9',
  ['clipped circle pixels'] = '10x10:caa22dd3',
  ['clipped circle png'] = '117:41b22ccd',
  ['gradient pixels'] = '4x5:96bca3f9',
  ['gradient png'] = '94:adf7c85c',
  ['gradient alpha pixels'] = '4x5:16fb8198',
  ['gradient alpha png'] = '93:2af94847',
  ['line caps pixels'] = '16x12:1ff2d7a9',
  ['line caps png'] = '123:db748616',
  ['half pixel pixels'] = '1x1:3f459352',
  ['half pixel png'] = '70:84c7bd8f',
  ['one column pixels'] = '1x17:65e06997',
  ['one column png'] = '93:25640511',
  ['one row pixels'] = '17x1:65e06997',
  ['one row png'] = '88:3fbca953',
  ['fill rule nonzero pixels'] = '64x24:734fabc2',
  ['fill rule nonzero png'] = '799:0134a883',
  ['fill rule evenodd pixels'] = '64x24:11039a7d',
  ['fill rule evenodd png'] = '972:7a04541a',
  ['compound clip pixels'] = '64x24:ff91d9c4',
  ['compound clip png'] = '797:ab4254c4',
  ['stroke joins and caps pixels'] = '132x124:5d966df0',
  ['stroke joins and caps png'] = '4841:82f16e74',
  ['stroke dashes mirrored pixels'] = '108x40:ed898f9d',
  ['stroke dashes mirrored png'] = '1398:eefb5a78',
  ['conic seam pixels'] = '48x48:dee03043',
  ['conic seam png'] = '4104:b1821894',
  ['repeated stripes pixels'] = '48x32:31ed4e9b',
  ['repeated stripes png'] = '317:5e6e1573',
  ['transformed pattern pixels'] = '48x48:10f1049d',
  ['transformed pattern png'] = '3101:9f715988',
}

return table.freeze {
  scenes = Scenes,
  recorded = Recorded,
}
