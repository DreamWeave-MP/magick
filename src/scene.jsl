--!strict
--[[
@magick/scene: a retained composition (RFC-0001 section 12).

A document is a tree of nodes under one root group: shapes (a path filled and stroked with paints),
images (a legacy `Image` placed by a matrix) and groups (children composited in their own isolated
tile, with a transform, opacity, blend, clip, mask and filters). Each node has one parent and an id
the document gives it in order of creation, so the order of everything is the order of the calls
that built it, never of table traversal.

The tree is the mutable builder; `@magick/render` compiles it into an immutable plan, snapshotting
every path, paint and option, so changing the document after a compile never changes that plan.
Paths and paints are shared freely between nodes: a paint is a frozen value, and a path is read
only at compile time.
]]
local bytes = require '@dream/bytes'
local color = require '@magick/color'
local json = require '@jess/json'
local magick = require '@magick'
local paint = require '@magick/paint'
local path = require '@magick/path'
local transform = require '@magick/transform'

type Matrix = transform.Matrix

local Module = {}

--- The deepest a node may sit below the root, and the most nodes one document holds.
Module.MaxDepth = 32
Module.MaxNodes = 65536

--- How a shape's outline is stroked: `stroked`'s options, less its `transform`.
export type StrokeStyle = {
  width: number,
  join: path.Join?,
  miterLimit: number?,
  cap: path.Cap?,
  dashes: { number }?,
  dashOffset: number?,
}

--- A filter on a group, applied to what its children drew before the group's clip, mask and opacity.
--- `blur` is a gaussian of standard deviation `radius`; `shadow` lays a blurred, offset, colored copy
--- of the group's alpha under it.
export type Filter =
  { kind: 'blur', radius: number }
  | { kind: 'shadow', radius: number, offsetX: number, offsetY: number, color: magick.Color }

--- A group's clip: a path, by a fill rule, in the group's own space.
export type Clip = { path: path.Path, fillRule: path.FillRule? }

--- A group's mask: another node, drawn in the group's space, whose alpha or luminance scales the
--- group's coverage. The mask node is owned by the group and is never drawn on its own.
export type Mask = { node: Node, kind: ('alpha' | 'luminance')? }

--- The options every node takes.
export type NodeOptions = {
  transform: Matrix?,
  opacity: number?,
  blend: color.BlendMode?,
  --- A name for the node in plan dumps; it changes nothing that is drawn.
  name: string?,
}

--- A shape's options: its paints and how they lay down.
export type ShapeOptions = NodeOptions & {
  fill: paint.Paint?,
  fillRule: path.FillRule?,
  stroke: paint.Paint?,
  strokeStyle: StrokeStyle?,
}

--- An image's options.
export type ImageOptions = NodeOptions & { sampling: paint.Sampling? }

--- A group's options.
export type GroupOptions = NodeOptions & { clip: Clip?, mask: Mask?, filters: { Filter }? }

type NodeData = {
  id: number,
  kind: 'shape' | 'image' | 'group',
  document: Document,
  parent: Node?,
  children: { Node },
  name: string?,
  transform: Matrix,
  opacity: number,
  blend: color.BlendMode,
  geometry: path.Path?,
  fill: paint.Paint?,
  fillRule: path.FillRule,
  stroke: paint.Paint?,
  strokeStyle: StrokeStyle?,
  image: magick.Image?,
  sampling: paint.Sampling,
  clip: Clip?,
  mask: Mask?,
  filters: { Filter },
  --- Whether this node is a group's mask, and so never drawn as a child.
  isMask: boolean,
}

local Node = {}
Node.__index = Node

export type Node = typeof(setmetatable({} :: NodeData, Node))

type DocumentData = {
  width: number,
  height: number,
  space: color.Space,
  background: magick.Color?,
  seed: number,
  root: Node,
  nextId: number,
  count: number,
}

local Document = {}
Document.__index = Document

export type Document = typeof(setmetatable({} :: DocumentData, Document))

--- What `new` takes.
export type DocumentOptions = { background: magick.Color?, space: color.Space?, seed: number? }

local function finite(value: number): boolean
  return value == value and value > -math.huge and value < math.huge
end

local function checkKeys(options: unknown, known: { [string]: boolean })
  if options == nil then return end

  for name in options :: { [string]: unknown } do
    if not known[name] then error(`magick: unknown option {name}`, 4) end
  end
end

local function checkOpacity(opacity: number?): number
  local value = opacity or 1

  if not finite(value) or value < 0 or value > 1 then error('magick: opacity must be in 0..1', 4) end

  return value
end

local function checkSeed(seed: number): number
  if seed ~= math.floor(seed) or seed < 1 or seed > 2147483646 then error('magick: seed must be an integer in 1..2147483646', 3) end

  return seed
end

local function makeNode(document: Document, kind: 'shape' | 'image' | 'group', options: NodeOptions?): Node
  if document.count >= Module.MaxNodes then error(`magick: MaxNodes {Module.MaxNodes} exceeded`, 4) end

  local matrix = if options and options.transform then transform.check(options.transform) else transform.identity()
  local blend: color.BlendMode = if options and options.blend then options.blend else 'normal'

  color.checkBlend(blend)

  local data: NodeData = {
    id = document.nextId,
    kind = kind,
    document = document,
    parent = nil,
    children = {},
    name = if options then options.name else nil,
    transform = matrix,
    opacity = checkOpacity(if options then options.opacity else nil),
    blend = blend,
    geometry = nil,
    fill = nil,
    fillRule = 'nonzero',
    stroke = nil,
    strokeStyle = nil,
    image = nil,
    sampling = 'nearest',
    clip = nil,
    mask = nil,
    filters = {},
    isMask = false,
  }

  document.nextId += 1
  document.count += 1

  return setmetatable(data, Node)
end

--- An empty document `width` by `height` pixels, drawn over `background` (transparent when left
--- out), composited in `space` (`srgb` by default), with an integer seed in 1..2^31 - 2 (1).
function Module.new(width: number, height: number, options: DocumentOptions?): Document
  checkKeys(options, { background = true, space = true, seed = true })

  for _, value in { width, height } do
    if not finite(value) or value ~= math.floor(value) or value < 1 then error('magick: a document needs a whole size of at least 1', 2) end
    if value > 8192 then error('magick: MaxImageEdge 8192 exceeded', 2) end
  end

  local space: color.Space = if options and options.space then options.space else 'srgb'

  if space ~= 'srgb' and space ~= 'linear' then error(`magick: unknown color space {space}`, 2) end

  local data: DocumentData = {
    width = width,
    height = height,
    space = space,
    background = if options then options.background else nil,
    seed = checkSeed(if options and options.seed then options.seed else 1),
    root = (nil :: unknown) :: Node,
    nextId = 1,
    count = 0,
  }
  local document = setmetatable(data, Document)

  document.root = makeNode(document, 'group', { name = 'root' })

  return document
end

local ShapeKeys = {
  transform = true,
  opacity = true,
  blend = true,
  name = true,
  fill = true,
  fillRule = true,
  stroke = true,
  strokeStyle = true,
}

--- A new shape, not yet in the tree: `geometry` filled with `fill` by `fillRule`, then stroked with
--- `stroke` as `strokeStyle` says. Either paint may be left out; a stroke paint needs a style.
function Document.shape(self: Document, geometry: path.Path, options: ShapeOptions?): Node
  checkKeys(options, ShapeKeys)

  local node = makeNode(self, 'shape', options)

  node.geometry = geometry

  if options then
    node.fill = options.fill
    node.stroke = options.stroke
    node.strokeStyle = options.strokeStyle

    if options.fillRule then
      if options.fillRule ~= 'nonzero' and options.fillRule ~= 'evenodd' then error(`magick: unknown fill rule {options.fillRule}`, 2) end

      node.fillRule = options.fillRule
    end

    if node.stroke and not node.strokeStyle then error('magick: a stroke paint needs a strokeStyle', 2) end
  end

  return node
end

--- A new image node, not yet in the tree: `image`'s pixels laid on the unit squares of its own
--- space from the origin, placed by `transform`, sampled `nearest` or `bilinear`.
function Document.image(self: Document, image: magick.Image, options: ImageOptions?): Node
  checkKeys(options, { transform = true, opacity = true, blend = true, name = true, sampling = true })

  if image.width < 1 or image.height < 1 then error('magick: an image node needs pixels', 2) end

  local node = makeNode(self, 'image', options)

  node.image = image
  node.sampling = if options and options.sampling then options.sampling else 'nearest'

  if node.sampling ~= 'nearest' and node.sampling ~= 'bilinear' then error(`magick: unknown sampling {node.sampling}`, 2) end

  return node
end

local function checkFilters(filters: { Filter }): { Filter }
  for _, filter in filters do
    if filter.kind ~= 'blur' and filter.kind ~= 'shadow' then error(`magick: unknown filter {(filter :: { kind: string }).kind}`, 4) end
    if not finite(filter.radius) or filter.radius < 0 or filter.radius > 21 then error('magick: a filter radius must be in 0..21', 4) end

    if filter.kind == 'shadow' then
      if not finite(filter.offsetX) or not finite(filter.offsetY) or math.abs(filter.offsetX) > 64 or math.abs(filter.offsetY) > 64 then
        error('magick: a shadow offset must be finite and within 64 pixels', 4)
      end
    end
  end

  return table.clone(filters)
end

--- A new group, not yet in the tree. Its children draw into an isolated transparent tile, which is
--- then filtered, clipped, masked, faded by its opacity once, and laid on by its blend.
function Document.group(self: Document, options: GroupOptions?): Node
  checkKeys(options, { transform = true, opacity = true, blend = true, name = true, clip = true, mask = true, filters = true })

  local node = makeNode(self, 'group', options)

  if options then
    node.clip = options.clip
    node.filters = checkFilters(options.filters or {})

    local mask = options.mask

    if mask then
      local kind = mask.kind or 'alpha'

      if kind ~= 'alpha' and kind ~= 'luminance' then error(`magick: unknown mask kind {kind}`, 2) end
      if not rawequal(mask.node.document, self) then error('magick: a mask node must belong to the same document', 2) end
      if mask.node.parent or mask.node.isMask then error('magick: a mask node must not be in the tree or another mask', 2) end

      mask.node.isMask = true
      node.mask = { node = mask.node, kind = kind }
    end
  end

  return node
end

--- How deep a node sits: the root is 0.
local function depthOf(node: Node): number
  local depth = 0
  local current = node.parent

  while current do
    depth += 1
    current = current.parent
  end

  return depth
end

--- How many levels a subtree holds below its top.
local function heightOf(node: Node): number
  local tallest = 0

  for _, child in node.children do
    tallest = math.max(tallest, 1 + heightOf(child))
  end

  return tallest
end

--- Puts `child` in this group at `index` (at the end when left out) and returns it. A child must be
--- from the same document, not already in a tree, not a mask, and not this group or one above it.
function Node.add(self: Node, child: Node, index: number?): Node
  if self.kind ~= 'group' then error('magick: only a group has children', 2) end
  if not rawequal(child.document, self.document) then error('magick: a node belongs to the document that made it', 2) end
  if child.parent then error('magick: the node is already in a group; remove it first', 2) end
  if child.isMask then error('magick: a mask node is drawn only as its group\'s mask', 2) end
  if rawequal(child, self.document.root) then error('magick: the root is never a child', 2) end

  local ancestor: Node? = self

  while ancestor do
    if rawequal(ancestor, child) then error('magick: a group cannot contain itself', 2) end

    ancestor = ancestor.parent
  end

  if depthOf(self) + 1 + heightOf(child) > Module.MaxDepth then error(`magick: MaxDepth {Module.MaxDepth} exceeded`, 2) end

  local at = index or #self.children + 1

  if at ~= math.floor(at) or at < 1 or at > #self.children + 1 then error('magick: child index out of range', 2) end

  table.insert(self.children, at, child)
  child.parent = self

  return child
end

--- Takes this node out of its group, leaving its own subtree as it is, and returns it.
function Node.remove(self: Node): Node
  local parent = self.parent

  if not parent then return self end

  local at = table.find(parent.children, self) :: number

  table.remove(parent.children, at)
  self.parent = nil

  return self
end

--- Moves this node to `index` among its group's children, and returns it.
function Node.reorder(self: Node, index: number): Node
  local parent = self.parent

  if not parent then error('magick: the node is not in a group', 2) end
  if index ~= math.floor(index) or index < 1 or index > #parent.children then error('magick: child index out of range', 2) end

  local at = table.find(parent.children, self) :: number

  table.remove(parent.children, at)
  table.insert(parent.children, index, self)

  return self
end

--- Sets this node's transform, its opacity or its blend after it was made, and returns it.
function Node.set(self: Node, options: NodeOptions): Node
  checkKeys(options, { transform = true, opacity = true, blend = true, name = true })

  if options.transform then self.transform = transform.check(options.transform) end
  if options.opacity then self.opacity = checkOpacity(options.opacity) end
  if options.blend then self.blend = color.checkBlend(options.blend) end
  if options.name then self.name = options.name end

  return self
end

--- Adds a node to the document's root and returns it.
function Document.add(self: Document, node: Node, index: number?): Node
  return self.root:add(node, index)
end

--- The format a saved scene names, and the version this module writes and reads.
Module.Format = 'magick.scene'
Module.Version = 1
--- The longest saved scene `load` reads, and the most pixels its images may hold together.
Module.MaxSceneBytes = 64 * 1024 * 1024
Module.MaxAssetPixels = 67108864

local function matrixFields(matrix: Matrix): { number }
  return { matrix.scaleX, matrix.skewY, matrix.skewX, matrix.scaleY, matrix.offsetX, matrix.offsetY }
end

local function colorText(value: magick.Color?): string?
  if value == nil then return nil end

  local channels = magick.color(value)

  return string.format('#%02x%02x%02x%02x', channels[1], channels[2], channels[3], channels[4])
end

--- Pixels saved once however many nodes and paints use them: the images and tiles a document
--- reads, numbered in the order they are first met.
type Assets = { list: { { [string]: unknown } }, index: { [buffer]: number } }

local function assetOf(assets: Assets, width: number, height: number, data: buffer, format: string, space: string): number
  local known = assets.index[data]

  if known then return known end

  local record: { [string]: unknown } = {
    id = #assets.list + 1,
    width = width,
    height = height,
    format = format,
    space = space,
    crc32 = string.format('%08x', bytes.crc32(data)),
    data = bytes.toBase64(data),
  }

  table.insert(assets.list, record)
  assets.index[data] = #assets.list

  return #assets.list
end

local function describeNode(node: Node, assets: Assets): { [string]: unknown }
  local out: { [string]: unknown } = {
    id = node.id,
    kind = node.kind,
    name = node.name,
    transform = matrixFields(node.transform),
    opacity = node.opacity,
    blend = node.blend,
  }

  local function sourceAsset(source: paint.PatternSource): number
    return assetOf(assets, source.width, source.height, source.data, source.format, source.space)
  end

  if node.kind == 'shape' then
    out.path = path.describe(node.geometry :: path.Path)
    out.fillRule = node.fillRule
    out.fill = if node.fill then paint.describe(node.fill, sourceAsset) else nil
    out.stroke = if node.stroke then paint.describe(node.stroke, sourceAsset) else nil
    out.strokeStyle = node.strokeStyle
  elseif node.kind == 'image' then
    local image = node.image :: magick.Image

    out.image = assetOf(assets, image.width, image.height, image.data, 'straight8', 'srgb')
    out.sampling = node.sampling
  else
    local children = {}

    for _, child in node.children do
      table.insert(children, describeNode(child, assets))
    end

    out.children = children

    local clip = node.clip

    if clip then out.clip = { path = path.describe(clip.path), fillRule = clip.fillRule or 'nonzero' } end

    local mask = node.mask

    if mask then out.mask = { node = describeNode(mask.node, assets), kind = mask.kind or 'alpha' } end

    if #node.filters > 0 then
      local filters = {}

      for _, filter in node.filters do
        local copy = table.clone(filter) :: { [string]: unknown }

        if filter.kind == 'shadow' then copy.color = colorText(filter.color) end

        table.insert(filters, copy)
      end

      out.filters = filters
    end
  end

  return out
end

--- The document as plain data: diffable, versioned, every number and name the render reads, and
--- its pixels as checksummed assets. No functions, nothing executable.
function Module.describe(document: Document): { [string]: unknown }
  local assets: Assets = { list = {}, index = {} }
  local root = describeNode(document.root, assets)

  return {
    format = Module.Format,
    version = Module.Version,
    width = document.width,
    height = document.height,
    space = document.space,
    seed = document.seed,
    background = colorText(document.background),
    assets = assets.list,
    root = root,
  }
end

--- The document as JSON text with sorted keys, two spaces a level: the same document always gives
--- the same text.
function Module.save(document: Document): string
  return json.encodeTable(Module.describe(document), { indent = 2 })
end

local NodeKeys: { [string]: boolean } = {
  id = true,
  kind = true,
  name = true,
  transform = true,
  opacity = true,
  blend = true,
  path = true,
  fillRule = true,
  fill = true,
  stroke = true,
  strokeStyle = true,
  image = true,
  sampling = true,
  children = true,
  clip = true,
  mask = true,
  filters = true,
}

local function field(record: { [string]: unknown }, name: string, kind: string): unknown
  local value = record[name]

  if type(value) ~= kind then error(`magick: scene field {name} must be a {kind}`, 4) end

  return value
end

type Loading = { document: Document, assets: { magick.Image | color.Tile }, seen: { [number]: boolean } }

local function loadNode(record: { [string]: unknown }, loading: Loading): Node
  for name in record do
    if not NodeKeys[name] then error(`magick: unknown scene field {name}`, 3) end
  end

  local fields = field(record, 'transform', 'table') :: { number }

  if #fields ~= 6 then error('magick: a node transform is six numbers', 3) end

  local options: NodeOptions = {
    transform = transform.matrix(fields[1], fields[2], fields[3], fields[4], fields[5], fields[6]),
    opacity = field(record, 'opacity', 'number') :: number,
    blend = field(record, 'blend', 'string') :: color.BlendMode,
    name = if record.name ~= nil then field(record, 'name', 'string') :: string else nil,
  }
  local document = loading.document
  local kind = field(record, 'kind', 'string')
  local function source(asset: number): magick.Image | color.Tile
    local found = loading.assets[asset]

    if not found then error(`magick: unknown scene asset {asset}`, 5) end

    return found
  end
  local node: Node

  if kind == 'shape' then
    local shapeOptions = options :: ShapeOptions

    shapeOptions.fillRule = field(record, 'fillRule', 'string') :: path.FillRule
    shapeOptions.fill = if record.fill ~= nil then paint.fromDescription(record.fill :: paint.Description, source) else nil
    shapeOptions.stroke = if record.stroke ~= nil then paint.fromDescription(record.stroke :: paint.Description, source) else nil
    shapeOptions.strokeStyle = record.strokeStyle :: StrokeStyle?
    node = document:shape(path.fromDescription(field(record, 'path', 'table') :: path.Description), shapeOptions)
  elseif kind == 'image' then
    local image = source(field(record, 'image', 'number') :: number)

    if (image :: { [string]: unknown }).space then error('magick: an image node takes an image asset', 3) end

    local imageOptions = options :: ImageOptions

    imageOptions.sampling = field(record, 'sampling', 'string') :: paint.Sampling
    node = document:image(image :: magick.Image, imageOptions)
  elseif kind == 'group' then
    local groupOptions = options :: GroupOptions
    local clip = record.clip

    if clip ~= nil then
      local clipRecord = clip :: { [string]: unknown }

      groupOptions.clip = {
        path = path.fromDescription(field(clipRecord, 'path', 'table') :: path.Description),
        fillRule = field(clipRecord, 'fillRule', 'string') :: path.FillRule,
      }
    end

    if record.mask ~= nil then
      local maskRecord = record.mask :: { [string]: unknown }

      groupOptions.mask = {
        node = loadNode(field(maskRecord, 'node', 'table') :: { [string]: unknown }, loading),
        kind = field(maskRecord, 'kind', 'string') :: 'alpha' | 'luminance',
      }
    end

    if record.filters ~= nil then groupOptions.filters = field(record, 'filters', 'table') :: { Filter } end

    node = document:group(groupOptions)

    for _, child in (if record.children ~= nil then field(record, 'children', 'table') else {}) :: { { [string]: unknown } } do
      node:add(loadNode(child, loading))
    end
  else
    error(`magick: unknown node kind {kind}`, 3)
  end

  -- Ids come back as saved, so a reload lists the same plan.
  local id = field(record, 'id', 'number') :: number

  if id ~= math.floor(id) or id < 1 or id > Module.MaxNodes * 4 or loading.seen[id] then error(`magick: scene node id {id} is not a fresh whole number`, 3) end

  loading.seen[id] = true
  node.id = id
  document.nextId = math.max(document.nextId, id + 1)

  return node
end

--- A document from `save`'s text, read as untrusted: refused, with a message naming what is wrong,
--- when it is too long, too deep, of another format or a later version, has unknown fields or
--- kinds, nonfinite or out-of-range numbers, assets whose bytes do not match their checksum or
--- size, or more nodes, commands or pixels than the caps allow.
function Module.load(text: string): Document
  if #text > Module.MaxSceneBytes then error(`magick: MaxSceneBytes {Module.MaxSceneBytes} exceeded`, 2) end

  local limits: json.Options = { maxDepth = 4 * Module.MaxDepth + 32 }
  -- pcall only around the JSON decoder, which raises on text that is not JSON: the refusal is
  -- rephrased as a magick: error naming the scene.
  local parsed, decoded = pcall(json.decode, text, limits)

  if not parsed then error(`magick: a saved scene is not valid JSON: {decoded}`, 2) end

  if type(decoded) ~= 'table' then error('magick: a saved scene is a JSON object', 2) end

  local record = decoded :: { [string]: unknown }

  if record.format ~= Module.Format then error(`magick: not a saved scene: format {tostring(record.format)}`, 2) end

  if type(record.version) ~= 'number' or record.version > Module.Version or record.version < 1 then
    error(`magick: scene version {tostring(record.version)} is not one this Magick reads (1..{Module.Version})`, 2)
  end

  local document = Module.new(field(record, 'width', 'number') :: number, field(record, 'height', 'number') :: number, {
    space = field(record, 'space', 'string') :: color.Space,
    seed = field(record, 'seed', 'number') :: number,
    background = if record.background ~= nil then field(record, 'background', 'string') :: string else nil,
  })
  local loading: Loading = { document = document, assets = {}, seen = {} }
  local pixels = 0

  for index, asset in (if record.assets ~= nil then field(record, 'assets', 'table') else {}) :: { { [string]: unknown } } do
    local width, height = field(asset, 'width', 'number') :: number, field(asset, 'height', 'number') :: number

    if width ~= math.floor(width) or height ~= math.floor(height) or width < 1 or height < 1 then error('magick: an asset needs a whole size', 2) end

    pixels += width * height
    if pixels > Module.MaxAssetPixels then error(`magick: MaxAssetPixels {Module.MaxAssetPixels} exceeded`, 2) end

    local data = bytes.fromBase64(field(asset, 'data', 'string') :: string)
    local format = field(asset, 'format', 'string')
    local size = width * height * (if format == 'premultiplied32' then 16 else 4)

    if buffer.len(data) ~= size then error(`magick: asset {index} holds {buffer.len(data)} bytes, not {size}`, 2) end
    if string.format('%08x', bytes.crc32(data)) ~= asset.crc32 then error(`magick: asset {index} does not match its checksum`, 2) end

    if format == 'premultiplied32' then
      local tile = color.tile(width, height, { space = field(asset, 'space', 'string') :: color.Space })

      buffer.copy(tile.data, 0, data)
      loading.assets[index] = tile
    else
      loading.assets[index] = magick.fromRGBA(width, height, data)
    end
  end

  local root = field(record, 'root', 'table') :: { [string]: unknown }

  for _, child in (if root.children ~= nil then field(root, 'children', 'table') else {}) :: { { [string]: unknown } } do
    document.root:add(loadNode(child, loading))
  end

  -- The root's own settings, as saved.
  local fields = field(root, 'transform', 'table') :: { number }

  document.root:set {
    transform = transform.matrix(fields[1], fields[2], fields[3], fields[4], fields[5], fields[6]),
    opacity = field(root, 'opacity', 'number') :: number,
    blend = field(root, 'blend', 'string') :: color.BlendMode,
  }

  return document
end

Module.Node = Node
Module.Document = Document

