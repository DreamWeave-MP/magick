--!strict
--[[
@magick/paint: what color geometry lays down (RFC-0001 section 9).

A paint is an immutable value: a solid color, a gradient or an image pattern, with an opacity. It is
evaluated a span at a time (a run of pixel centers along one row of a working tile) into a scratch
buffer of premultiplied values in the tile's space, with the paint's kind checked once per span and
never per pixel. One paint can fill any number of shapes and tiles; nothing about it changes, and
nothing the size of the canvas is ever made for it.

Every paint has a `transform` from paint space to device space (the identity by default); a
gradient's points and a pattern's pixels are in paint space, and a pixel center is taken back
through the inverse. Gradients interpolate premultiplied colors, in `srgb` (the default) or
`linear` light, between stops sorted by offset (stable, so a coincident pair makes a hard edge, the
later stop winning at the shared offset). Past their ends, `spread` pads, repeats or reflects.
]]
local color = require '@magick/color'
local magick = require '@magick'
local path = require '@magick/path'
local transform = require '@magick/transform'

type Matrix = transform.Matrix
type Tile = color.Tile

local Module = {}

export type Spread = 'pad' | 'repeat' | 'reflect'
export type Space = color.Space

--- A gradient stop: its offset in 0..1 and a legacy color.
export type Stop = { offset: number, color: magick.Color }

--- What the gradient constructors take besides their geometry.
export type GradientOptions = {
  spread: Spread?,
  --- The space stops are interpolated in.
  interpolation: Space?,
  transform: Matrix?,
  opacity: number?,
  --- Radial only: the focal point the gradient starts from, the center when left out.
  focusX: number?,
  focusY: number?,
}

--- How a pattern takes a pixel from its source: the nearest, or a premultiplied blend of four.
export type Sampling = 'nearest' | 'bilinear'

--- What a pattern reads past its source's edges: the edge pixel again, the source repeated, the
--- source mirrored, or nothing.
export type Edge = 'clamp' | 'repeat' | 'mirror' | 'transparent'

--- A pattern's source: a legacy image (`straight8`, straight sRGB RGBA8) or a working tile
--- (`premultiplied32`), read where it is when a fill reads it.
export type PatternSource = {
  width: number,
  height: number,
  data: buffer,
  format: 'straight8' | 'premultiplied32',
  space: Space,
}

--- What `pattern` takes.
export type PatternOptions = { transform: Matrix?, sampling: Sampling?, edge: Edge?, opacity: number? }

--- A paint. Its fields are read-only; `kind` says which of the rest it uses.
export type Paint = {
  kind: 'solid' | 'linear' | 'radial' | 'conic' | 'pattern',
  opacity: number,
  transform: Matrix,
  inverse: Matrix,
  --- Solid: its straight color, channels in 0..255.
  channels: { number },
  --- Gradients: stop offsets, and their straight channels in 0..1 in the interpolation space, four a stop.
  offsets: { number },
  colors: { number },
  spread: Spread,
  interpolation: Space,
  --- Gradient geometry, in paint space.
  geometry: { number },
  --- Pattern: what it reads, how it samples and what lies past its edges.
  source: PatternSource?,
  sampling: Sampling,
  edge: Edge,
}

--- How a fill composites: its operator and opacity, and how its path is covered.
export type FillOptions = {
  operator: color.Operator?,
  --- A W3C blend mode, `normal` by default; any other composites src-over.
  blend: color.BlendMode?,
  opacity: number?,
  fillRule: path.FillRule?,
  --- The path's transform, user space to device space.
  transform: Matrix?,
  tolerance: number?,
  clips: { path.Clip }?,
}

--- The empty list a paint holds where its kind has no channels, stops or geometry: frozen, like the
--- rest of a paint.
local Nothing: { number } = table.freeze({} :: { number })

--- The most stops a gradient has.
Module.MaxStops = 256

local function finite(value: number): boolean
  return value == value and value > -math.huge and value < math.huge
end

local function checkKeys(options: unknown, known: { [string]: boolean }, level: number)
  if options == nil then return end

  for name in options :: { [string]: unknown } do
    if not known[name] then error(`magick: unknown option {name}`, level + 1) end
  end
end

local function checkOpacity(opacity: number?, level: number): number
  local value = opacity or 1

  if not finite(value) or value < 0 or value > 1 then error('magick: opacity must be in 0..1', level + 1) end

  return value
end

local function checkMatrix(matrix: Matrix?, level: number): (Matrix, Matrix)
  local chosen = matrix or transform.identity()

  transform.check(chosen)
  if transform.isSingular(chosen) then error('magick: transform is singular', level + 1) end

  return chosen, transform.inverse(chosen)
end

--- A paint of one color everywhere.
function Module.solid(fill: magick.Color, options: { opacity: number? }?): Paint
  checkKeys(options, { opacity = true }, 2)

  local channels = magick.color(fill)

  for index = 1, 4 do
    if not finite(channels[index]) then error('magick: color channels must be finite', 2) end

    channels[index] = math.floor(math.clamp(channels[index], 0, 255) + 0.5)
  end

  local identity = transform.identity()

  return table.freeze {
    kind = 'solid',
    opacity = checkOpacity(if options then options.opacity else nil, 2),
    transform = identity,
    inverse = identity,
    channels = table.freeze(channels),
    offsets = Nothing,
    colors = Nothing,
    spread = 'pad',
    interpolation = 'srgb',
    geometry = Nothing,
    sampling = 'nearest',
    edge = 'clamp',
  } :: Paint
end

--- Stops from offsets and colors by turns: `stops(0, '#000', 1, '#fff')`.
function Module.stops(...: number | magick.Color): { Stop }
  local count = select('#', ...)

  if count % 2 ~= 0 then error('magick: stops come in pairs of an offset and a color', 2) end

  local out = table.create(count // 2) :: { Stop }

  for index = 1, count, 2 do
    local offset = select(index, ...)

    if type(offset) ~= 'number' then error('magick: stops come in pairs of an offset and a color', 2) end

    table.insert(out, { offset = offset, color = (select(index + 1, ...)) :: magick.Color })
  end

  return out
end

local GradientKeys = { spread = true, interpolation = true, transform = true, opacity = true, focusX = true, focusY = true }

--- Checks and sorts stops, stably, into offsets and straight channels in 0..1 of a space.
local function prepareStops(stops: { Stop }, interpolation: Space): ({ number }, { number })
  if #stops == 0 then error('magick: a gradient needs at least one stop', 4) end
  if #stops > Module.MaxStops then error(`magick: MaxStops {Module.MaxStops} exceeded`, 4) end

  local order = table.create(#stops) :: { number }

  for index, stop in stops do
    local offset = stop.offset

    if type(offset) ~= 'number' or not finite(offset) or offset < 0 or offset > 1 then
      error('magick: stop offsets must be numbers in 0..1', 4)
    end

    order[index] = index
  end

  table.sort(order, function(first: number, second: number): boolean
    local firstOffset, secondOffset = stops[first].offset, stops[second].offset

    if firstOffset ~= secondOffset then return firstOffset < secondOffset end

    return first < second
  end)

  local offsets, colors = table.create(#stops) :: { number }, table.create(#stops * 4) :: { number }

  for position, index in order do
    local channels = magick.color(stops[index].color)

    offsets[position] = stops[index].offset

    for channel = 1, 4 do
      if not finite(channels[channel]) then error('magick: color channels must be finite', 4) end

      local byte = math.floor(math.clamp(channels[channel], 0, 255) + 0.5)

      colors[(position - 1) * 4 + channel] = if channel < 4 and interpolation == 'linear' then color.decode(byte / 255) else byte / 255
    end
  end

  return offsets, colors
end

local function gradient(
  kind: 'linear' | 'radial' | 'conic',
  geometry: { number },
  stops: { Stop },
  options: GradientOptions?
): Paint
  checkKeys(options, GradientKeys, 3)

  for _, value in geometry do
    if not finite(value) then error('magick: gradient geometry must be finite', 3) end
  end

  local spread = if options then options.spread or 'pad' else 'pad'

  if spread ~= 'pad' and spread ~= 'repeat' and spread ~= 'reflect' then error(`magick: unknown spread {spread}`, 3) end

  local interpolation = if options then options.interpolation or 'srgb' else 'srgb'

  if interpolation ~= 'srgb' and interpolation ~= 'linear' then error(`magick: unknown color space {interpolation}`, 3) end

  local matrix, inverse = checkMatrix(if options then options.transform else nil, 3)
  local offsets, colors = prepareStops(stops, interpolation)

  return table.freeze {
    kind = kind,
    opacity = checkOpacity(if options then options.opacity else nil, 3),
    transform = matrix,
    inverse = inverse,
    channels = Nothing,
    offsets = table.freeze(offsets),
    colors = table.freeze(colors),
    spread = spread,
    interpolation = interpolation,
    geometry = table.freeze(geometry),
    sampling = 'nearest',
    edge = 'clamp',
  } :: Paint
end

--- A linear gradient from (`x0`, `y0`), where the offset is 0, to (`x1`, `y1`), where it is 1,
--- constant across. A gradient of no length is its last stop's color everywhere.
function Module.linear(x0: number, y0: number, x1: number, y1: number, stops: { Stop }, options: GradientOptions?): Paint
  if options and (options.focusX or options.focusY) then error('magick: only a radial gradient has a focus', 2) end

  return gradient('linear', { x0, y0, x1, y1 }, stops, options)
end

--- A radial gradient: offset 0 at the focus (the center unless given) and 1 on the circle of
--- `radius` about the center. A focus on or outside the circle is drawn in to 0.999 of the
--- radius, as SVG 1.1 does. A radius of 0 is the last stop's color everywhere.
function Module.radial(centerX: number, centerY: number, radius: number, stops: { Stop }, options: GradientOptions?): Paint
  if not finite(radius) or radius < 0 then error('magick: radius must be finite and not negative', 2) end

  local focusX, focusY = centerX, centerY

  if options then
    focusX, focusY = options.focusX or centerX, options.focusY or centerY
  end

  local awayX, awayY = focusX - centerX, focusY - centerY
  local away = math.sqrt(awayX * awayX + awayY * awayY)

  if radius > 0 and away >= radius * 0.999 then
    focusX, focusY = centerX + awayX / away * radius * 0.999, centerY + awayY / away * radius * 0.999
  end

  return gradient('radial', { centerX, centerY, radius, focusX, focusY }, stops, options)
end

--- A conic (angular) gradient about a center: offset 0 on the seam at `startAngle` radians from +x
--- (0 by default) and rising clockwise on screen, since y grows down, to 1 a whole turn on, where it
--- meets the seam again. The parameter is always in 0..1, so every spread gives the same paint.
--- Turn it the other way with a reflecting transform.
function Module.conic(centerX: number, centerY: number, stops: { Stop }, options: (GradientOptions & { startAngle: number? })?): Paint
  local startAngle = 0
  local rest: GradientOptions? = nil

  if options then
    startAngle = options.startAngle or 0

    local copy = table.clone(options) :: { [string]: unknown }

    copy.startAngle = nil
    rest = copy :: GradientOptions

    if options.focusX or options.focusY then error('magick: only a radial gradient has a focus', 2) end
  end

  return gradient('conic', { centerX, centerY, startAngle }, stops, rest)
end

local PatternKeys = { transform = true, sampling = true, edge = true, opacity = true }

--- A paint of an image or a working tile, its pixels laid out in paint space from the origin, each
--- the unit square it covers, so with the identity a source pixel lands on the device pixel of the
--- same place, and repeated it aligns as a legacy tiled `Image` source does. The source is read
--- where it is whenever a fill reads it: nothing is copied, and a fill into the very tile or image a
--- pattern reads is refused.
function Module.pattern(source: magick.Image | Tile, options: PatternOptions?): Paint
  checkKeys(options, PatternKeys, 2)

  local sampling: Sampling = if options then options.sampling or 'nearest' else 'nearest'
  local edge: Edge = if options then options.edge or 'clamp' else 'clamp'

  if sampling ~= 'nearest' and sampling ~= 'bilinear' then error(`magick: unknown sampling {sampling}`, 2) end
  if edge ~= 'clamp' and edge ~= 'repeat' and edge ~= 'mirror' and edge ~= 'transparent' then error(`magick: unknown edge {edge}`, 2) end

  local fields = source :: { [string]: unknown }
  local described: PatternSource

  if type(fields.space) == 'string' then
    local tile = source :: Tile

    described = { width = tile.width, height = tile.height, data = tile.data, format = 'premultiplied32', space = tile.space }
  else
    local image = source :: magick.Image

    described = { width = image.width, height = image.height, data = image.data, format = 'straight8', space = 'srgb' }
  end

  if described.width <= 0 or described.height <= 0 then error('magick: a pattern needs a source with pixels', 2) end

  local matrix, inverse = checkMatrix(if options then options.transform else nil, 2)

  table.freeze((described :: unknown) :: { [string]: unknown })

  return table.freeze {
    kind = 'pattern',
    opacity = checkOpacity(if options then options.opacity else nil, 2),
    transform = matrix,
    inverse = inverse,
    channels = Nothing,
    offsets = Nothing,
    colors = Nothing,
    spread = 'pad',
    interpolation = 'srgb',
    geometry = Nothing,
    source = described,
    sampling = sampling,
    edge = edge,
  } :: Paint
end

--- The same paint drawn where `matrix` puts it: its transform becomes `matrix` o its own, so a paint
--- given in a shape's user space follows the shape. A solid is returned as it is.
function Module.moved(value: Paint, matrix: Matrix): Paint
  if value.kind == 'solid' then return value end

  local combined, inverse = checkMatrix(transform.multiply(matrix, value.transform), 2)
  local copy = table.clone(value) :: { [string]: unknown }

  copy.transform = combined
  copy.inverse = inverse

  return table.freeze(copy) :: Paint
end

--- A paint as plain data, for saving: its kind, opacity, transform (SVG's six numbers), and what
--- the kind needs. Gradient stops come back as the `#rrggbbaa` bytes they were made from. A
--- pattern's source is named by `asset`, a number `assetOf` gives it, since its pixels are saved apart.
export type Description = {
  kind: string,
  opacity: number,
  transform: { number },
  color: string?,
  stops: { { offset: number, color: string } }?,
  geometry: { number }?,
  spread: string?,
  interpolation: string?,
  sampling: string?,
  edge: string?,
  asset: number?,
}

local function hexByte(value: number): string
  return string.format('%02x', math.floor(math.clamp(value, 0, 255) + 0.5))
end

function Module.describe(value: Paint, assetOf: ((source: PatternSource) -> number)?): Description
  local matrix = value.transform
  local out: Description = {
    kind = value.kind,
    opacity = value.opacity,
    transform = { matrix.scaleX, matrix.skewY, matrix.skewX, matrix.scaleY, matrix.offsetX, matrix.offsetY },
  }

  if value.kind == 'solid' then
    local channels = value.channels

    out.color = `#{hexByte(channels[1])}{hexByte(channels[2])}{hexByte(channels[3])}{hexByte(channels[4])}`
  elseif value.kind == 'pattern' then
    if not assetOf then error('magick: describing a pattern needs somewhere to put its source', 2) end

    out.asset = assetOf(value.source :: PatternSource)
    out.sampling = value.sampling
    out.edge = value.edge
  else
    local stops = {}

    for index, offset in value.offsets do
      local at = (index - 1) * 4
      local function byte(channel: number): string
        local stored = value.colors[at + channel]

        if channel < 4 and value.interpolation == 'linear' then stored = color.encode(stored) end

        return hexByte(stored * 255)
      end

      table.insert(stops, { offset = offset, color = `#{byte(1)}{byte(2)}{byte(3)}{byte(4)}` })
    end

    out.stops = stops
    out.geometry = table.clone(value.geometry)
    out.spread = value.spread
    out.interpolation = value.interpolation
  end

  return out
end

--- A paint from `describe`'s data, checked as every constructor checks its arguments. `sourceOf`
--- turns an asset number back into the image or tile it named.
function Module.fromDescription(description: Description, sourceOf: ((asset: number) -> magick.Image | Tile)?): Paint
  local fields = description.transform

  if type(fields) ~= 'table' or #fields ~= 6 then error('magick: a paint transform is six numbers', 2) end

  local matrix = transform.matrix(fields[1], fields[2], fields[3], fields[4], fields[5], fields[6])
  local opacity = description.opacity

  if description.kind == 'solid' then return Module.solid(description.color :: string, { opacity = opacity }) end

  if description.kind == 'pattern' then
    if not sourceOf or type(description.asset) ~= 'number' then error('magick: a pattern needs its source asset', 2) end

    return Module.pattern(sourceOf(description.asset :: number), {
      transform = matrix,
      opacity = opacity,
      sampling = description.sampling :: Sampling,
      edge = description.edge :: Edge,
    })
  end

  local geometry = description.geometry

  if type(geometry) ~= 'table' then error('magick: a gradient needs its geometry', 2) end

  local options: GradientOptions = {
    spread = description.spread :: Spread,
    interpolation = description.interpolation :: Space,
    transform = matrix,
    opacity = opacity,
  }
  local stops: { Stop } = {}

  for _, stop in description.stops or {} do
    table.insert(stops, { offset = stop.offset, color = stop.color :: magick.Color })
  end

  if description.kind == 'linear' then
    if #geometry ~= 4 then error('magick: a linear gradient has four numbers of geometry', 2) end

    return Module.linear(geometry[1], geometry[2], geometry[3], geometry[4], stops, options)
  end

  if description.kind == 'radial' then
    if #geometry ~= 5 then error('magick: a radial gradient has five numbers of geometry', 2) end

    options.focusX, options.focusY = geometry[4], geometry[5]

    return Module.radial(geometry[1], geometry[2], geometry[3], stops, options)
  end

  if description.kind == 'conic' then
    if #geometry ~= 3 then error('magick: a conic gradient has three numbers of geometry', 2) end

    local conicOptions = options :: GradientOptions & { startAngle: number? }

    conicOptions.startAngle = geometry[3]

    return Module.conic(geometry[1], geometry[2], stops, conicOptions)
  end

  error(`magick: unknown paint kind {description.kind}`, 2)
end

--- `t` brought into 0..1 by a spread.
local function spreadOf(spread: Spread, along: number): number
  if spread == 'repeat' then return along - math.floor(along) end

  if spread == 'reflect' then
    local folded = along % 2

    return if folded > 1 then 2 - folded else folded
  end

  return math.clamp(along, 0, 1)
end

Module.spreadOf = spreadOf

--- Writes the premultiplied color of a gradient at `along` (already spread into 0..1) into `out`
--- at `at`, in the target space. Between two stops the straight colors are premultiplied by their
--- own alphas, mixed, and their alpha mixed (RFC-0001 M9); at a shared offset the later stop wins.
@native
local function stopColor(paint: Paint, along: number, target: Space, opacity: number, out: buffer, at: number)
  local offsets, colors = paint.offsets, paint.colors
  local count = #offsets
  local upper = 1

  while upper <= count and offsets[upper] <= along do
    upper += 1
  end

  local red, green, blue, alpha

  if upper == 1 or upper > count then
    -- Before the first stop, or at or past the last: that stop's color.
    local index = if upper == 1 then 0 else (count - 1) * 4

    alpha = colors[index + 4]
    red, green, blue = colors[index + 1] * alpha, colors[index + 2] * alpha, colors[index + 3] * alpha
  else
    local lower = upper - 1
    local span = offsets[upper] - offsets[lower]
    local weight = if span > 0 then (along - offsets[lower]) / span else 1
    local from, to = (lower - 1) * 4, (upper - 1) * 4
    local fromAlpha, toAlpha = colors[from + 4], colors[to + 4]

    alpha = fromAlpha + (toAlpha - fromAlpha) * weight
    red = colors[from + 1] * fromAlpha + (colors[to + 1] * toAlpha - colors[from + 1] * fromAlpha) * weight
    green = colors[from + 2] * fromAlpha + (colors[to + 2] * toAlpha - colors[from + 2] * fromAlpha) * weight
    blue = colors[from + 3] * fromAlpha + (colors[to + 3] * toAlpha - colors[from + 3] * fromAlpha) * weight
  end

  if target ~= paint.interpolation and alpha > 0 then
    local transfer = if target == 'linear' then color.decode else color.encode

    red = transfer(math.clamp(red / alpha, 0, 1)) * alpha
    green = transfer(math.clamp(green / alpha, 0, 1)) * alpha
    blue = transfer(math.clamp(blue / alpha, 0, 1)) * alpha
  end

  buffer.writef64(out, at, red * opacity)
  buffer.writef64(out, at + 8, green * opacity)
  buffer.writef64(out, at + 16, blue * opacity)
  buffer.writef64(out, at + 24, alpha * opacity)
end

--- The gradient parameter at a paint-space point, before spread; nil where it is degenerate and
--- takes the last stop.
local function parameter(paint: Paint, pointX: number, pointY: number): number?
  local geometry = paint.geometry

  if paint.kind == 'linear' then
    local deltaX, deltaY = geometry[3] - geometry[1], geometry[4] - geometry[2]
    local length = deltaX * deltaX + deltaY * deltaY

    if length == 0 then return nil end

    return ((pointX - geometry[1]) * deltaX + (pointY - geometry[2]) * deltaY) / length
  end

  if paint.kind == 'conic' then
    local turn = (math.atan2(pointY - geometry[2], pointX - geometry[1]) - geometry[3]) / (2 * math.pi)

    return turn - math.floor(turn)
  end

  -- Radial: the point is `focus + t * (edge - focus)` for the edge on the circle along the ray
  -- from the focus, so t solves |w + u / t| = r with u = point - focus and w = focus - center.
  local radius = geometry[3]

  if radius == 0 then return nil end

  local towardX, towardY = pointX - geometry[4], pointY - geometry[5]
  local offsetX, offsetY = geometry[4] - geometry[1], geometry[5] - geometry[2]
  local reach = towardX * towardX + towardY * towardY

  if reach == 0 then return 0 end

  local dot = offsetX * towardX + offsetY * towardY
  local inside = radius * radius - offsetX * offsetX - offsetY * offsetY
  local inverse = (-dot + math.sqrt(dot * dot + reach * inside)) / reach

  return 1 / inverse
end

--- A source index brought inside `0..size - 1` by an edge rule; nil past a transparent edge.
local function edgeIndex(edge: Edge, index: number, size: number): number?
  if index >= 0 and index < size then return index end
  if edge == 'clamp' then return math.clamp(index, 0, size - 1) end
  if edge == 'repeat' then return index % size end

  if edge == 'mirror' then
    local folded = index % (2 * size)

    return if folded >= size then 2 * size - 1 - folded else folded
  end

  return nil
end

--- One source pixel, premultiplied in the target space: red, green, blue, alpha.
@native
local function texel(source: PatternSource, edge: Edge, linear: boolean, column: number, row: number): (number, number, number, number)
  local inside, down = edgeIndex(edge, column, source.width), edgeIndex(edge, row, source.height)

  if not inside or not down then return 0, 0, 0, 0 end

  local data = source.data

  if source.format == 'premultiplied32' then
    local at = (down * source.width + inside) * 16

    return buffer.readf32(data, at), buffer.readf32(data, at + 4), buffer.readf32(data, at + 8), buffer.readf32(data, at + 12)
  end

  local at = (down * source.width + inside) * 4
  local alphaByte = buffer.readu8(data, at + 3)

  if alphaByte == 0 then return 0, 0, 0, 0 end

  local alpha = alphaByte / 255
  local red, green, blue = buffer.readu8(data, at), buffer.readu8(data, at + 1), buffer.readu8(data, at + 2)

  if linear then
    local table = color.linearBytes

    return table[red + 1] * alpha, table[green + 1] * alpha, table[blue + 1] * alpha, alpha
  end

  return red / 255 * alpha, green / 255 * alpha, blue / 255 * alpha, alpha
end

--- A pattern's span: each pixel center taken back to paint space and read from the source, the
--- nearest pixel or a blend of the four around it, weighted on premultiplied values so a
--- transparent neighbour lends no color.
@native
local function patternSpan(paint: Paint, tile: Tile, row: number, first: number, count: number, out: buffer, scale: number)
  local source = paint.source :: PatternSource
  local inverse = paint.inverse
  local centerY = tile.top + row + 0.5
  local linear = tile.space == 'linear'
  local edge = paint.edge

  if source.format == 'premultiplied32' and source.space ~= tile.space then
    error('magick: a pattern tile must be in the space of the tile it fills', 3)
  end

  for index = 0, count - 1 do
    local centerX = tile.left + first + index + 0.5
    local pointX = inverse.scaleX * centerX + inverse.skewX * centerY + inverse.offsetX
    local pointY = inverse.skewY * centerX + inverse.scaleY * centerY + inverse.offsetY
    local red, green, blue, alpha

    if paint.sampling == 'nearest' then
      red, green, blue, alpha = texel(source, edge, linear, math.floor(pointX), math.floor(pointY))
    else
      local across, down = pointX - 0.5, pointY - 0.5
      local column, line = math.floor(across), math.floor(down)
      local right, lower = across - column, down - line
      local topLeftRed, topLeftGreen, topLeftBlue, topLeftAlpha = texel(source, edge, linear, column, line)
      local topRightRed, topRightGreen, topRightBlue, topRightAlpha = texel(source, edge, linear, column + 1, line)
      local bottomLeftRed, bottomLeftGreen, bottomLeftBlue, bottomLeftAlpha = texel(source, edge, linear, column, line + 1)
      local bottomRightRed, bottomRightGreen, bottomRightBlue, bottomRightAlpha = texel(source, edge, linear, column + 1, line + 1)
      local topLeft, topRight = (1 - right) * (1 - lower), right * (1 - lower)
      local bottomLeft, bottomRight = (1 - right) * lower, right * lower

      red = topLeftRed * topLeft + topRightRed * topRight + bottomLeftRed * bottomLeft + bottomRightRed * bottomRight
      green = topLeftGreen * topLeft + topRightGreen * topRight + bottomLeftGreen * bottomLeft + bottomRightGreen * bottomRight
      blue = topLeftBlue * topLeft + topRightBlue * topRight + bottomLeftBlue * bottomLeft + bottomRightBlue * bottomRight
      alpha = topLeftAlpha * topLeft + topRightAlpha * topRight + bottomLeftAlpha * bottomLeft + bottomRightAlpha * bottomRight
    end

    local at = index * 32

    buffer.writef64(out, at, red * scale)
    buffer.writef64(out, at + 8, green * scale)
    buffer.writef64(out, at + 16, blue * scale)
    buffer.writef64(out, at + 24, alpha * scale)
  end
end

--- A gradient's span: each pixel center taken back to paint space, its parameter spread, and the
--- stops' color there. A linear gradient's parameter is worked out inline, with the same arithmetic.
@native
local function gradientSpan(paint: Paint, tile: Tile, row: number, first: number, count: number, out: buffer, scale: number)
  local inverse = paint.inverse
  local centerY = tile.top + row + 0.5
  local lastOffset = #paint.offsets
  local geometry = paint.geometry
  local linear = paint.kind == 'linear'
  local deltaX, deltaY, length = 0, 0, 0

  if linear then
    deltaX, deltaY = geometry[3] - geometry[1], geometry[4] - geometry[2]
    length = deltaX * deltaX + deltaY * deltaY
  end

  for index = 0, count - 1 do
    local centerX = tile.left + first + index + 0.5
    local pointX = inverse.scaleX * centerX + inverse.skewX * centerY + inverse.offsetX
    local pointY = inverse.skewY * centerX + inverse.scaleY * centerY + inverse.offsetY
    local along: number?

    if linear then
      along = if length == 0 then nil else ((pointX - geometry[1]) * deltaX + (pointY - geometry[2]) * deltaY) / length
    else
      along = parameter(paint, pointX, pointY)
    end

    local spread = if along then spreadOf(paint.spread, along) else paint.offsets[lastOffset]

    stopColor(paint, spread, tile.space, scale, out, index * 32)
  end
end

--- Evaluates `count` pixel centers of a row of a tile, from tile column `first`, into `out` as
--- premultiplied f64 values in the tile's space, four a pixel, times the paint's opacity and
--- `opacity`.
function Module.span(paint: Paint, tile: Tile, row: number, first: number, count: number, out: buffer, opacity: number?)
  local scale = paint.opacity * (opacity or 1)

  if paint.kind == 'solid' then
    local red, green, blue, alpha = color.premultiplied(paint.channels, tile.space)

    red, green, blue, alpha = red * scale, green * scale, blue * scale, alpha * scale

    for index = 0, count - 1 do
      local at = index * 32

      buffer.writef64(out, at, red)
      buffer.writef64(out, at + 8, green)
      buffer.writef64(out, at + 16, blue)
      buffer.writef64(out, at + 24, alpha)
    end

    return
  end

  if paint.kind == 'pattern' then
    patternSpan(paint, tile, row, first, count, out, scale)

    return
  end

  gradientSpan(paint, tile, row, first, count, out, scale)
end

local FillKeys = { operator = true, blend = true, opacity = true, fillRule = true, transform = true, tolerance = true, clips = true }

--- A fill's operator, blend mode and opacity, checked.
local function settings(options: FillOptions?): (color.Operator, color.BlendMode, number)
  local operator: color.Operator = 'src-over'

  if options and options.operator then operator = options.operator end

  color.factors(operator, 0, 0)

  local mode = color.checkBlend(if options and options.blend then options.blend else 'normal')

  if mode ~= 'normal' and operator ~= 'src-over' then error('magick: blend modes composite with src-over only', 3) end

  return operator, mode, checkOpacity(if options then options.opacity else nil, 3)
end

--- Composites one row's covered run: the source at each pixel is the scratch span's value (or, with
--- `solid`, the four constants), its alpha scaled by the coverage; `fa = first + byBackdrop *
--- backdropAlpha` and `fb = second + bySource * sourceAlpha`.
@native
local function composeRow(
  data: buffer,
  dataBase: number,
  coverage: buffer,
  base: number,
  from: number,
  to: number,
  scratch: buffer,
  solid: { number }?,
  first: number,
  byBackdrop: number,
  second: number,
  bySource: number
)
  local red, green, blue, alpha = 0, 0, 0, 0

  if solid then red, green, blue, alpha = solid[1], solid[2], solid[3], solid[4] end

  for column = from, to do
    local covered = buffer.readu8(coverage, base + column)
    local weight = covered / 255
    local at = (dataBase + column) * 16

    if not solid then
      local span = (column - from) * 32

      red, green, blue = buffer.readf64(scratch, span), buffer.readf64(scratch, span + 8), (buffer.readf64(scratch, span + 16))
      alpha = buffer.readf64(scratch, span + 24)
    end

    local sourceAlpha = alpha * weight
    local backdropAlpha = buffer.readf32(data, at + 12)
    local fa, fb = first + byBackdrop * backdropAlpha, second + bySource * sourceAlpha
    local outAlpha = math.clamp(sourceAlpha * fa + backdropAlpha * fb, 0, 1)
    local scale = weight * fa

    buffer.writef32(data, at, math.clamp(red * scale + buffer.readf32(data, at) * fb, 0, outAlpha))
    buffer.writef32(data, at + 4, math.clamp(green * scale + buffer.readf32(data, at + 4) * fb, 0, outAlpha))
    buffer.writef32(data, at + 8, math.clamp(blue * scale + buffer.readf32(data, at + 8) * fb, 0, outAlpha))
    buffer.writef32(data, at + 12, outAlpha)
  end
end

--- Composites one row's run by a blend mode, src-over: the span's premultiplied source scaled by
--- the coverage, mixed with the backdrop by `color.mixPixel`.
local function blendRow(
  data: buffer,
  dataBase: number,
  coverage: buffer,
  base: number,
  from: number,
  to: number,
  scratch: buffer,
  mode: color.BlendMode
)
  for column = from, to do
    local weight = buffer.readu8(coverage, base + column) / 255

    if weight == 0 then continue end

    local span, at = (column - from) * 32, (dataBase + column) * 16
    local red, green, blue, alpha = color.mixPixel(
      mode,
      buffer.readf64(scratch, span) * weight,
      buffer.readf64(scratch, span + 8) * weight,
      buffer.readf64(scratch, span + 16) * weight,
      buffer.readf64(scratch, span + 24) * weight,
      buffer.readf32(data, at),
      buffer.readf32(data, at + 4),
      buffer.readf32(data, at + 8),
      buffer.readf32(data, at + 12)
    )

    alpha = math.clamp(alpha, 0, 1)
    buffer.writef32(data, at, math.clamp(red, 0, alpha))
    buffer.writef32(data, at + 4, math.clamp(green, 0, alpha))
    buffer.writef32(data, at + 8, math.clamp(blue, 0, alpha))
    buffer.writef32(data, at + 12, alpha)
  end
end

--- Composites a paint through coverage bytes over a tile: the paint at each pixel, its alpha scaled
--- by the coverage, by an operator. Where coverage is 0 the source is transparent, so an operator
--- that clears under transparency clears there.
--- Whether an operator and blend leave the backdrop alone under a transparent source, so only the
--- covered pixels need visiting.
local function bounded(operator: color.Operator, mode: color.BlendMode): boolean
  local _, second = color.factors(operator, 0, 0)
  local _, secondAtOne = color.factors(operator, 1, 1)

  return mode ~= 'normal' or (second == 1 and secondAtOne <= second)
end

--- `window` is where the coverage lies in the tile: its left, top, width and height in tile pixels,
--- the whole tile when left out.
local function paintThrough(
  tile: Tile,
  coverage: buffer,
  value: Paint,
  operator: color.Operator,
  mode: color.BlendMode,
  opacity: number,
  window: { number }?
)
  local source = value.source

  if source and source.data == tile.data then error('magick: pattern reads its own destination', 3) end

  -- The operator's factors are linear in the alphas: read their coefficients off two corners.
  local first, second = color.factors(operator, 0, 0)
  local firstAtOne, secondAtOne = color.factors(operator, 1, 1)
  local byBackdrop, bySource = firstAtOne - first, secondAtOne - second
  local blending = mode ~= 'normal'
  local scratch = buffer.create(if value.kind == 'solid' and not blending then 0 else tile.width * 32)
  local solid: { number }? = nil

  if value.kind == 'solid' and not blending then
    local red, green, blue, alpha = color.premultiplied(value.channels, tile.space)
    local scale = value.opacity * opacity

    solid = { red * scale, green * scale, blue * scale, alpha * scale }
  end

  -- Operators that leave the backdrop under a transparent source need only the covered run.
  local skipsClear = blending or (second == 1 and bySource <= 0)

  local windowLeft, windowTop, windowWidth, windowHeight = 0, 0, tile.width, tile.height

  if window then windowLeft, windowTop, windowWidth, windowHeight = window[1], window[2], window[3], window[4] end

  for line = 0, windowHeight - 1 do
    local row = windowTop + line
    local base, dataBase = line * windowWidth, row * tile.width + windowLeft
    local from, to = 0, windowWidth - 1

    if skipsClear then
      while from <= to and buffer.readu8(coverage, base + from) == 0 do
        from += 1
      end

      while to >= from and buffer.readu8(coverage, base + to) == 0 do
        to -= 1
      end

      if from > to then continue end
    end

    if not solid then Module.span(value, tile, row, windowLeft + from, to - from + 1, scratch, opacity) end

    if blending then
      blendRow(tile.data, dataBase, coverage, base, from, to, scratch, mode)
      continue
    end

    composeRow(tile.data, dataBase, coverage, base, from, to, scratch, solid, first, byBackdrop, second, bySource)
  end
end

local PreparedKeys = { operator = true, blend = true, opacity = true, fillRule = true, clips = true }

--- Fills an outline already flattened and sorted by `path.prepare` (in device space) on a tile, as
--- `fillPath` does; for code that fills one outline into many tiles. `transform` and `tolerance`
--- were the prepare's, so they are not options here.
function Module.fillPrepared(tile: Tile, prepared: path.Prepared, value: Paint, options: FillOptions?): Tile
  checkKeys(options, PreparedKeys, 2)

  local operator, mode, opacity = settings(options)
  local rule: path.FillRule = if options and options.fillRule then options.fillRule else 'nonzero'
  local clips = if options then options.clips else nil
  local window = { 0, 0, tile.width, tile.height }

  -- Where the operator leaves the backdrop alone outside the coverage, only the path's box is
  -- covered and visited, so a small shape on a large tile costs its own size.
  if bounded(operator, mode) then
    local left = math.max(tile.left, math.floor(prepared.left))
    local top = math.max(tile.top, math.floor(prepared.top))
    local right = math.min(tile.left + tile.width, math.ceil(prepared.right))
    local bottom = math.min(tile.top + tile.height, math.ceil(prepared.bottom))

    if prepared.count == 0 or right <= left or bottom <= top then return tile end

    window = { left - tile.left, top - tile.top, right - left, bottom - top }
  end

  local coverage = path.coverOf(prepared, rule, tile.left + window[1], tile.top + window[2], window[3], window[4], clips)

  paintThrough(tile, coverage.data, value, operator, mode, opacity, window)

  return tile
end

--- Fills a path on a working tile with a paint: the path is covered over the tile's window, exactly
--- by its fill rule, and the paint composited through that coverage. Returns the tile.
function Module.fillPath(tile: Tile, shape: path.Path, value: Paint, options: FillOptions?): Tile
  checkKeys(options, FillKeys, 2)

  local prepared = path.prepare(shape, {
    transform = if options then options.transform else nil,
    tolerance = if options then options.tolerance else nil,
  })

  return Module.fillPrepared(tile, prepared, value, {
    operator = if options then options.operator else nil,
    blend = if options then options.blend else nil,
    opacity = if options then options.opacity else nil,
    fillRule = if options then options.fillRule else nil,
    clips = if options then options.clips else nil,
  })
end

--- Composites a paint over a whole tile, or through a coverage mask placed at (`left`, `top`) in
--- device space (outside the mask nothing is covered). Returns the tile.
function Module.fillMask(tile: Tile, value: Paint, mask: magick.Mask?, left: number?, top: number?, options: FillOptions?): Tile
  checkKeys(options, { operator = true, blend = true, opacity = true }, 2)

  local operator, mode, opacity = settings(options)
  local coverage = buffer.create(tile.width * tile.height)

  if not mask then
    buffer.fill(coverage, 0, 255)
  else
    local maskLeft, maskTop = (left or 0) - tile.left, (top or 0) - tile.top

    for row = math.max(0, maskTop), math.min(tile.height, maskTop + mask.height) - 1 do
      local fromX, toX = math.max(0, maskLeft), math.min(tile.width, maskLeft + mask.width)

      if toX > fromX then
        buffer.copy(coverage, row * tile.width + fromX, mask.data, (row - maskTop) * mask.width + fromX - maskLeft, toX - fromX)
      end
    end
  end

  paintThrough(tile, coverage, value, operator, mode, opacity)

  return tile
end

return Module
