--!strict
--[[
@magick/path: shapes as outlines, filled with anti-aliased coverage.

A path is a list of closed contours in image coordinates (pixels, y down, a pixel's square
running from its corner to the next). Lines go in as they are; quadratic and cubic curves are
flattened as they are added, to within the path's tolerance. Filling a path gives a mask of
coverage over the path's bounds, where each byte is how much of its pixel the shape covers,
worked out exactly for the flattened outline rather than sampled.

Coverage is the winding the contours add up to, clamped to whole: contours that wind the same
way add up and overlap without a seam, and a contour that winds the other way cuts a hole in
them. Every shape this module builds (rectangles, ellipses, strokes) winds the way a TrueType
glyph's outer contour does once it is turned the right way up, so shapes and glyphs drawn into
one path join; `ring` and `frame` wind their inner contour the other way, and are holes.

The coverage is accumulated as signed areas a row at a time, the technique Raph Levien's
font-rs (MIT OR Apache-2.0) describes; this is a separate implementation of it.

Since 0.2.0 a path also keeps what it was drawn with (RFC-0001 P1): each closed contour carries its
commands (points, quadratic and cubic curves, elliptical arcs) and the matrix it has been moved by.
`contours` stays what 0.1.3 made, the contours flattened at the path's tolerance, so every 0.1.x
call reads the points it always did. `transformBy`, `flatten`, `deviceBounds` and `coverageIn`
flatten the commands again under their matrix, to a tolerance in device pixels, so a curve drawn
small and shown large is as smooth as one drawn large.
]]
local magick = require '@magick'
local raster = require './raster'
local transform = require '@magick/transform'

type Matrix = transform.Matrix

local Path = {}
Path.__index = Path

--- What a contour was drawn with: a flat list of commands, each an opcode and its numbers.
--- `Point x y` adds a point; `Quad cx cy x y` and `Cubic ax ay bx by x y` a curve from the last
--- point; `Arc cx cy rx ry from to` the points of an arc, its first included; `Ellipse cx cy rx ry`
--- a whole ellipse.
type Retained = {
  commands: { number },
  --- Where the commands have been moved to; nil where they are as drawn.
  matrix: Matrix?,
  --- Whether the flattened points are taken in the other order, as `wound` turns a shape.
  reverse: boolean,
  --- Whether the contour was closed on purpose, so a stroke joins its ends. One ended by a move, or
  --- by rasterizing, is open to a stroke and closed to a fill, as in SVG.
  closed: boolean,
}

type Outline = {
  --- Each contour's points as x, y pairs in one flat list.
  contours: { { number } },
  --- The commands each of `contours` was flattened from, one for one.
  retained: { Retained },
  --- Subpaths of two points, which enclose nothing: kept for strokes, never filled.
  lines: { Retained },
  --- The contour lines and curves are being added to, until the next move or close.
  open: { number }?,
  --- The commands of the open contour.
  drawing: { number }?,
  --- The farthest a flattened curve strays from the curve, in pixels.
  tolerance: number,
}

--- Closed contours, and the open one being drawn.
export type Path = typeof(setmetatable({} :: Outline, Path))

--- How a line's ends are drawn: flush with them, as half circles past them, or as half squares
--- past them.
export type Cap = 'butt' | 'round' | 'square'

--- Which pixels a new coverage call fills: where the winding is not 0, or where it is odd.
export type FillRule = raster.FillRule

--- The options of `coverageIn` and `fillIn`.
export type CoverageOptions = {
  --- `nonzero` (the default) or `evenodd`.
  fillRule: FillRule?,
  --- Where the path is drawn, user space to device space; the identity when left out.
  transform: Matrix?,
  --- The flattening tolerance in device pixels; the path's own when left out.
  tolerance: number?,
  --- Clips the coverage is multiplied by, at most MaxClipDepth of them.
  clips: { Clip }?,
}

--- A clip: coverage bytes whose top left pixel is at `left`, `top` in device space. Outside its mask a
--- clip covers nothing.
export type Clip = { mask: magick.Mask, left: number, top: number }

local Point, Quad, Cubic, Arc, Ellipse = 1, 2, 3, 4, 5

local Module = {}

--- The most pieces one curve or arc is flattened into.
Module.MaxPiecesPerCurve = 16384
--- The most commands one path may hold when it is flattened by a 0.2.0 call.
Module.MaxCommandsPerPath = 1048576
--- The widest or tallest window one coverage call covers.
Module.MaxImageEdge = 8192
--- The most clips one coverage call multiplies by.
Module.MaxClipDepth = 16
--- The most edges one prepared outline may hold, and the most crossings and work one cluster of
--- edges may take inside one pixel row (see the coverage notes in the RFC amendment A1).
Module.MaxSegmentsPerCoverage = raster.MaxSegmentsPerCoverage
Module.MaxStripCrossings = raster.MaxStripCrossings
Module.MaxStripWork = raster.MaxStripWork

--- A piece count, refused past the cap. NaN passes through, as 0.1.3 let it.
local function capped(pieces: number): number
  if pieces > Module.MaxPiecesPerCurve then error(`magick: MaxPiecesPerCurve {Module.MaxPiecesPerCurve} exceeded`, 4) end

  return pieces
end

--- An empty path whose curves are flattened to within `tolerance` pixels, or a quarter pixel.
function Module.new(tolerance: number?): Path
  local outline: Outline = { contours = {}, retained = {}, lines = {}, open = nil, drawing = nil, tolerance = tolerance or 0.25 }

  return setmetatable(outline, Path)
end

--- The area a contour encloses, positive for the winding every shape here is built with.
local function signedArea(points: { number }): number
  local count = #points
  local total = 0
  local lastX, lastY = points[count - 1], points[count]

  for index = 1, count - 1, 2 do
    local pointX, pointY = points[index], points[index + 1]

    total += lastX * pointY - pointX * lastY
    lastX, lastY = pointX, pointY
  end

  return total / 2
end

--- A contour's points in the other order.
local function reversed(points: { number }): { number }
  local count = #points
  local out = table.create(count) :: { number }

  for index = count - 1, 1, -2 do
    table.insert(out, points[index])
    table.insert(out, points[index + 1])
  end

  return out
end

--- Appends a quadratic's points after its start, in pieces few enough that a chord strays from the
--- curve by at most twice `tolerance`: its second difference over eight, shrinking with the square
--- of the number of pieces.
local function quadPoints(
  points: { number },
  fromX: number,
  fromY: number,
  controlX: number,
  controlY: number,
  toX: number,
  toY: number,
  tolerance: number
)
  local bendX, bendY = fromX - 2 * controlX + toX, fromY - 2 * controlY + toY
  local pieces = capped(math.max(1, math.ceil(math.sqrt(math.sqrt(bendX * bendX + bendY * bendY) / (8 * tolerance)))))

  for piece = 1, pieces do
    local along = piece / pieces
    local rest = 1 - along

    table.insert(points, rest * rest * fromX + 2 * rest * along * controlX + along * along * toX)
    table.insert(points, rest * rest * fromY + 2 * rest * along * controlY + along * along * toY)
  end
end

--- Appends a cubic's points after its start: a chord strays by at most three quarters of the larger
--- second difference, shrinking with the square of the number of pieces.
local function cubicPoints(
  points: { number },
  fromX: number,
  fromY: number,
  firstX: number,
  firstY: number,
  secondX: number,
  secondY: number,
  toX: number,
  toY: number,
  tolerance: number
)
  local leadX, leadY = fromX - 2 * firstX + secondX, fromY - 2 * firstY + secondY
  local tailX, tailY = firstX - 2 * secondX + toX, firstY - 2 * secondY + toY
  local bend = math.max(math.sqrt(leadX * leadX + leadY * leadY), math.sqrt(tailX * tailX + tailY * tailY))
  local pieces = capped(math.max(1, math.ceil(math.sqrt(0.75 * bend / tolerance))))

  for piece = 1, pieces do
    local along = piece / pieces
    local rest = 1 - along
    local start, early, late, finish = rest * rest * rest, 3 * rest * rest * along, 3 * rest * along * along, along * along * along

    table.insert(points, start * fromX + early * firstX + late * secondX + finish * toX)
    table.insert(points, start * fromY + early * firstY + late * secondY + finish * toY)
  end
end

--- The points of an elliptical arc about a center, from one angle to another in radians,
--- flattened to within a tolerance, appended to `points`.
local function arc(
  points: { number },
  centerX: number,
  centerY: number,
  radiusX: number,
  radiusY: number,
  from: number,
  to: number,
  tolerance: number
)
  local radius = math.max(radiusX, radiusY)
  -- A chord of angle `step` strays from its arc by radius * (1 - cos(step / 2)).
  local step = if radius > tolerance then 2 * math.acos(1 - tolerance / radius) else math.pi / 2
  local pieces = capped(math.max(2, math.ceil(math.abs(to - from) / step)))
  local turn = math.abs(to - from) / pieces
  -- Chords cut inside the arc, so the points between them are pushed out until the polygon
  -- encloses the area the arc does: a whole circle's chords enclose r^2 * n * sin(turn) / 2. The
  -- ends of an arc that isn't whole stay on it, where the straight edges it meets begin.
  local outward = math.sqrt(turn / math.sin(turn))
  local whole = math.abs(to - from) >= 2 * math.pi

  for piece = 0, pieces do
    local angle = from + (to - from) * piece / pieces
    local reach = if whole or (piece > 0 and piece < pieces) then outward else 1

    table.insert(points, centerX + radiusX * reach * math.cos(angle))
    table.insert(points, centerY + radiusY * reach * math.sin(angle))
  end
end

--- The points of an ellipse about a center.
local function ellipsePoints(centerX: number, centerY: number, radiusX: number, radiusY: number, tolerance: number): { number }
  local points: { number } = {}

  arc(points, centerX, centerY, radiusX, radiusY, 0, 2 * math.pi, tolerance)
  -- The last point is the first again.
  table.remove(points)
  table.remove(points)

  return points
end

--- Flattens retained commands under `matrix` (nil for as drawn) to `tolerance` device pixels.
--- Points and curve control points move first and curves flatten in device space; an arc
--- flattens in its own space to the tolerance divided by the most the matrix stretches, and its
--- points then move. With no matrix this is the arithmetic the 0.1.3 drawing calls do.
local function flattenCommands(commands: { number }, matrix: Matrix?, tolerance: number): { number }
  local points: { number } = {}
  local index, count = 1, #commands
  local userTolerance = if matrix then tolerance / transform.sigmaMax(matrix) else tolerance

  while index <= count do
    local command = commands[index]

    if command == Point then
      local pointX, pointY = commands[index + 1], commands[index + 2]

      if matrix then pointX, pointY = transform.apply(matrix, pointX, pointY) end

      table.insert(points, pointX)
      table.insert(points, pointY)
      index += 3
    elseif command == Quad then
      local controlX, controlY, toX, toY = commands[index + 1], commands[index + 2], commands[index + 3], commands[index + 4]

      if matrix then
        controlX, controlY = transform.apply(matrix, controlX, controlY)
        toX, toY = transform.apply(matrix, toX, toY)
      end

      quadPoints(points, points[#points - 1], points[#points], controlX, controlY, toX, toY, tolerance)
      index += 5
    elseif command == Cubic then
      local firstX, firstY = commands[index + 1], commands[index + 2]
      local secondX, secondY = commands[index + 3], commands[index + 4]
      local toX, toY = commands[index + 5], commands[index + 6]

      if matrix then
        firstX, firstY = transform.apply(matrix, firstX, firstY)
        secondX, secondY = transform.apply(matrix, secondX, secondY)
        toX, toY = transform.apply(matrix, toX, toY)
      end

      cubicPoints(points, points[#points - 1], points[#points], firstX, firstY, secondX, secondY, toX, toY, tolerance)
      index += 7
    else
      local centerX, centerY = commands[index + 1], commands[index + 2]
      local radiusX, radiusY = commands[index + 3], commands[index + 4]
      local own: { number }

      if command == Arc then
        own = if matrix then {} else points
        arc(own, centerX, centerY, radiusX, radiusY, commands[index + 5], commands[index + 6], userTolerance)
        index += 7
      else
        assert(command == Ellipse, 'magick: unknown retained path command')
        own = ellipsePoints(centerX, centerY, radiusX, radiusY, userTolerance)
        if not matrix then table.move(own, 1, #own, #points + 1, points) end
        index += 5
      end

      if matrix then
        for at = 1, #own - 1, 2 do
          local pointX, pointY = transform.apply(matrix, own[at], own[at + 1])

          table.insert(points, pointX)
          table.insert(points, pointY)
        end
      end
    end
  end

  return points
end

--- The points a retained contour flattens to under an outer matrix (nil for none).
local function flattenRetained(contour: Retained, outer: Matrix?, tolerance: number): { number }
  local matrix = contour.matrix

  if outer then matrix = if matrix then transform.multiply(outer, matrix) else outer end

  local points = flattenCommands(contour.commands, matrix, tolerance)

  return if contour.reverse then reversed(points) else points
end

--- Adds a closed contour wound as a shape (`hole` false) or as a hole in one, whichever way its
--- points go, with the commands it was drawn with.
local function wound(self: Path, points: { number }, hole: boolean, commands: { number }): Path
  if #points < 6 then return self end

  local area = signedArea(points)

  if area == 0 then return self end

  local reverse = (area < 0) ~= hole

  table.insert(self.contours, if reverse then reversed(points) else points)
  table.insert(self.retained, { commands = commands, matrix = nil, reverse = reverse, closed = true })

  return self
end

--- Commands that draw a polygon through flat points.
local function pointCommands(points: { number }): { number }
  local commands = table.create(#points // 2 * 3) :: { number }

  for index = 1, #points - 1, 2 do
    table.insert(commands, Point)
    table.insert(commands, points[index])
    table.insert(commands, points[index + 1])
  end

  return commands
end

--- Ends the open contour: a fill closes it whatever `closed` says, and a contour of fewer than
--- three points is dropped from the fill as in 0.1.3, though one of two is kept for strokes.
local function finish(self: Path, closed: boolean): Path
  local points, commands = self.open, self.drawing

  self.open, self.drawing = nil, nil

  if not points or not commands then return self end

  local contour: Retained = { commands = commands, matrix = nil, reverse = false, closed = closed }

  if #points >= 6 then
    table.insert(self.contours, points)
    table.insert(self.retained, contour)
  elseif #points == 4 then
    table.insert(self.lines, contour)
  end

  return self
end

--- Starts a contour at a point, closing the one before it.
function Path.moveTo(self: Path, toX: number, toY: number): Path
  finish(self, false)
  self.open = { toX, toY }
  self.drawing = { Point, toX, toY }

  return self
end

--- The open contour and its commands, or an error naming the drawing call that needs one.
local function opened(self: Path, call: string): ({ number }, { number })
  local points, commands = self.open, self.drawing
  if not points or not commands then error(`magick: path.{call} needs a moveTo first`, 3) end

  return points, commands
end

--- Adds a straight line from the current point.
function Path.lineTo(self: Path, toX: number, toY: number): Path
  local points, commands = opened(self, 'lineTo')

  table.insert(points, toX)
  table.insert(points, toY)
  table.insert(commands, Point)
  table.insert(commands, toX)
  table.insert(commands, toY)

  return self
end

--- Adds a quadratic curve from the current point through a control point.
function Path.quadTo(self: Path, controlX: number, controlY: number, toX: number, toY: number): Path
  local points, commands = opened(self, 'quadTo')

  quadPoints(points, points[#points - 1], points[#points], controlX, controlY, toX, toY, self.tolerance)
  table.move({ Quad, controlX, controlY, toX, toY }, 1, 5, #commands + 1, commands)

  return self
end

--- Adds a cubic curve from the current point through two control points.
function Path.cubicTo(
  self: Path,
  firstX: number,
  firstY: number,
  secondX: number,
  secondY: number,
  toX: number,
  toY: number
): Path
  local points, commands = opened(self, 'cubicTo')

  cubicPoints(points, points[#points - 1], points[#points], firstX, firstY, secondX, secondY, toX, toY, self.tolerance)
  table.move({ Cubic, firstX, firstY, secondX, secondY, toX, toY }, 1, 7, #commands + 1, commands)

  return self
end

--- Closes the open contour, if there is one, back to where it started. A contour drawn here
--- keeps its own winding.
function Path.close(self: Path): Path
  return finish(self, true)
end

--- Ends the open contour, if there is one, without closing it: a stroke leaves its ends apart, and
--- a fill closes it as fills always do. `mask`, `stroked` and the brush samples of /art do this
--- first.
function Path.finish(self: Path): Path
  return finish(self, false)
end

--- What draws into a path through plain functions, for a caller that hands outlines to whatever
--- it is given (a font reader, a vector format) and knows nothing of paths.
export type Pen = {
  moveTo: (x: number, y: number) -> (),
  lineTo: (x: number, y: number) -> (),
  quadTo: (controlX: number, controlY: number, x: number, y: number) -> (),
  cubicTo: (firstX: number, firstY: number, secondX: number, secondY: number, x: number, y: number) -> (),
  close: () -> (),
}

--- A pen that draws into the path.
function Path.pen(self: Path): Pen
  return {
    moveTo = function(toX: number, toY: number)
      self:moveTo(toX, toY)
    end,
    lineTo = function(toX: number, toY: number)
      self:lineTo(toX, toY)
    end,
    quadTo = function(controlX: number, controlY: number, toX: number, toY: number)
      self:quadTo(controlX, controlY, toX, toY)
    end,
    cubicTo = function(firstX: number, firstY: number, secondX: number, secondY: number, toX: number, toY: number)
      self:cubicTo(firstX, firstY, secondX, secondY, toX, toY)
    end,
    close = function()
      self:close()
    end,
  }
end

--- Adds a polygon through points given as `{ x, y }` pairs, as a shape whichever way they go.
function Path.polygon(self: Path, points: { { number } }): Path
  local flat = table.create(#points * 2) :: { number }

  for _, point in points do
    table.insert(flat, point[1])
    table.insert(flat, point[2])
  end

  return wound(self, flat, false, pointCommands(flat))
end

--- Adds a rectangle between two corners.
function Path.rect(self: Path, x0: number, y0: number, x1: number, y1: number): Path
  local points = { x0, y0, x1, y0, x1, y1, x0, y1 }

  return wound(self, points, false, pointCommands(points))
end

--- Adds an ellipse about a center, or a circle when `radiusY` is left out.
function Path.circle(self: Path, centerX: number, centerY: number, radiusX: number, radiusY: number?): Path
  local tall = radiusY or radiusX

  if radiusX <= 0 or tall <= 0 then return self end

  return wound(self, ellipsePoints(centerX, centerY, radiusX, tall, self.tolerance), false, { Ellipse, centerX, centerY, radiusX, tall })
end

--- Adds a circle's outline: the band between an outer and an inner radius.
function Path.ring(self: Path, centerX: number, centerY: number, outer: number, inner: number): Path
  self:circle(centerX, centerY, outer)
  if inner <= 0 then return self end

  return wound(self, ellipsePoints(centerX, centerY, inner, inner, self.tolerance), true, { Ellipse, centerX, centerY, inner, inner })
end

--- Adds a rectangle with its corners rounded to a radius, which is held to half the shorter
--- side.
function Path.roundRect(self: Path, x0: number, y0: number, x1: number, y1: number, radius: number): Path
  local left, right = math.min(x0, x1), math.max(x0, x1)
  local top, bottom = math.min(y0, y1), math.max(y0, y1)
  local corner = math.clamp(radius, 0, math.min(right - left, bottom - top) / 2)

  if corner <= 0 then return self:rect(left, top, right, bottom) end

  local points: { number } = {}
  local quarter = math.pi / 2
  local corners = {
    { right - corner, top + corner, -quarter, 0 },
    { right - corner, bottom - corner, 0, quarter },
    { left + corner, bottom - corner, quarter, 2 * quarter },
    { left + corner, top + corner, 2 * quarter, 3 * quarter },
  }
  local commands: { number } = {}

  for _, each in corners do
    arc(points, each[1], each[2], corner, corner, each[3], each[4], self.tolerance)
    table.move({ Arc, each[1], each[2], corner, corner, each[3], each[4] }, 1, 7, #commands + 1, commands)
  end

  return wound(self, points, false, commands)
end

--- Adds a rectangle's outline, `width` wide inside the corners it is given.
function Path.frame(self: Path, x0: number, y0: number, x1: number, y1: number, width: number): Path
  local left, right = math.min(x0, x1), math.max(x0, x1)
  local top, bottom = math.min(y0, y1), math.max(y0, y1)

  self:rect(left, top, right, bottom)
  if right - left <= 2 * width or bottom - top <= 2 * width then return self end

  local inner = { left + width, top + width, right - width, top + width, right - width, bottom - width, left + width, bottom - width }

  return wound(self, inner, true, pointCommands(inner))
end

--- Adds a straight line `width` wide between two points, each end drawn as its own cap says.
local function stroke(
  self: Path,
  x0: number,
  y0: number,
  x1: number,
  y1: number,
  width: number,
  startCap: Cap,
  endCap: Cap
): Path
  local across, down = x1 - x0, y1 - y0
  local length = math.sqrt(across * across + down * down)
  local half = width / 2

  if length == 0 then
    if startCap == 'round' or endCap == 'round' then return self:circle(x0, y0, half) end
    if startCap == 'square' or endCap == 'square' then return self:rect(x0 - half, y0 - half, x0 + half, y0 + half) end

    return self
  end

  -- The unit along the line, and the half width across it.
  local alongX, alongY = across / length, down / length
  local sideX, sideY = -alongY * half, alongX * half
  local before, after = if startCap == 'square' then half else 0, if endCap == 'square' then half else 0
  local startX, startY = x0 - alongX * before, y0 - alongY * before
  local endX, endY = x1 + alongX * after, y1 + alongY * after
  local band = { startX + sideX, startY + sideY, endX + sideX, endY + sideY, endX - sideX, endY - sideY, startX - sideX, startY - sideY }

  wound(self, band, false, pointCommands(band))
  if startCap == 'round' then self:circle(x0, y0, half) end
  if endCap == 'round' then self:circle(x1, y1, half) end

  return self
end

--- Adds a straight line `width` wide between two points, its ends drawn as `cap` says, or flush.
function Path.line(self: Path, x0: number, y0: number, x1: number, y1: number, width: number, cap: Cap?): Path
  return stroke(self, x0, y0, x1, y1, width, cap or 'butt', cap or 'butt')
end

--- Adds lines `width` wide through points given as `{ x, y }` pairs, joined round, their two ends
--- drawn as `cap` says, or flush.
function Path.polyline(self: Path, points: { { number } }, width: number, cap: Cap?): Path
  local count = #points
  local ends: Cap = cap or 'butt'

  if count == 1 then return stroke(self, points[1][1], points[1][2], points[1][1], points[1][2], width, ends, ends) end

  for index = 1, count - 1 do
    local from, to = points[index], points[index + 1]
    local startCap: Cap, endCap: Cap = if index == 1 then ends else 'butt', if index == count - 1 then ends else 'butt'

    stroke(self, from[1], from[2], to[1], to[2], width, startCap, endCap)
  end

  for index = 2, count - 1 do
    self:circle(points[index][1], points[index][2], width / 2)
  end

  return self
end

--- The smallest box holding every point of the path: left, top, right, bottom. A path with no
--- points has an empty box at the origin.
function Path.bounds(self: Path): (number, number, number, number)
  local left, top, right, bottom = math.huge, math.huge, -math.huge, -math.huge

  for _, points in self.contours do
    for index = 1, #points - 1, 2 do
      local pointX, pointY = points[index], points[index + 1]

      left, right = math.min(left, pointX), (math.max(right, pointX))
      top, bottom = math.min(top, pointY), (math.max(bottom, pointY))
    end
  end

  if left > right then return 0, 0, 0, 0 end

  return left, top, right, bottom
end

--- A new path: this one's closed contours under a matrix, applied after any it was moved by
--- before. The commands are kept, so curves are flattened again for where they now are, to the
--- path's tolerance in its new space; an open contour is left out. The source is unchanged.
function Path.transformBy(self: Path, matrix: Matrix): Path
  transform.check(matrix)

  local out = Module.new(self.tolerance)

  local function moved(contour: Retained): Retained
    return {
      commands = contour.commands,
      matrix = if contour.matrix then transform.multiply(matrix, contour.matrix) else matrix,
      reverse = contour.reverse,
      closed = contour.closed,
    }
  end

  for _, contour in self.retained do
    local each = moved(contour)

    table.insert(out.retained, each)
    table.insert(out.contours, flattenRetained(each, nil, self.tolerance))
  end

  for _, line in self.lines do
    table.insert(out.lines, moved(line))
  end

  return out
end

--- A copy of the path moved by an offset and scaled about the origin first: each point becomes
--- `point * scale + offset`. Curves are kept and flattened again where they land (an
--- owner-approved change in 0.2.0, RFC-0001 P4); a path of lines gives the 0.1.3 points.
function Path.transformed(self: Path, scale: number, dx: number, dy: number): Path
  return self:transformBy(transform.matrix(scale, 0, 0, scale, dx, dy))
end

--- Adds each closed contour of another path to this one, as it winds.
function Path.append(self: Path, other: Path): Path
  for index, points in other.contours do
    table.insert(self.contours, table.clone(points))
    table.insert(self.retained, other.retained[index])
  end

  table.move(other.lines, 1, #other.lines, #self.lines + 1, self.lines)

  return self
end

local function finite(value: number): boolean
  return value == value and value > -math.huge and value < math.huge
end

--- A path as plain data, for saving: its tolerance, and each contour's commands (opcode and
--- numbers: 1 point, 2 quadratic, 3 cubic, 4 arc, 5 ellipse), the matrix it was moved by as
--- SVG's six numbers, whether it winds reversed and whether it was closed on purpose. An open
--- contour still being drawn is not included.
export type ContourDescription = { commands: { number }, matrix: { number }?, reverse: boolean, closed: boolean }
export type Description = { tolerance: number, contours: { ContourDescription }, lines: { ContourDescription } }

local function describeContour(contour: Retained): ContourDescription
  local matrix = contour.matrix

  return {
    commands = table.clone(contour.commands),
    matrix = if matrix then { matrix.scaleX, matrix.skewY, matrix.skewX, matrix.scaleY, matrix.offsetX, matrix.offsetY } else nil,
    reverse = contour.reverse,
    closed = contour.closed,
  }
end

function Module.describe(self: Path): Description
  local contours, lines = {}, {}

  for _, contour in self.retained do
    table.insert(contours, describeContour(contour))
  end

  for _, line in self.lines do
    table.insert(lines, describeContour(line))
  end

  return { tolerance = self.tolerance, contours = contours, lines = lines }
end

--- The numbers each opcode takes.
local Arguments: { [number]: number } = { [Point] = 2, [Quad] = 4, [Cubic] = 6, [Arc] = 6, [Ellipse] = 4 }

--- Checks a described contour from an untrusted source: known opcodes with their numbers, all
--- finite and within MaxCoordinate, a finite matrix, and at most `budget` commands in all.
local function checkContour(description: ContourDescription, budget: { number }): Retained
  local commands = description.commands

  if type(commands) ~= 'table' then error('magick: a path contour needs commands', 4) end

  local index = 1

  while index <= #commands do
    local count = Arguments[commands[index]]

    if not count then error(`magick: unknown path command {commands[index]}`, 4) end

    for offset = 1, count do
      local value = commands[index + offset]

      if type(value) ~= 'number' or not finite(value) or math.abs(value) > transform.MaxCoordinate then
        error('magick: path coordinates must be finite and within MaxCoordinate', 4)
      end
    end

    index += count + 1
  end

  if index ~= #commands + 1 or #commands == 0 or commands[1] ~= Point and commands[1] ~= Arc and commands[1] ~= Ellipse then
    error('magick: a path contour must start with a point, an arc or an ellipse', 4)
  end

  budget[1] += #commands
  if budget[1] > Module.MaxCommandsPerPath then error(`magick: MaxCommandsPerPath {Module.MaxCommandsPerPath} exceeded`, 4) end

  local fields = description.matrix
  local matrix: Matrix? = nil

  if fields then
    if type(fields) ~= 'table' or #fields ~= 6 then error('magick: a contour matrix is six numbers', 4) end

    matrix = transform.matrix(fields[1], fields[2], fields[3], fields[4], fields[5], fields[6])
  end

  return { commands = table.clone(commands), matrix = matrix, reverse = description.reverse == true, closed = description.closed == true }
end

--- A path from `describe`'s data, checked as untrusted: refused rather than trusted when anything in
--- it is unknown, nonfinite or past a cap. Its contours flatten again at its tolerance.
function Module.fromDescription(description: Description): Path
  local tolerance = description.tolerance

  if type(tolerance) ~= 'number' or not finite(tolerance) or tolerance <= 0 then error('magick: tolerance must be a positive finite number', 2) end

  local out = Module.new(tolerance)
  local budget = { 0 }

  for _, contour in description.contours or {} do
    local retained = checkContour(contour, budget)

    table.insert(out.retained, retained)
    table.insert(out.contours, flattenRetained(retained, nil, tolerance))
  end

  for _, line in description.lines or {} do
    table.insert(out.lines, checkContour(line, budget))
  end

  return out
end

--- The tolerance a 0.2.0 call flattens to, checked.
local function deviceTolerance(self: Path, tolerance: number?): number
  local chosen = tolerance or self.tolerance

  if not finite(chosen) or chosen <= 0 then error('magick: tolerance must be a positive finite number', 3) end

  return chosen
end

--- Refuses a path a 0.2.0 call cannot flatten: too many commands, or a coordinate that is not
--- finite or lies past MaxCoordinate.
local function checkCommands(self: Path)
  local total = 0
  local limit = transform.MaxCoordinate

  for _, contour in self.retained do
    total += #contour.commands
    if total > Module.MaxCommandsPerPath then error(`magick: MaxCommandsPerPath {Module.MaxCommandsPerPath} exceeded`, 4) end

    for _, value in contour.commands do
      if not finite(value) then error('magick: path coordinates must be finite', 4) end
      if math.abs(value) > limit then error(`magick: MaxCoordinate {limit} exceeded`, 4) end
    end
  end
end

--- The closed contours flattened under a matrix (the identity when left out) to `tolerance`
--- device pixels (the path's own when left out), as flat x, y lists in device space. Shapes keep
--- the winding the drawing calls gave them; a reflection turns every contour over alike.
function Module.flatten(self: Path, tolerance: number?, matrix: Matrix?): { { number } }
  local chosen = deviceTolerance(self, tolerance)

  if matrix then transform.check(matrix) end

  checkCommands(self)

  local out: { { number } } = {}

  for _, contour in self.retained do
    table.insert(out, flattenRetained(contour, matrix, chosen))
  end

  return out
end

--- The box a path covers in device space under a matrix: left, top, right, bottom, not rounded.
--- It holds both the curves and the outline they flatten to, so it is a bound on any coverage the
--- path gives there. `halfWidth` widens it by that much in user space, as a stroke would.
function Path.deviceBounds(self: Path, matrix: Matrix?, halfWidth: number?): (number, number, number, number)
  local chosen = matrix or transform.identity()
  local left: number, top: number, right: number, bottom: number = math.huge, math.huge, -math.huge, -math.huge

  for _, points in Module.flatten(self, nil, chosen) do
    for index = 1, #points - 1, 2 do
      left, right = math.min(left, points[index]), (math.max(right, points[index]))
      top, bottom = math.min(top, points[index + 1]), (math.max(bottom, points[index + 1]))
    end
  end

  --- Widens the box to hold a cubic Bezier under a matrix.
  local function widen(
    matrix: Matrix,
    startX: number,
    startY: number,
    firstX: number,
    firstY: number,
    secondX: number,
    secondY: number,
    finishX: number,
    finishY: number
  )
    local boxLeft, boxTop, boxRight, boxBottom = transform.cubicBox(matrix, startX, startY, firstX, firstY, secondX, secondY, finishX, finishY)

    left, top = math.min(left, boxLeft), math.min(top, boxTop)
    right, bottom = math.max(right, boxRight), (math.max(bottom, boxBottom))
  end

  for _, contour in self.retained do
    local whole = if contour.matrix then transform.multiply(chosen, contour.matrix) else chosen
    local commands = contour.commands
    local index, lastX, lastY = 1, 0, 0

    while index <= #commands do
      local command = commands[index]

      if command == Point then
        lastX, lastY = commands[index + 1], commands[index + 2]
        index += 3
      elseif command == Quad then
        -- A quadratic is the cubic whose inner controls lie two thirds of the way to its control.
        local controlX, controlY = commands[index + 1], commands[index + 2]
        local toX, toY = commands[index + 3], commands[index + 4]

        widen(
          whole,
          lastX,
          lastY,
          lastX + 2 / 3 * (controlX - lastX),
          lastY + 2 / 3 * (controlY - lastY),
          toX + 2 / 3 * (controlX - toX),
          toY + 2 / 3 * (controlY - toY),
          toX,
          toY
        )
        lastX, lastY = toX, toY
        index += 5
      elseif command == Cubic then
        local toX, toY = commands[index + 5], commands[index + 6]

        widen(whole, lastX, lastY, commands[index + 1], commands[index + 2], commands[index + 3], commands[index + 4], toX, toY)
        lastX, lastY = toX, toY
        index += 7
      else
        local centerX, centerY = commands[index + 1], commands[index + 2]
        local radiusX, radiusY = commands[index + 3], commands[index + 4]
        local from, to = 0, 2 * math.pi

        if command == Arc then
          from, to = commands[index + 5], commands[index + 6]
          index += 7
        else
          index += 5
        end

        -- The ellipse's image is center + U cos(angle) + V sin(angle); each coordinate peaks at
        -- the angle atan2(V, U) and is least half a turn on, where those lie on the arc.
        local uX, uY = transform.applyVector(whole, radiusX, 0)
        local vX, vY = transform.applyVector(whole, 0, radiusY)
        local midX, midY = transform.apply(whole, centerX, centerY)
        local sweep = to - from

        for _, axis in { { uX, vX, 1 }, { uY, vY, 2 } } do
          local peak = math.atan2(axis[2], axis[1])

          for _, angle in { peak, peak + math.pi } do
            if (angle - from) % (2 * math.pi) > sweep then continue end

            local value = axis[1] * math.cos(angle) + axis[2] * math.sin(angle)

            if axis[3] == 1 then
              left, right = math.min(left, midX + value), (math.max(right, midX + value))
            else
              top, bottom = math.min(top, midY + value), (math.max(bottom, midY + value))
            end
          end
        end

        lastX, lastY = centerX + radiusX * math.cos(to), centerY + radiusY * math.sin(to)
      end
    end
  end

  if left > right then return 0, 0, 0, 0 end

  local inflate = (halfWidth or 0) * transform.sigmaMax(chosen)

  return left - inflate, top - inflate, right + inflate, bottom + inflate
end

--- How the segments of a stroke meet: at a point (cut off past `miterLimit`), round, or cut flat.
export type Join = 'miter' | 'round' | 'bevel'

--- The options of `stroked`. Lengths are in the path's space (user space); `transform` is where the
--- stroke will be drawn, and only sets how finely the centerline is flattened.
export type StrokeOptions = {
  width: number,
  --- `miter` (the default), `round` or `bevel`.
  join: Join?,
  --- The longest a miter may be, in widths: past it a join is a bevel. 4 by default, at least 1.
  miterLimit: number?,
  --- `butt` (the default), `round` or `square`, at the ends of open subpaths and of dashes.
  cap: Cap?,
  --- Lengths drawn and skipped by turns, at most MaxDashEntries; an empty list or all zeros is solid.
  dashes: { number }?,
  --- How far into the dash pattern the stroke starts.
  dashOffset: number?,
  transform: Matrix?,
  --- The device tolerance the centerline is flattened to; the path's own when left out.
  tolerance: number?,
}

--- The most entries a dash pattern has, and the most dashes one stroke draws.
Module.MaxDashEntries = 64
Module.MaxDashesPerStroke = 1048576

local StrokeKeys = {
  width = true,
  join = true,
  miterLimit = true,
  cap = true,
  dashes = true,
  dashOffset = true,
  transform = true,
  tolerance = true,
}

--- Adds a piece of a stroke: a polygon through flat points, wound as a shape.
local function piece(out: Path, points: { number })
  wound(out, points, false, pointCommands(points))
end

--- Adds a round piece about a center: a whole disc, or the wedge of an arc between two angles.
local function roundPiece(out: Path, centerX: number, centerY: number, half: number, from: number?, to: number?)
  if not from or not to then
    out:circle(centerX, centerY, half)

    return
  end

  local commands = { Point, centerX, centerY, Arc, centerX, centerY, half, half, from, to }

  wound(out, flattenCommands(commands, nil, out.tolerance), false, commands)
end

--- The cap of one end of a stroke at a point, the stroke running along `alongX, alongY` away from it.
local function capEnd(out: Path, cap: Cap, pointX: number, pointY: number, alongX: number, alongY: number, half: number)
  if cap == 'round' then
    roundPiece(out, pointX, pointY, half)
  elseif cap == 'square' then
    local sideX, sideY = -alongY * half, alongX * half
    local backX, backY = pointX - alongX * half, pointY - alongY * half

    piece(out, { pointX + sideX, pointY + sideY, pointX - sideX, pointY - sideY, backX - sideX, backY - sideY, backX + sideX, backY + sideY })
  end
end

--- The join at a point between a segment arriving along `inX, inY` and one leaving along
--- `outX, outY`, both unit vectors: a piece on the outside of the turn.
local function joinAt(
  out: Path,
  join: Join,
  limit: number,
  pointX: number,
  pointY: number,
  inX: number,
  inY: number,
  outX: number,
  outY: number,
  half: number
)
  local cross, dot = inX * outY - inY * outX, inX * outX + inY * outY

  if math.abs(cross) <= 1e-12 then
    -- Straight on needs nothing; straight back is a half turn, which only a round join fills.
    if dot > 0 then return end
    if join == 'round' then roundPiece(out, pointX, pointY, half) end

    return
  end

  -- The outside of a turn toward the left normal (-y, x) is its right, and the other way about.
  local side = if cross > 0 then -half else half
  local inSideX, inSideY = -inY * side, inX * side
  local outSideX, outSideY = -outY * side, outX * side

  if join == 'round' then
    local from = math.atan2(inSideY, inSideX)
    local turn = (math.atan2(outSideY, outSideX) - from + math.pi) % (2 * math.pi) - math.pi

    roundPiece(out, pointX, pointY, half, from, from + turn)

    return
  end

  -- The miter's length over the width is 1 / sin(interior / 2), which is 1 / cos(turn / 2).
  local cosHalf = math.sqrt(math.max(0, (1 + dot) / 2))

  if join == 'miter' and cosHalf > 0 and 1 / cosHalf <= limit then
    local reach = 1 / (2 * cosHalf * cosHalf)
    local tipX, tipY = pointX + (inSideX + outSideX) * reach, pointY + (inSideY + outSideY) * reach

    piece(out, { pointX, pointY, pointX + inSideX, pointY + inSideY, tipX, tipY, pointX + outSideX, pointY + outSideY })

    return
  end

  piece(out, { pointX, pointY, pointX + inSideX, pointY + inSideY, pointX + outSideX, pointY + outSideY })
end

--- Strokes a centerline of distinct points: a band along each segment, a join at each corner,
--- and caps at the ends of an open one, or a lone point's cap where it has no length.
local function strokeLine(out: Path, points: { number }, closed: boolean, half: number, join: Join, limit: number, cap: Cap)
  local count = #points // 2

  if count == 0 then return end

  if count == 1 then
    -- A point with no length draws both its caps about itself: a disc, or a square.
    if cap ~= 'butt' then
      capEnd(out, cap, points[1], points[2], 1, 0, half)
      capEnd(out, cap, points[1], points[2], -1, 0, half)
    end

    return
  end

  local segments = if closed and count > 2 then count else count - 1
  local directions: { number } = table.create(segments * 2) :: { number }

  for segment = 1, segments do
    local fromX, fromY = points[segment * 2 - 1], points[segment * 2]
    local next = segment % count + 1
    local toX, toY = points[next * 2 - 1], points[next * 2]
    local length = math.sqrt((toX - fromX) ^ 2 + (toY - fromY) ^ 2)
    local alongX, alongY = (toX - fromX) / length, (toY - fromY) / length
    local sideX, sideY = -alongY * half, alongX * half

    directions[segment * 2 - 1], directions[segment * 2] = alongX, alongY
    piece(out, { fromX + sideX, fromY + sideY, toX + sideX, toY + sideY, toX - sideX, toY - sideY, fromX - sideX, fromY - sideY })
  end

  local isClosed = segments == count

  for corner = if isClosed then 1 else 2, if isClosed then count else count - 1 do
    local before = if corner == 1 then segments else corner - 1

    joinAt(
      out,
      join,
      limit,
      points[corner * 2 - 1],
      points[corner * 2],
      directions[before * 2 - 1],
      directions[before * 2],
      directions[corner * 2 - 1],
      directions[corner * 2],
      half
    )
  end

  if isClosed then return end

  capEnd(out, cap, points[1], points[2], directions[1], directions[2], half)
  capEnd(out, cap, points[count * 2 - 1], points[count * 2], -directions[segments * 2 - 1], -directions[segments * 2], half)
end

--- A centerline's points with every repeated point dropped, and its last point too when a closed
--- line returns to its first.
local function distinct(points: { number }, closed: boolean): { number }
  local out: { number } = {}

  for index = 1, #points - 1, 2 do
    local count = #out

    if count == 0 or points[index] ~= out[count - 1] or points[index + 1] ~= out[count] then
      table.insert(out, points[index])
      table.insert(out, points[index + 1])
    end
  end

  if closed and #out >= 4 and out[1] == out[#out - 1] and out[2] == out[#out] then
    table.remove(out)
    table.remove(out)
  end

  return out
end

--- Cuts a centerline into dashes: open lines of distinct points, `on` lengths drawn and `off`
--- lengths skipped by turns from `offset` into the pattern.
local function dashed(points: { number }, closed: boolean, dashes: { number }, offset: number, budget: { number }): { { number } }
  local lines: { { number } } = {}
  local count = #points // 2
  local segments = if closed then count else count - 1
  local entry, remaining = 1, dashes[1]
  local phase = offset

  while phase > 0 do
    if phase < remaining then
      remaining -= phase
      phase = 0
    else
      phase -= remaining
      entry = entry % #dashes + 1
      remaining = dashes[entry]
    end
  end

  local current: { number }? = nil

  local function begin(pointX: number, pointY: number)
    budget[1] += 1
    if budget[1] > Module.MaxDashesPerStroke then error(`magick: MaxDashesPerStroke {Module.MaxDashesPerStroke} exceeded`, 5) end

    current = { pointX, pointY }
    table.insert(lines, current :: { number })
  end

  if entry % 2 == 1 then begin(points[1], points[2]) end

  for segment = 1, segments do
    local fromX, fromY = points[segment * 2 - 1], points[segment * 2]
    local next = segment % count + 1
    local toX, toY = points[next * 2 - 1], points[next * 2]
    local length = math.sqrt((toX - fromX) ^ 2 + (toY - fromY) ^ 2)
    local travelled = 0

    -- A dash boundary exactly at a segment's end is taken here, so a dash that starts at the very
    -- end of the line is drawn, as a point.
    while length - travelled >= remaining do
      travelled += remaining

      local along = travelled / length
      local pointX, pointY = fromX + (toX - fromX) * along, fromY + (toY - fromY) * along
      local drawing = current

      if drawing then
        table.insert(drawing, pointX)
        table.insert(drawing, pointY)
        current = nil
      end

      entry = entry % #dashes + 1
      remaining = dashes[entry]
      if entry % 2 == 1 then begin(pointX, pointY) end
    end

    remaining -= length - travelled

    local drawing = current

    if drawing then
      table.insert(drawing, toX)
      table.insert(drawing, toY)
    end
  end

  local out: { { number } } = {}

  for _, line in lines do
    table.insert(out, distinct(line, false))
  end

  return out
end

local function checkDashes(dashes: { number }?): { number }?
  if not dashes or #dashes == 0 then return nil end
  if #dashes > Module.MaxDashEntries then error(`magick: MaxDashEntries {Module.MaxDashEntries} exceeded`, 4) end

  local total = 0

  for _, length in dashes do
    if not finite(length) or length < 0 then error('magick: dash lengths must be finite and not negative', 4) end

    total += length
  end

  if total <= 0 then return nil end

  -- An odd pattern repeats twice over, so that on and off swap places the second time, as SVG has it.
  if #dashes % 2 == 1 then
    local doubled = table.clone(dashes)

    table.move(dashes, 1, #dashes, #doubled + 1, doubled)

    return doubled
  end

  return dashes
end

--- The outline of the path's stroke, as a new path of pieces that overlap: a band along each
--- segment, a join at each corner, caps at the ends of open subpaths and dashes. Their union is
--- the stroke, which is what `coverageIn` (nonzero) covers; the 0.1.3 `mask` sums overlaps and is
--- not the call for it. Curves in the centerline are flattened to the tolerance over the most the
--- options' transform stretches; round joins and caps stay arcs.
function Path.stroked(self: Path, options: StrokeOptions): Path
  for name in (options :: unknown) :: { [string]: unknown } do
    if not StrokeKeys[name] then error(`magick: unknown option {name}`, 2) end
  end

  local width = options.width

  if type(width) ~= 'number' or not finite(width) or width < 0 then error('magick: stroke width must be finite and not negative', 2) end
  if width > transform.MaxCoordinate then error(`magick: MaxCoordinate {transform.MaxCoordinate} exceeded`, 2) end

  local join, cap = options.join or 'miter', options.cap or 'butt'

  if join ~= 'miter' and join ~= 'round' and join ~= 'bevel' then error(`magick: unknown join {join}`, 2) end
  if cap ~= 'butt' and cap ~= 'round' and cap ~= 'square' then error(`magick: unknown cap {cap}`, 2) end

  local limit = options.miterLimit or 4

  if not finite(limit) or limit < 1 then error('magick: miterLimit must be finite and at least 1', 2) end

  local offset = options.dashOffset or 0

  if not finite(offset) then error('magick: dashOffset must be finite', 2) end

  local dashes = checkDashes(options.dashes)
  local matrix = options.transform

  if matrix then transform.check(matrix) end

  finish(self, false)
  checkCommands(self)

  local out = Module.new(self.tolerance)
  local half = width / 2

  if half == 0 then return out end

  local tolerance = deviceTolerance(self, options.tolerance) / (if matrix then transform.sigmaMax(matrix) else 1)
  local budget = { 0 }

  local function strokeContour(contour: Retained)
    local points = distinct(flattenCommands(contour.commands, contour.matrix, tolerance), contour.closed)

    if not dashes then
      strokeLine(out, points, contour.closed, half, join, limit, cap)

      return
    end

    local period, travel = 0, 0

    for _, length in dashes do
      period += length
    end

    for index = 3, #points - 1, 2 do
      travel += math.sqrt((points[index] - points[index - 2]) ^ 2 + (points[index + 1] - points[index - 1]) ^ 2)
    end

    if contour.closed and #points >= 4 then
      travel += math.sqrt((points[1] - points[#points - 1]) ^ 2 + (points[2] - points[#points]) ^ 2)
    end

    -- Each period draws at most half its entries as dashes: refuse before building them.
    if budget[1] + (travel / period + 2) * #dashes / 2 > Module.MaxDashesPerStroke then
      error(`magick: MaxDashesPerStroke {Module.MaxDashesPerStroke} exceeded`, 3)
    end

    for _, line in dashed(points, contour.closed, dashes, offset % period, budget) do
      strokeLine(out, line, false, half, join, limit, cap)
    end
  end

  for _, contour in self.retained do
    strokeContour(contour)
  end

  for _, line in self.lines do
    strokeContour(line)
  end

  return out
end

--- Checks a window: whole numbers, its edges at most MaxImageEdge.
local function checkWindow(left: number, top: number, width: number, height: number)
  for _, value in { left, top, width, height } do
    if not finite(value) or value ~= math.floor(value) then error('magick: coverage window must be whole numbers', 4) end
  end

  if width < 0 or height < 0 then error('magick: coverage window must not be negative', 4) end
  if width > Module.MaxImageEdge or height > Module.MaxImageEdge then error(`magick: MaxImageEdge {Module.MaxImageEdge} exceeded`, 4) end
end

local Options = { fillRule = true, transform = true, tolerance = true, clips = true }

local function checkOptions(options: CoverageOptions?): FillRule
  if not options then return 'nonzero' end

  for name in (options :: unknown) :: { [string]: unknown } do
    if not Options[name] then error(`magick: unknown option {name}`, 4) end
  end

  local rule = options.fillRule or 'nonzero'

  if rule ~= 'nonzero' and rule ~= 'evenodd' then error(`magick: unknown fill rule {rule}`, 4) end

  return rule
end

--- Multiplies a window's coverage bytes by each clip's, in place: a pixel keeps
--- `(coverage * clip + 127) // 255` for each clip in turn, and 0 where a clip's mask does not reach.
--- Nothing is allocated.
local function applyClips(data: buffer, left: number, top: number, width: number, height: number, clips: { Clip }?)
  if not clips then return end
  if #clips > Module.MaxClipDepth then error(`magick: MaxClipDepth {Module.MaxClipDepth} exceeded`, 4) end

  for _, clip in clips do
    local mask = clip.mask

    if clip.left ~= math.floor(clip.left) or clip.top ~= math.floor(clip.top) then
      error('magick: a clip must sit at whole pixels', 4)
    end

    for row = 0, height - 1 do
      local maskRow = top + row - clip.top

      for column = 0, width - 1 do
        local maskColumn = left + column - clip.left
        local at = row * width + column
        local value = buffer.readu8(data, at)

        if value == 0 then continue end

        local inside = maskRow >= 0 and maskRow < mask.height and maskColumn >= 0 and maskColumn < mask.width
        local factor = if inside then buffer.readu8(mask.data, maskRow * mask.width + maskColumn) else 0

        buffer.writeu8(data, at, (value * factor + 127) // 255)
      end
    end
  end
end

--- A path flattened and ready to be covered over many windows, such as the tiles of one image.
export type Prepared = raster.Prepared

--- Flattens the path under the options' matrix and tolerance and sorts its edges, once, for
--- `coverOf` to cover any number of windows with.
function Module.prepare(self: Path, options: CoverageOptions?): Prepared
  checkOptions(options)

  local matrix, tolerance = if options then options.transform else nil, if options then options.tolerance else nil

  return raster.prepare(Module.flatten(self, deviceTolerance(self, tolerance), matrix))
end

--- Coverage bytes of a prepared path over a window, by a fill rule, multiplied by any clips.
function Module.coverOf(prepared: Prepared, rule: FillRule, left: number, top: number, width: number, height: number, clips: { Clip }?): magick.Mask
  checkWindow(left, top, width, height)
  if rule ~= 'nonzero' and rule ~= 'evenodd' then error(`magick: unknown fill rule {rule}`, 2) end

  local data = raster.coverage(prepared, rule, left, top, width, height)

  applyClips(data, left, top, width, height, clips)

  return magick.mask(width, height, data)
end

--- The path's coverage over the window `width` by `height` pixels whose top left pixel is
--- (`left`, `top`), by a fill rule, exact for the flattened outline whether or not its contours
--- cross or overlap. Scratch is one row of the window; any part of the path outside it costs only
--- its edges. A window is the same bytes as that part of a larger window.
function Path.coverageIn(self: Path, left: number, top: number, width: number, height: number, options: CoverageOptions?): magick.Mask
  checkWindow(left, top, width, height)

  local rule = checkOptions(options)
  local matrix, tolerance = if options then options.transform else nil, if options then options.tolerance else nil
  local prepared = raster.prepare(Module.flatten(self, deviceTolerance(self, tolerance), matrix))

  local data = raster.coverage(prepared, rule, left, top, width, height)

  applyClips(data, left, top, width, height, if options then options.clips else nil)

  return magick.mask(width, height, data)
end

--- Adds the signed area a line from one point to another sweeps over each cell it crosses, and
--- what it leaves to the cell after the last, to a row-major grid of cells `stride` wide, so that
--- a running sum along each row is the winding the line contributes to each pixel's coverage.
@native
local function sweep(cells: buffer, stride: number, rows: number, fromX: number, fromY: number, toX: number, toY: number)
  if fromY == toY then return end

  local direction = 1

  if fromY > toY then
    direction = -1
    fromX, fromY, toX, toY = toX, toY, fromX, fromY
  end

  local slope = (toX - fromX) / (toY - fromY)
  local currentX = fromX

  for row = math.max(0, math.floor(fromY)), math.min(rows, math.ceil(toY)) - 1 do
    local rowStart = row * stride
    local height = math.min(row + 1, toY) - math.max(row, fromY)
    local nextX = currentX + slope * height
    local share = height * direction
    local left, right = math.min(currentX, nextX), math.max(currentX, nextX)
    local leftCell, rightCell = math.floor(left), math.ceil(right)

    if rightCell <= leftCell + 1 then
      -- The line stays in one cell: it covers the part of it right of its middle.
      local middle = 0.5 * (currentX + nextX) - leftCell
      local at = (rowStart + leftCell) * 8

      buffer.writef64(cells, at, buffer.readf64(cells, at) + share * (1 - middle))
      buffer.writef64(cells, at + 8, buffer.readf64(cells, at + 8) + share * middle)
    else
      -- The line crosses cells: the first and last take the triangles it cuts from them, those
      -- between take an even share, and what is left over carries to the cell after.
      local inverse = 1 / (right - left)
      local leftPart = left - leftCell
      local firstArea = 0.5 * inverse * (1 - leftPart) * (1 - leftPart)
      local rightPart = right - rightCell + 1
      local lastArea = 0.5 * inverse * rightPart * rightPart
      local at = (rowStart + leftCell) * 8

      buffer.writef64(cells, at, buffer.readf64(cells, at) + share * firstArea)

      if rightCell == leftCell + 2 then
        buffer.writef64(cells, at + 8, buffer.readf64(cells, at + 8) + share * (1 - firstArea - lastArea))
      else
        local secondArea = inverse * (1.5 - leftPart)

        buffer.writef64(cells, at + 8, buffer.readf64(cells, at + 8) + share * (secondArea - firstArea))

        for cell = rowStart + leftCell + 2, rowStart + rightCell - 2 do
          buffer.writef64(cells, cell * 8, buffer.readf64(cells, cell * 8) + share * inverse)
        end

        local beforeLast = secondArea + (rightCell - leftCell - 3) * inverse
        local penultimate = (rowStart + rightCell - 1) * 8

        buffer.writef64(cells, penultimate, buffer.readf64(cells, penultimate) + share * (1 - beforeLast - lastArea))
      end

      local last = (rowStart + rightCell) * 8

      buffer.writef64(cells, last, buffer.readf64(cells, last) + share * lastArea)
    end

    currentX = nextX
  end
end

--- Sums each row of cells into coverage bytes, a byte a pixel, `width` of the `stride` cells a
--- row has.
@native
local function settle(cells: buffer, stride: number, width: number, height: number, covered: buffer)
  for row = 0, height - 1 do
    local total = 0
    local at, to = row * stride * 8, row * width

    for column = 0, width - 1 do
      total += buffer.readf64(cells, at)

      local coverage = math.min(1, math.abs(total))

      buffer.writeu8(covered, to + column, math.floor(coverage * 255 + 0.5))
      at += 8
    end
  end
end

--- The path's coverage over the pixels its bounds touch, and where that mask's top left corner
--- is in the image the path was drawn for.
function Path.mask(self: Path): (magick.Mask, number, number)
  finish(self, false)

  local minX, minY, maxX, maxY = self:bounds()
  local left, top = math.floor(minX), math.floor(minY)
  local width, height = math.ceil(maxX) - left + 1, math.ceil(maxY) - top

  if #self.contours == 0 or height <= 0 then return magick.mask(0, 0, buffer.create(0)), 0, 0 end

  -- One spare cell a row: a line along the right edge leaves its remainder past it.
  local stride = width + 1
  local cells = buffer.create(stride * height * 8)

  for _, points in self.contours do
    local count = #points
    local lastX, lastY = points[count - 1] - left, points[count] - top

    for index = 1, count - 1, 2 do
      local pointX, pointY = points[index] - left, points[index + 1] - top

      sweep(cells, stride, height, lastX, lastY, pointX, pointY)
      lastX, lastY = pointX, pointY
    end
  end

  local covered = buffer.create(width * height)

  settle(cells, stride, width, height, covered)

  return magick.mask(width, height, covered), left, top
end

--- Composites a color over an image through the path's coverage, and returns the image.
function Path.fill(self: Path, image: magick.Image, color: magick.Color?): magick.Image
  local mask, left, top = self:mask()

  return image:overMask(mask, color, left, top)
end

Module.Path = Path

return Module
