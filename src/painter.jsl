--!strict
--[[
@magick/painter: painting a reference coarse to fine (MAG-037 to MAG-040), after the method Aaron
Hertzmann described at SIGGRAPH 1998 ("Painterly Rendering with Curved Brush Strokes of Multiple
Sizes"); this is an implementation of that idea, not of his code.

`analyze` makes the reference's pyramid: one blurred copy for each brush radius, and its luminance
gradient. `plan` paints largest brush first: over a grid as fine as the brush, wherever a quick
estimate of the canvas so far differs from that level's blur by more than `threshold`, it starts a
stroke at the worst pixel of the cell, in the color there, and runs it along the edge (across the
gradient), bending no faster than `curvature` allows and stopping where the reference's color
leaves the stroke's. Each stroke is stamped into the estimate before the next level looks, so
finer brushes go only where detail is still missing. Everything is a function of the reference,
the options and the seed: no generator, no clock.

`apply` turns a plan into brush strokes in a scene; `error` measures how far an image is from the
reference. The reference must be an image the caller may use: the gallery's own renders are.
]]
local brush = require '@magick/brush'
local magick = require '@magick'
local noise = require '@magick/noise'
local scene = require '@magick/scene'
local transform = require '@magick/transform'

local Module = {}

Module.MaxStrokesPerPlan = 16384
Module.MaxPlanLevels = 8
Module.MaxStrokeLength = 64
--- The largest reference a plan reads: 1024 by 1024 pixels.
Module.MaxReferencePixels = 1048576

--- One level of the pyramid: the reference blurred for a brush, as straight sRGB floats, and the
--- gradient of its luminance.
export type Level = {
  radius: number,
  width: number,
  height: number,
  red: { number },
  green: { number },
  blue: { number },
  gradientX: { number },
  gradientY: { number },
}

--- A planned stroke: its points in reference pixels, its brush radius, and its straight color.
export type Stroke = { points: { number }, radius: number, red: number, green: number, blue: number }

--- How a plan went at one level: strokes laid, and the mean error left after it, 0..1.
export type LevelStats = { radius: number, strokes: number, error: number }

export type Plan = { width: number, height: number, strokes: { Stroke }, levels: { LevelStats } }

export type Options = {
  --- Brush radii from large to small, in reference pixels (8, 4, 2 by default).
  radii: { number }?,
  --- How far the estimate may differ from a level's blur, 0..1 of a channel's range (0.1).
  threshold: number?,
  --- How fast a stroke may turn: 0 follows the edge wholly, 1 never turns (0.4).
  curvature: number?,
  --- The fewest and most points a stroke has (2 and 14).
  minimumLength: number?,
  maximumLength: number?,
  --- Grid spacing as a fraction of the radius (1).
  grid: number?,
  seed: number?,
  --- Stop after this many strokes (MaxStrokesPerPlan).
  budget: number?,
}

local function luminance(red: number, green: number, blue: number): number
  return 0.2126 * red + 0.7152 * green + 0.0722 * blue
end

--- A box blur of one channel, `size` pixels a side, done twice each way, nothing past the edges.
local function blurChannel(values: { number }, width: number, height: number, size: number): { number }
  if size <= 0 then return table.clone(values) end

  local current = table.clone(values)
  local spare = table.create(width * height, 0) :: { number }

  for _ = 1, 2 do
    for row = 0, height - 1 do
      local total, count = 0, 0

      for column = -size, width - 1 + size do
        local entering, leaving = column + size, column - size - 1

        if entering >= 0 and entering < width then
          total += current[row * width + entering + 1]
          count += 1
        end

        if leaving >= 0 and leaving < width then
          total -= current[row * width + leaving + 1]
          count -= 1
        end

        if column >= 0 and column < width then spare[row * width + column + 1] = total / count end
      end
    end

    for column = 0, width - 1 do
      local total, count = 0, 0

      for row = -size, height - 1 + size do
        local entering, leaving = row + size, row - size - 1

        if entering >= 0 and entering < height then
          total += spare[entering * width + column + 1]
          count += 1
        end

        if leaving >= 0 and leaving < height then
          total -= spare[leaving * width + column + 1]
          count -= 1
        end

        if row >= 0 and row < height then current[row * width + column + 1] = total / count end
      end
    end
  end

  return current
end

--- The pyramid of a reference image for brush radii, largest first: each level the reference
--- blurred by half its radius and the Sobel gradient of its luminance.
function Module.analyze(reference: magick.Image, radii: { number }): { Level }
  local width, height = reference.width, reference.height

  if width < 2 or height < 2 then error('magick: a reference needs at least 2 by 2 pixels', 2) end
  if width * height > Module.MaxReferencePixels then error(`magick: MaxReferencePixels {Module.MaxReferencePixels} exceeded`, 2) end
  if #radii < 1 or #radii > Module.MaxPlanLevels then error(`magick: a plan has 1..{Module.MaxPlanLevels} levels`, 2) end

  local red, green, blue = table.create(width * height) :: { number }, table.create(width * height) :: { number }, table.create(width * height) :: { number }

  for index = 0, width * height - 1 do
    red[index + 1] = buffer.readu8(reference.data, index * 4) / 255
    green[index + 1] = buffer.readu8(reference.data, index * 4 + 1) / 255
    blue[index + 1] = buffer.readu8(reference.data, index * 4 + 2) / 255
  end

  local levels: { Level } = {}

  for _, radius in radii do
    if radius ~= radius or radius < 1 or radius > 128 then error('magick: a brush radius must be in 1..128', 2) end

    local size = math.max(0, math.floor(radius / 2))
    local level: Level = {
      radius = radius,
      width = width,
      height = height,
      red = blurChannel(red, width, height, size),
      green = blurChannel(green, width, height, size),
      blue = blurChannel(blue, width, height, size),
      gradientX = table.create(width * height, 0),
      gradientY = table.create(width * height, 0),
    }

    local function light(column: number, row: number): number
      local at = math.clamp(row, 0, height - 1) * width + math.clamp(column, 0, width - 1) + 1

      return luminance(level.red[at], level.green[at], level.blue[at])
    end

    for row = 0, height - 1 do
      for column = 0, width - 1 do
        local at = row * width + column + 1

        level.gradientX[at] = (light(column + 1, row - 1) + 2 * light(column + 1, row) + light(column + 1, row + 1))
          - (light(column - 1, row - 1) + 2 * light(column - 1, row) + light(column - 1, row + 1))
        level.gradientY[at] = (light(column - 1, row + 1) + 2 * light(column, row + 1) + light(column + 1, row + 1))
          - (light(column - 1, row - 1) + 2 * light(column, row - 1) + light(column + 1, row - 1))
      end
    end

    table.insert(levels, level)
  end

  return levels
end

local function finite(value: number): boolean
  return value == value and value > -math.huge and value < math.huge
end

--- Plans a painting of a reference: strokes coarse to fine, as the module describes.
function Module.plan(reference: magick.Image, options: Options?): Plan
  local radii = if options and options.radii then options.radii else { 8, 4, 2 }
  local threshold = if options and options.threshold then options.threshold else 0.1
  local curvature = if options and options.curvature then options.curvature else 0.4
  local shortest = if options and options.minimumLength then options.minimumLength else 2
  local longest = if options and options.maximumLength then options.maximumLength else 14
  local gridFactor = if options and options.grid then options.grid else 1
  local seed = if options and options.seed then options.seed else 1
  local budget = math.min(if options and options.budget then options.budget else Module.MaxStrokesPerPlan, Module.MaxStrokesPerPlan)

  noise.hash(seed, 0)

  for _, value in { threshold, curvature, gridFactor } do
    if not finite(value) or value < 0 then error('magick: painter options must be finite and not negative', 2) end
  end

  if curvature > 1 then error('magick: curvature must be in 0..1', 2) end
  if shortest < 1 or longest < shortest or longest > Module.MaxStrokeLength then error(`magick: stroke lengths must be in 1..{Module.MaxStrokeLength}`, 2) end

  for index = 2, #radii do
    if radii[index] > radii[index - 1] then error('magick: brush radii go from large to small', 2) end
  end

  local levels = Module.analyze(reference, radii)
  local width, height = reference.width, reference.height
  -- The estimate of the canvas so far: unpainted until a stroke covers it.
  local canvasRed, canvasGreen, canvasBlue = table.create(width * height, 0) :: { number }, table.create(width * height, 0) :: { number }, table.create(width * height, 0) :: { number }
  local painted = table.create(width * height, false) :: { boolean }
  local strokes: { Stroke } = {}
  local stats: { LevelStats } = {}

  local function stamp(stroke: Stroke)
    local radius = stroke.radius
    local points = stroke.points

    for index = 1, #points - 1, 2 do
      local centerX, centerY = points[index], points[index + 1]

      for row = math.max(0, math.floor(centerY - radius)), math.min(height - 1, math.ceil(centerY + radius)) do
        for column = math.max(0, math.floor(centerX - radius)), math.min(width - 1, math.ceil(centerX + radius)) do
          if (column + 0.5 - centerX) ^ 2 + (row + 0.5 - centerY) ^ 2 > radius * radius then continue end

          local at = row * width + column + 1

          canvasRed[at], canvasGreen[at], canvasBlue[at] = stroke.red, stroke.green, stroke.blue
          painted[at] = true
        end
      end
    end
  end

  for levelIndex, level in levels do
    local radius = level.radius
    local step = math.max(1, math.floor(radius * gridFactor + 0.5))
    local made: { Stroke } = {}

    local function difference(at: number): number
      if not painted[at] then return math.huge end

      return (math.abs(canvasRed[at] - level.red[at]) + math.abs(canvasGreen[at] - level.green[at]) + math.abs(canvasBlue[at] - level.blue[at])) / 3
    end

    local function sample(values: { number }, pointX: number, pointY: number): number
      return values[math.clamp(math.floor(pointY), 0, height - 1) * width + math.clamp(math.floor(pointX), 0, width - 1) + 1]
    end

    local function makeStroke(startX: number, startY: number): Stroke
      local red, green, blue = sample(level.red, startX, startY), sample(level.green, startX, startY), sample(level.blue, startX, startY)
      local points = { startX, startY }
      local pointX, pointY = startX, startY
      local lastX, lastY = 0, 0

      for count = 1, longest - 1 do
        local here = math.clamp(math.floor(pointY), 0, height - 1) * width + math.clamp(math.floor(pointX), 0, width - 1) + 1
        local towardColor = math.abs(level.red[here] - red) + math.abs(level.green[here] - green) + math.abs(level.blue[here] - blue)
        local towardCanvas = math.abs(level.red[here] - canvasRed[here]) + math.abs(level.green[here] - canvasGreen[here]) + math.abs(level.blue[here] - canvasBlue[here])

        if count > shortest and painted[here] and towardCanvas < towardColor then break end

        local gradientX, gradientY = level.gradientX[here], level.gradientY[here]
        local magnitude = math.sqrt(gradientX * gradientX + gradientY * gradientY)

        if magnitude < 1e-4 then break end

        -- Across the gradient, along the edge, the way the stroke was already going.
        local directionX, directionY = -gradientY / magnitude, gradientX / magnitude

        if lastX * directionX + lastY * directionY < 0 then directionX, directionY = -directionX, -directionY end

        if count > 1 then
          directionX, directionY = curvature * lastX + (1 - curvature) * directionX, curvature * lastY + (1 - curvature) * directionY

          local length = math.sqrt(directionX * directionX + directionY * directionY)

          if length < 1e-9 then break end

          directionX, directionY = directionX / length, directionY / length
        end

        pointX, pointY = pointX + radius * directionX, pointY + radius * directionY

        if pointX < 0 or pointY < 0 or pointX >= width or pointY >= height then break end

        lastX, lastY = directionX, directionY
        table.insert(points, pointX)
        table.insert(points, pointY)
      end

      return { points = points, radius = radius, red = red, green = green, blue = blue }
    end

    for top = 0, height - 1, step do
      for left = 0, width - 1, step do
        local total, worst, worstAt = 0, -1, 0
        local cells = 0

        for row = top, math.min(height - 1, top + step - 1) do
          for column = left, math.min(width - 1, left + step - 1) do
            local at = row * width + column + 1
            local miss = difference(at)

            total += math.min(miss, 1)
            cells += 1

            if miss > worst then worst, worstAt = miss, at end
          end
        end

        if total / cells > threshold then
          table.insert(made, makeStroke((worstAt - 1) % width + 0.5, (worstAt - 1) // width + 0.5))
        end
      end
    end

    -- Laid in a seeded order, so no part of the canvas is always painted last.
    for index = #made, 2, -1 do
      local other = noise.hash(seed, levelIndex, index) % index + 1

      made[index], made[other] = made[other], made[index]
    end

    local count = 0

    for _, stroke in made do
      if #strokes >= budget then break end

      table.insert(strokes, stroke)
      stamp(stroke)
      count += 1
    end

    local totalError = 0

    for at = 1, width * height do
      totalError += if painted[at] then difference(at) else 1
    end

    table.insert(stats, { radius = radius, strokes = count, error = totalError / (width * height) })
  end

  return { width = width, height = height, strokes = strokes, levels = stats }
end

--- The mean absolute difference of two images of one size, 0..1 over the color channels.
function Module.error(image: magick.Image, reference: magick.Image): number
  if image.width ~= reference.width or image.height ~= reference.height then error('magick: error compares images of one size', 2) end

  local total = 0

  for at = 0, image.width * image.height * 4 - 1 do
    if at % 4 ~= 3 then total += math.abs(buffer.readu8(image.data, at) - buffer.readu8(reference.data, at)) end
  end

  return total / (image.width * image.height * 3 * 255)
end

--- What `apply` takes: the brush preset for every stroke ('oil'), how much wider than the planned
--- radius the brush is (2.2), and a function of a stroke's radius giving more overrides (dabs spaced
--- 0.15 of their diameter when left out).
export type ApplyOptions = {
  preset: string?,
  widen: number?,
  overrides: ((radius: number) -> { [string]: unknown })?,
  seed: number?,
  matrix: transform.Matrix?,
  --- Lay the reference, blurred by the largest radius, under the strokes first, as a painter tones
  --- a canvas (true), so no bare canvas shows between the first strokes.
  underpaint: magick.Image?,
}

--- Adds a plan's strokes to a group as brush strokes, placed by `matrix` (reference pixels to the
--- group's space), each with its own seed.
function Module.apply(document: scene.Document, parent: scene.Node, plan: Plan, options: ApplyOptions?)
  local preset = if options and options.preset then options.preset else 'oil'
  local widen = if options and options.widen then options.widen else 2.2
  local seed = if options and options.seed then options.seed else 1
  local matrix = if options and options.matrix then options.matrix else transform.identity()
  local layer = parent:add(document:group { transform = matrix, name = 'painter' })
  local underpaint = if options then options.underpaint else nil

  if underpaint then
    local largest = if #plan.strokes > 0 then plan.strokes[1].radius else 4
    local toned = layer:add(document:group { name = 'underpainting', filters = { { kind = 'blur', radius = math.min(21, largest) } } })

    toned:add(document:image(underpaint, { sampling = 'bilinear' }))
  end

  for index, stroke in plan.strokes do
    local samples: { brush.Sample } = {}

    for at = 1, #stroke.points - 1, 2 do
      table.insert(samples, { stroke.points[at], stroke.points[at + 1], 1 })
    end

    local fill = string.format('#%02x%02x%02x', math.floor(stroke.red * 255 + 0.5), math.floor(stroke.green * 255 + 0.5), math.floor(stroke.blue * 255 + 0.5))
    local overrides = if options and options.overrides then options.overrides(stroke.radius) else { spacing = 0.15 }
    local settings = brush.preset(preset, stroke.radius * widen, fill, overrides)

    layer:add(document:stroke(samples, settings, { seed = (seed + index - 1) % 2147483646 + 1 }))
  end
end

return Module
