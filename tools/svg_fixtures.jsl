--!strict
-- Writes tests/svg/fixtures.jsl from the SVG fixtures in tests/svg and their reference renders, so
-- the package suite (which reads no files) can hold @magick/svg's import to an independent
-- renderer. The references are librsvg's, made once and committed, never at test time:
--
--   for f in tests/svg/*.svg; do magick -background none "rsvg:$f" -strip "PNG32:${f%.svg}.rsvg.png"; done
--   jess run --package . --capability filesystem.read --capability filesystem.write tools/svg_fixtures.jsl
--
-- (ImageMagick 7.1.2-35 with librsvg 2.63.2 made the committed ones.)
local bytes = require '@dream/bytes'
local fs = require '@dream/fs'

local Folder = 'tests/svg'

local names: { string } = {}

for _, entry in fs.list(Folder) or {} do
  local name = string.match(fs.fileName(entry) or '', '^(.+)%.svg$')

  if name then table.insert(names, name) end
end

table.sort(names)

local lines = {
  '--!strict',
  '-- Generated by tools/svg_fixtures.jsl from tests/svg: each SVG fixture and librsvg\'s render of it,',
  '-- base64. Do not edit by hand; regenerate it.',
  'return table.freeze {',
}

for _, name in names do
  local source = buffer.tostring(fs.readFile(`{Folder}/{name}.svg`) :: buffer)
  local reference = bytes.toBase64(fs.readFile(`{Folder}/{name}.rsvg.png`) :: buffer)

  if string.find(source, ']==]', 1, true) then error(`{name}.svg holds ]==], which ends the long string it is written in`) end

  table.insert(lines, `  table.freeze \{\n    name = '{name}',\n    svg = [==[{source}]==],\n    reference = '{reference}',\n  \},`)
end

table.insert(lines, '}')
fs.writeFile(`{Folder}/fixtures.jsl`, table.concat(lines, '\n') .. '\n', { atomic = true })
print(`svg fixtures: {#names} written to {Folder}/fixtures.jsl`)
