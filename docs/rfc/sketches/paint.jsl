--!strict
--[[
@magick/paint (0.2.0), SKETCH of RFC-0001 section 8. Declarations only: every constructor and
span function is a STUB. The types are the contract the 0.2.0 module must meet.

A paint is an immutable value. It has no mutation API, so one paint can be used by many shapes
and nodes. It is evaluated over a span of pixel centers in one row of a tile, at (x + 0.5, y + 0.5),
and writes premultiplied values into a scratch buffer. A user callback is not part of 0.2.0.
]]

local path = require '@magick/path'
local transform = require './transform'
local color = require './color'

local Paint = {}

export type Matrix = transform.Matrix
export type Working = color.Working
export type Space = color.Space

--- Spread past the first and last stop, shared by linear, radial and conic paints.
export type Spread = 'pad' | 'repeat' | 'reflect'

--- A stop: offset in 0..1, straight color as channels in 0..1, alpha included.
export type Stop = { offset: number, red: number, green: number, blue: number, alpha: number }

--- Sampling for image patterns.
export type Sampling = 'nearest' | 'bilinear'

--- What a pattern does past its source's edges.
export type Edge = 'clamp' | 'repeat' | 'mirror'

export type Solid = { kind: 'solid', red: number, green: number, blue: number, alpha: number }
export type Linear = { kind: 'linear', x0: number, y0: number, x1: number, y1: number, stops: { Stop }, spread: Spread, space: Space, transform: Matrix }
export type Radial = { kind: 'radial', cx: number, cy: number, radius: number, stops: { Stop }, spread: Spread, space: Space, transform: Matrix }
export type Conic = { kind: 'conic', cx: number, cy: number, startAngle: number, stops: { Stop }, spread: Spread, space: Space, transform: Matrix }
export type Pattern = { kind: 'pattern', source: { width: number, height: number, data: buffer }, edge: Edge, sampling: Sampling, transform: Matrix }

--- Every paint. `opacity` in 0..1 multiplies the paint's alpha on evaluation.
export type Paint = (Solid | Linear | Radial | Conic | Pattern) & { opacity: number }

--- Options every fill takes. Fill rule is explicit: legacy Path:mask() stays nonzero-as-clamped.
export type FillOptions = {
  fillRule: 'nonzero' | 'evenodd'?,
  blend: 'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten' | 'soft-light'?,
  clip: { left: number, top: number, right: number, bottom: number }?,
}

--- Stub: a solid paint from channels in 0..1 (or a color string resolved by the caller).
function Paint.solid(red: number, green: number, blue: number, alpha: number?): Paint
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: a linear gradient through two points in paint space, after its transform.
function Paint.linear(x0: number, y0: number, x1: number, y1: number, stops: { Stop }, options: { spread: Spread?, space: Space?, transform: Matrix? }?): Paint
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: a radial gradient. radius 0 gives the last stop's color (RFC section 10).
function Paint.radial(cx: number, cy: number, radius: number, stops: { Stop }, options: { spread: Spread?, space: Space?, transform: Matrix? }?): Paint
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: a conic gradient. Seam at the paint's +x axis; angles grow clockwise on screen.
function Paint.conic(cx: number, cy: number, startAngle: number, stops: { Stop }, options: { spread: Spread?, space: Space?, transform: Matrix? }?): Paint
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: an image as a repeated, transformed fill. Reading the destination is rejected.
function Paint.pattern(source: { width: number, height: number, data: buffer }, options: { edge: Edge?, sampling: Sampling?, transform: Matrix? }?): Paint
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: the coverage of a path inside a rectangle, filled with a paint into a working tile. The
--- rectangle is the tile (or clip) and bounds the scratch buffer; it is not a full-shape buffer.
function Paint.fillPath(target: Working, geometry: path.Path, paint: Paint, options: FillOptions): Working
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: evaluate one span of pixel centers of one row into `out` (premultiplied f32, 4 per pixel).
function Paint.span(paint: Paint, row: number, firstColumn: number, count: number, out: buffer): ()
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

return Paint
