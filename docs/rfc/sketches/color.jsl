--!strict
--[[
@magick/color (0.2.0), SKETCH of RFC-0001 sections 8 and 10.

Everything with a body here is a REFERENCE for the arithmetic the RFC fixes: byte rounding,
premultiplication through an f32 store, straight conversion with the transparent-RGB policy, the
Porter-Duff factors, the W3C separable blend functions, and one-pixel compositing with opacity.
The tests in tests/rfc.jsl run it. Everything that touches an image or a tile is a STUB.

Working tiles are premultiplied, RGBA, f32 per channel (16 bytes a pixel), rows from the top.
Space is 'srgb' (encoded values, the default) or 'linear' (sRGB transfer removed before
compositing, encoded again on output).
]]

local Color = {}

export type Space = 'srgb' | 'linear'

--- A premultiplied working tile. `data` holds width * height * 4 f32 values.
export type Working = { width: number, height: number, space: Space, data: buffer }

export type Operator =
  'clear' | 'src' | 'dst' | 'src-over' | 'dst-over' | 'src-in' | 'dst-in'
  | 'src-out' | 'dst-out' | 'src-atop' | 'dst-atop' | 'xor'

--- The separable blend modes 0.2.0 ships. Every other name is rejected with
--- `magick: unknown blend mode <name>`; nonseparable modes are not in 0.2.0.
export type BlendMode = 'normal' | 'multiply' | 'screen' | 'overlay' | 'darken' | 'lighten' | 'soft-light'

--- One pixel, premultiplied, channels and alpha in 0..1. Its straight color is channel / alpha.
export type Pixel = { red: number, green: number, blue: number, alpha: number }

--- A straight byte: clamped to 0..255, rounded half up. RFC-0001 W4.
function Color.byte(value: number): number
  return math.floor(math.clamp(value, 0, 255) + 0.5)
end

--- A channel in 0..1 as the byte a straight RGBA8 image stores. Alpha uses the same rule.
function Color.unitByte(value: number): number
  return math.floor(math.clamp(value, 0, 1) * 255 + 0.5)
end

--- Premultiplies one straight byte channel by its byte alpha. The product is stored through an
--- f32 buffer, as a working tile stores it, and read back, so the reference matches the tile.
--- Returns the stored premultiplied channel and the stored alpha.
function Color.premultiply(channel: number, alpha: number, scratch: buffer): (number, number)
  buffer.writef32(scratch, 0, (channel / 255) * (alpha / 255))
  buffer.writef32(scratch, 4, alpha / 255)

  return buffer.readf32(scratch, 0), buffer.readf32(scratch, 4)
end

--- Straight output of one stored pixel. Clamps premultiplied channels to 0..alpha first. A
--- pixel whose alpha byte is 0 stores RGB 0: the transparent-RGB policy.
function Color.straight(premultipliedRed: number, premultipliedGreen: number, premultipliedBlue: number, alpha: number): (number, number, number, number)
  local alphaByte = Color.unitByte(alpha)

  if alphaByte == 0 then return 0, 0, 0, 0 end

  local clampedAlpha = math.clamp(alpha, 0, 1)

  local function channel(value: number): number
    return Color.unitByte(math.clamp(value, 0, clampedAlpha) / clampedAlpha)
  end

  return channel(premultipliedRed), channel(premultipliedGreen), channel(premultipliedBlue), alphaByte
end

--- W3C Porter-Duff factors (Compositing and Blending Level 1, section 5.1): the source and
--- backdrop multipliers for premultiplied colors. Result color is cs * fa + cb * fb, result
--- alpha is as * fa + ab * fb.
function Color.factors(operator: Operator, sourceAlpha: number, backdropAlpha: number): (number, number)
  if operator == 'clear' then return 0, 0 end
  if operator == 'src' then return 1, 0 end
  if operator == 'dst' then return 0, 1 end
  if operator == 'src-over' then return 1, 1 - sourceAlpha end
  if operator == 'dst-over' then return 1 - backdropAlpha, 1 end
  if operator == 'src-in' then return backdropAlpha, 0 end
  if operator == 'dst-in' then return 0, sourceAlpha end
  if operator == 'src-out' then return 1 - backdropAlpha, 0 end
  if operator == 'dst-out' then return 0, 1 - sourceAlpha end
  if operator == 'src-atop' then return backdropAlpha, 1 - sourceAlpha end
  if operator == 'dst-atop' then return 1 - backdropAlpha, sourceAlpha end

  return 1 - backdropAlpha, 1 - sourceAlpha
end

--- W3C B(cb, cs) for multiply: cb * cs. Arguments are straight channels in 0..1.
local function multiplyChannel(backdrop: number, source: number): number
  return backdrop * source
end

local function screenChannel(backdrop: number, source: number): number
  return backdrop + source - backdrop * source
end

--- HardLight(cb, cs): multiply with twice the source below one half, screen above it.
local function hardLightChannel(backdrop: number, source: number): number
  if source <= 0.5 then return multiplyChannel(backdrop, 2 * source) end

  return screenChannel(backdrop, 2 * source - 1)
end

--- SoftLight(cb, cs), with D(x) = ((16x - 12)x + 4)x for x <= 1/4 and sqrt(x) above it.
local function softLightChannel(backdrop: number, source: number): number
  if source <= 0.5 then return backdrop - (1 - 2 * source) * backdrop * (1 - backdrop) end

  local lifted = if backdrop <= 0.25 then ((16 * backdrop - 12) * backdrop + 4) * backdrop else math.sqrt(backdrop)

  return backdrop + (2 * source - 1) * (lifted - backdrop)
end

--- The separable blend function B(cb, cs) of W3C section 10: `backdrop` is cb, `source` is cs,
--- both straight, in 0..1. Overlay is HardLight with the arguments swapped.
function Color.separable(mode: BlendMode, backdrop: number, source: number): number
  if mode == 'normal' then return source end
  if mode == 'multiply' then return multiplyChannel(backdrop, source) end
  if mode == 'screen' then return screenChannel(backdrop, source) end
  if mode == 'overlay' then return hardLightChannel(source, backdrop) end
  if mode == 'darken' then return math.min(backdrop, source) end
  if mode == 'lighten' then return math.max(backdrop, source) end

  return softLightChannel(backdrop, source)
end

--- A straight channel from a premultiplied one. A zero alpha has no straight color; the B term it
--- feeds is multiplied by the overlap alpha, which is zero then, so 0 is returned.
local function straightChannel(premultiplied: number, alpha: number): number
  if alpha == 0 then return 0 end

  return premultiplied / alpha
end

--- One pixel of compositing with an operator, a blend mode and an opacity, on premultiplied pixels
--- (RFC-0001 section 10). The source's alpha and color are scaled by the opacity first, once.
--- With the normal blend mode, any operator applies: result = cs' * fa + cb * fb and
--- alpha = as' * fa + ab * fb, with fa and fb from Color.factors. Any other blend mode composites
--- with src-over only: per channel, result = cs' * (1 - ab) + cb * (1 - as') + as' * ab * B(cb/ab, cs/as),
--- and alpha = as' + ab - as' * ab. Results are premultiplied and not clamped; the inputs are in range.
function Color.blendPixel(mode: BlendMode, operator: Operator, source: Pixel, backdrop: Pixel, opacity: number): Pixel
  if mode ~= 'normal' and operator ~= 'src-over' then error('magick: blend modes composite with src-over only', 2) end

  local sourceAlpha = source.alpha * opacity
  local sourceFactor, backdropFactor = Color.factors(operator, sourceAlpha, backdrop.alpha)
  local overlap = sourceAlpha * backdrop.alpha

  local function channel(sourcePremultiplied: number, backdropPremultiplied: number, sourceStraight: number, backdropStraight: number): number
    if mode == 'normal' then return sourcePremultiplied * opacity * sourceFactor + backdropPremultiplied * backdropFactor end

    local blended = if overlap > 0 then overlap * Color.separable(mode, backdropStraight, sourceStraight) else 0

    return sourcePremultiplied * opacity * (1 - backdrop.alpha) + backdropPremultiplied * (1 - sourceAlpha) + blended
  end

  local alpha = if mode == 'normal' then sourceAlpha * sourceFactor + backdrop.alpha * backdropFactor else sourceAlpha + backdrop.alpha - overlap

  return {
    red = channel(source.red, backdrop.red, straightChannel(source.red, source.alpha), straightChannel(backdrop.red, backdrop.alpha)),
    green = channel(source.green, backdrop.green, straightChannel(source.green, source.alpha), straightChannel(backdrop.green, backdrop.alpha)),
    blue = channel(source.blue, backdrop.blue, straightChannel(source.blue, source.alpha), straightChannel(backdrop.blue, backdrop.alpha)),
    alpha = alpha,
  }
end

--- Stub: the working tile a straight RGBA8 image becomes (premultiplied, space as given).
--- The image's pixels with alpha 0 lose their RGB; the legacy image keeps it.
function Color.fromImage(image: { width: number, height: number, data: buffer }, space: Space): Working
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: straight RGBA8 output of a working tile, the only way a tile leaves the module.
function Color.toImage(working: Working): { width: number, height: number, data: buffer }
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

--- Stub: composites an isolated group tile onto a destination tile (RFC-0001 section 10). Order:
--- the group's children were drawn into `group` in painter order, starting from transparent; the
--- group's opacity is applied once to each pixel, then its blend and operator (blendPixel above).
function Color.compositeGroup(
  destination: Working,
  group: Working,
  options: { blend: BlendMode?, operator: Operator?, opacity: number? }?
): Working
  error('magick: sketch stub, not implemented in 0.2.0 sketch', 2)
end

return Color
