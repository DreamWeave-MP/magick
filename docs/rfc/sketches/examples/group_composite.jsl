--!strict
-- RFC-0001 section 10 (G1 to G4): an isolated group, its children in painter order, then its opacity
-- once, then its blend and operator onto the backdrop. Numbers are premultiplied 0..1 pixels.
-- Run: jess run --package . docs/rfc/sketches/examples/group_composite.jsl
local color = require '../color'

local white = { red = 1, green = 1, blue = 1, alpha = 1 }

-- The group starts transparent. Child 1: opaque red. Child 2: blue at alpha 0.5, painted over it.
local groupStart = { red = 0, green = 0, blue = 0, alpha = 0 }
local childRed = { red = 1, green = 0, blue = 0, alpha = 1 }
local childBlue = { red = 0, green = 0, blue = 0.5, alpha = 0.5 }

local afterRed = color.blendPixel('normal', 'src-over', childRed, groupStart, 1)
local groupPixel = color.blendPixel('normal', 'src-over', childBlue, afterRed, 1)
assert(groupPixel.red == 0.5 and groupPixel.green == 0 and groupPixel.blue == 0.5 and groupPixel.alpha == 1,
  'children composite in painter order inside the group')

-- Group opacity 0.5, once, then src-over onto white.
local onWhite = color.blendPixel('normal', 'src-over', groupPixel, white, 0.5)
assert(onWhite.red == 0.75 and onWhite.green == 0.5 and onWhite.blue == 0.75 and onWhite.alpha == 1,
  'group opacity applied once, then composited')

local red, green, blue = color.straight(onWhite.red, onWhite.green, onWhite.blue, onWhite.alpha)
assert(red == 191 and green == 128 and blue == 191 and onWhite.alpha == 1, 'bytes 191 128 191 255')
print('group on white, straight bytes', red, green, blue, 255)

-- A multiply group composited with its blend, opacity 1: red on white stays red.
local multiplied = color.blendPixel('multiply', 'src-over', childRed, white, 1)
assert(multiplied.red == 1 and multiplied.green == 0 and multiplied.blue == 0 and multiplied.alpha == 1,
  'multiply of red over white is red')
print('multiply group on white', multiplied.red, multiplied.green, multiplied.blue)
